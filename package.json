{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prebuild-version.js --dev && vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/prebuild-version.js && vite build",
    "build:desktop": "cross-env VITE_BUILD_TARGET=desktop node scripts/prebuild-version.js && cross-env VITE_BUILD_TARGET=desktop vite build",
    "build:mobile": "cross-env VITE_BUILD_TARGET=mobile node scripts/prebuild-version.js && cross-env VITE_BUILD_TARGET=mobile vite build",
    "build:apk": "node scripts/build-apk.js",
    "preview": "npm run build && wrangler pages dev ./dist",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "deploy": "npm run build && wrangler pages deploy ./dist",
    "db:backup": "node scripts/backup-db.cjs",
    "predb:bootstrap": "node scripts/backup-db.cjs",
    "db:bootstrap": "node scripts/bootstrap-db.js",
    "predb:migrate": "node scripts/backup-db.cjs",
    "db:migrate": "node scripts/migrate-all-schemas.js",
    "db:restore": "node scripts/restore-from-backup.cjs",
    "hooks:install": "node scripts/install-hooks.cjs"
  },
  "dependencies": {
    "@capacitor-community/contacts": "^7.2.0",
    "@capacitor/android": "^8.4.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/camera": "^8.2.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/ios": "^8.4.0",
    "@capacitor/push-notifications": "^8.1.1",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-printer": "^8.0.17",
    "@google/genai": "^2.4.0",
    "@solidjs/router": "^0.15.3",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/solid-query": "^5.101.4",
    "appwrite": "^24.1.1",
    "dexie": "^4.4.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-solid": "^0.475.0",
    "solid-js": "^1.9.4",
    "vite": "^6.2.3",
    "vite-plugin-solid": "^2.11.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.2",
    "@playwright/test": "^1.60.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.9.0",
    "jsdom": "^27.0.1",
    "node-appwrite": "^26.1.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.97.0"
  }
}
