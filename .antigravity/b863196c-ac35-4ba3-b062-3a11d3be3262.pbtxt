        target_content: "export interface TripEntry {\n  id: string;\n  tripNo: string; // Dynamic / Autogenerated / Groupable\n  truckNo: string; // References Truck.truckNo\n  officeName: string; // References Office.officeName\n  rental: number;\n  loadingDate: string; // YYYY-MM-DD\n  commission: number;\n  loadingUnloading: number; // Charges\n  officeMamul: number; // Native field (office allowance/bribe/tip)\n  \n  // Advance 1\n  advance1: number;\n  advance1Date: string;\n  advance1ReceivedBy: string; // References Account.id\n  \n  // Advance 2\n  advance2: number;\n  advance2Date: string;\n  advance2ReceivedBy: string; // References Account.id\n  \n  // Advance 3\n  advance3: number;\n  advance3Date: string;\n  advance3ReceivedBy: string; // References Account.id\n  \n  // Balance details\n  balance: number; // Calculated dynamic balance\n  balance1Date: string; // Date of settlement\n  balance1ReceivedBy: string; // References Account.id\n\n  status: TripStatus;\n  notes?: string;\n}\n\n// Utility to calculate balance\nexport function calculateBalance(entry: {\n  rental: number;\n  commission: number;\n  loadingUnloading: number;\n  officeMamul: number;\n  advance1: number;\n  advance2: number;\n  advance3: number;\n}): number {\n  const rental = Number(entry.rental) || 0;\n  const commission = Number(entry.commission) || 0;\n  const loadingUnloading = Number(entry.loadingUnloading) || 0;\n  const officeMamul = Number(entry.officeMamul) || 0;\n  const adv1 = Number(entry.advance1) || 0;\n  const adv2 = Number(entry.advance2) || 0;\n  const adv3 = Number(entry.advance3) || 0;\n  \n  // Under standard truck brokerage operations: \n  // Balance = Rental - Commission - LoadingUnloading - OfficeMamul - (adv1 + adv2 + adv3)\n  return rental - commission - loadingUnloading - officeMamul - adv1 - adv2 - adv3;\n}"
        replacement_content: "export interface TripPayment {\n  id: string;\n  amount: number;\n  date: string;       // YYYY-MM-DD\n  receivedBy: string; // References Account.id\n  notes?: string;     // Short segment/remarks, e.g. \"Fuel Advance\", \"Final\"\n}\n\nexport interface TripEntry {\n  id: string;\n  tripNo: string; // Dynamic / Autogenerated / Groupable\n  truckNo: string; // References Truck.truckNo\n  officeName: string; // References Office.officeName\n  rental: number;\n  loadingDate: string; // YYYY-MM-DD\n  commission: number;\n  loadingUnloading: number; // Charges\n  officeMamul: number; // Native field (office allowance/bribe/tip)\n  \n  payments: TripPayment[]; // Dynamic N payments list\n\n  balance: number; // Calculated dynamic balance\n  status: TripStatus;\n  notes?: string;\n}\n\n// Utility to calculate balance\nexport function calculateBalance(entry: {\n  rental: number;\n  commission: number;\n  loadingUnloading: number;\n  officeMamul: number;\n  payments: TripPayment[];\n}): number {\n  const rental = Number(entry.rental) || 0;\n  const commission = Number(entry.commission) || 0;\n  const loadingUnloading = Number(entry.loadingUnloading) || 0;\n  const officeMamul = Number(entry.officeMamul) || 0;\n  \n  const paymentsTotal = (entry.payments || []).reduce((sum, p) => sum + (Number(p.amount) || 0), 0);\n  \n  // Balance = Rental - Commission - LoadingUnloading - OfficeMamul - sum(payments)\n  return rental - commission - loadingUnloading - officeMamul - paymentsTotal;\n}"
      }
      num_matches: 1
    }
  }
}
