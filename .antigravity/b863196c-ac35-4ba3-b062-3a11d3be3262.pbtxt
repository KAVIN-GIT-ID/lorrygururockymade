        replacement_content: "              {/* DRIVER NAME */}\n              <div>\n                <label className=\"block text-[11px] font-extrabold text-slate-650 uppercase tracking-wider mb-1.5 font-sans font-sans\">Driver Operator <span className=\"text-red-500\">*</span></label>\n                <select\n                  id=\"select-driverName\"\n                  value={driverName}\n                  onChange={(e) => setDriverName(e.target.value)}\n                  required\n                  className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 font-semibold rounded-lg px-2 py-1.5 text-xs focus:outline-none focus:border-blue-500 focus:bg-white font-sans\"\n                >\n                  <option value=\"\">-- Choose Driver --</option>\n                  {drivers.map(d => (\n                    <option key={d.id} value={d.driverName}>{d.driverName} {d.phone ? `(${d.phone})` : \'\'}</option>\n                  ))}\n                  {driverName && !drivers.some(d => d.driverName === driverName) && (\n                    <option value={driverName}>{driverName} (Manual Override)</option>\n                  )}\n                </select>\n              </div>"
