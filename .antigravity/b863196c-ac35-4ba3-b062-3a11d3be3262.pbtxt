    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { TripEntry, Truck, Office, Account, TripStatus, getTripMetrics, calculateBalance } from \'../types\';\nimport { \n  Search, Edit2, Trash2, Calendar, Filter, FileSpreadsheet, \n  Eye, ChevronRight, ChevronDown, X, AlertCircle, Fuel, \n  Gauge, TrendingUp, DollarSign, User, MapPin, ListCollapse, ArrowRightLeft\n} from \'lucide-react\';\n\ninterface TripListProps {\n  trips: TripEntry[];\n  trucks: Truck[];\n  offices: Office[];\n  accounts: Account[];\n  onEditEntry: (entry: TripEntry) => void;\n  onDeleteEntry: (id: string) => void;\n}\n\nexport default function TripList({\n  trips,\n  trucks,\n  offices,\n  accounts,\n  onEditEntry,\n  onDeleteEntry\n}: TripListProps) {\n  // Filters state\n  const [search, setSearch] = useState(\'\');\n  const [selectedTruck, setSelectedTruck] = useState(\'\');\n  const [selectedStatus, setSelectedStatus] = useState<string>(\'\');\n  const [startDate, setStartDate] = useState(\'\');\n  const [endDate, setEndDate] = useState(\'\');\n  \n  // Selection/Expansion state\n  const [expandedTripId, setExpandedTripId] = useState<string | null>(null);\n  \n  // Master Details modal state for viewing full list of 21+ columns cleanly\n  const [viewingEntry, setViewingEntry] = useState<TripEntry | null>(null);\n\n  // Filter and search logic\n  const filteredTrips = trips.filter(trip => {\n    const metrics = getTripMetrics(trip);\n    const matchesSearch = !search ? true : (\n      trip.tripNo.toLowerCase().includes(search.toLowerCase()) ||\n      trip.truckNo.toLowerCase().includes(search.toLowerCase()) ||\n      trip.driverName.toLowerCase().includes(search.toLowerCase()) ||\n      (trip.notes && trip.notes.toLowerCase().includes(search.toLowerCase()))\n    );\n\n    const matchesTruck = !selectedTruck ? true : trip.truckNo === selectedTruck;\n    const matchesStatus = !selectedStatus ? true : trip.status === selectedStatus;\n\n    const matchesStartDate = !startDate ? true : trip.startDate >= startDate;\n    const matchesEndDate = !endDate ? true : trip.endDate <= endDate;\n\n    return matchesSearch && matchesTruck && matchesStatus && matchesStartDate && matchesEndDate;\n  });\n\n  // Calculate totals of filtered items for footer reporting\n  const totals = filteredTrips.reduce((acc, t) => {\n    const m = getTripMetrics(t);\n    return {\n      income: acc.income + m.income,\n      expense: acc.expense + m.totalExpense,\n      profit: acc.profit + m.profit,\n      payments: acc.payments + m.paymentsReceived,\n      outstanding: acc.outstanding + m.outstandingBalance,\n      fuelLiters: acc.fuelLiters + m.fuelLiters,\n      km: acc.km + m.totalKM\n    };\n  }, {\n    income: 0,\n    expense: 0,\n    profit: 0,\n    payments: 0,\n    outstanding: 0,\n    fuelLiters: 0,\n    km: 0\n  });\n\n  // CSV Exporter reflecting the new flat 23-column schema\n  const handleExportCSV = () => {\n    if (filteredTrips.length === 0) return;\n    const headers = [\n      \"Trip No\", \"Truck No\", \"Trip Start Date\", \"Trip End Date\", \"Driver Name\", \n      \"Income (\342\202\271)\", \"Loading Expense (\342\202\271)\", \"Unloading Expense (\342\202\271)\", \"RTO Expense (\342\202\271)\", \n      \"Diesel Expense (\342\202\271)\", \"Add Blue Expense (\342\202\271)\", \"Fastag Expense (\342\202\271)\", \"Driver Wages (\342\202\271)\", \n      \"Other Expense (\342\202\271)\", \"Fuel Liters\", \"Starting KM\", \"Ending KM\", \"Total KM\", \n      \"Mileage (KM/L)\", \"Per KM Expense (\342\202\271)\", \"No of Days\", \"Total Expense (\342\202\271)\", \"Profit (\342\202\271)\", \n      \"Payments Received (\342\202\271)\", \"Outstanding Balance (\342\202\271)\", \"Status\"\n    ];\n\n    const rows = filteredTrips.map(t => {\n      const m = getTripMetrics(t);\n      return [\n        t.tripNo,\n        t.truckNo,\n        t.startDate,\n        t.endDate,\n        t.driverName,\n        m.income,\n        m.loadingExpense,\n        m.unloadingExpense,\n        m.rtoExpense,\n        m.dieselExpense,\n        m.addBlueExpense,\n        m.fastagExpense,\n        m.driverWages,\n        m.otherExpense,\n        m.fuelLiters,\n        t.startingKM,\n        t.endingKM,\n        m.totalKM,\n        m.millage.toFixed(2),\n        m.perKM.toFixed(2),\n        m.noOfDays,\n        m.totalExpense,\n        m.profit,\n        m.paymentsReceived,\n        m.outstandingBalance,\n        t.status\n      ];\n    });\n\n    const csvContent = [\n      headers.join(\",\"),\n      ...rows.map(r => r.map(val => {\n        const escaped = (\'\' + val).replace(/\"/g, \'\"\"\');\n        return escaped.includes(\',\') || escaped.includes(\'\\n\') || escaped.includes(\'\"\') ? `\"${escaped}\"` : escaped;\n      }).join(\",\"))\n    ].join(\"\\n\");\n\n    const blob = new Blob([csvContent], { type: \'text/csv;charset=utf-8;\' });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\"a\");\n    link.href = url;\n    link.setAttribute(\"download\", `fleet_trip_reports_${new Date().toISOString().slice(0, 10)}.csv`);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n  };\n\n  const getAccountName = (id: string) => {\n    return accounts.find(a => a.id === id)?.accountName || id || \'Unmapped\';\n  };\n\n  // Date styling helper\n  const dateFormatted = (dateStr: string) => {\n    if (!dateStr) return <span className=\"text-slate-400 font-mono\">&mdash;</span>;\n    try {\n      const d = new Date(dateStr);\n      if (isNaN(d.getTime())) return <span className=\"text-slate-400 font-mono\">{dateStr}</span>;\n      return <span className=\"font-mono text-xs\">{d.toLocaleDateString(\'en-IN\', { day: \'2-digit\', month: \'short\', year: \'numeric\' })}</span>;\n    } catch {\n      return <span className=\"text-slate-400 font-mono\">{dateStr}</span>;\n    }\n  };\n\n  const currencyFormatted = (num: number, showSign = true) => {\n    const val = Number(num) || 0;\n    return <span className=\"font-mono font-bold text-slate-800\">{showSign ? \'\342\202\271\' : \'\'}{val.toLocaleString(\'en-IN\')}</span>;\n  };\n\n  const getStatusBadge = (status: TripStatus) => {\n    switch (status) {\n      case \'Pending\':\n        return <span className=\"px-2.5 py-1 text-xs font-semibold rounded-full border border-slate-200 bg-slate-50 text-slate-600\">Pending</span>;\n      case \'In Progress\':\n        return <span className=\"px-2.5 py-1 text-xs font-semibold rounded-full border border-amber-200 bg-amber-50 text-amber-700\">In Progress</span>;\n      case \'Completed\':\n        return <span className=\"px-2.5 py-1 text-xs font-semibold rounded-full border border-blue-200 bg-blue-50 text-blue-700\">Completed</span>;\n      case \'Paid\':\n        return <span className=\"px-2.5 py-1 text-xs font-semibold rounded-full border border-emerald-200 bg-emerald-50 text-emerald-700\">Settled</span>;\n      default:\n        return null;\n    }\n  };\n\n  const handleResetFilters = () => {\n    setSearch(\'\');\n    setSelectedTruck(\'\');\n    setSelectedStatus(\'\');\n    setStartDate(\'\');\n    setEndDate(\'\');\n  };\n\n  return (\n    <div className=\"space-y-6 animate-fade-in font-sans\">\n      \n      {/* FILTER CONTROL PANEL */}\n      <div id=\"trip-filter-hud\" className=\"bg-white border border-slate-200 rounded-xl p-5 md:p-6 shadow-xs space-y-4\">\n        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n          <div>\n            <h2 className=\"text-lg font-bold text-slate-800 leading-tight font-sans\">Active Transport Journals</h2>\n            <p className=\"text-xs text-slate-500 mt-0.5\">Fleet performance auditing. Select custom master records to inspect sub-trip segments & expenditures.</p>\n          </div>\n          \n          <button\n            id=\"export-csv-btn\"\n            disabled={filteredTrips.length === 0}\n            onClick={handleExportCSV}\n            className=\"flex items-center gap-1.5 bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-905 disabled:opacity-45 disabled:hover:bg-transparent font-bold px-4 py-2.5 rounded-lg border border-slate-200 transition text-xs shadow-2xs cursor-pointer text-slate-905\"\n          >\n            <FileSpreadsheet className=\"w-3.5 h-3.5 text-slate-500\" /> Export Cumulative CSV (23 Columns)\n          </button>\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3 pt-4 border-t border-slate-100\">\n          {/* SEARCH FIELD */}\n          <div className=\"relative\">\n            <Search className=\"absolute left-2.5 top-3 w-3.5 h-3.5 text-slate-400\" />\n            <input\n              id=\"search-input\"\n              type=\"text\"\n              placeholder=\"Search Trips, Trucks, Drivers...\"\n              value={search}\n              onChange={(e) => setSearch(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-200 text-slate-850 rounded-lg pl-8 pr-2 py-2 text-xs focus:outline-none focus:border-blue-500 focus:bg-white placeholder:text-slate-400 font-medium\"\n            />\n          </div>\n\n          {/* TRUCK SELECT FILTER */}\n          <div>\n            <select\n              id=\"filter-truck-select\"\n              value={selectedTruck}\n              onChange={(e) => setSelectedTruck(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-200 text-slate-700 rounded-lg px-2.5 py-2 text-xs font-mono focus:outline-none focus:border-blue-500 focus:bg-white font-semibold\"\n            >\n              <option value=\"\">&mdash; Choose Truck &mdash;</option>\n              {trucks.map(t => (\n                <option key={t.id} value={t.truckNo}>{t.truckNo}</option>\n              ))}\n            </select>\n          </div>\n\n          {/* STATUS SELECT FILTER */}\n          <div>\n            <select\n              id=\"filter-status-select\"\n              value={selectedStatus}\n              onChange={(e) => setSelectedStatus(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-200 text-slate-700 rounded-lg px-2.5 py-2 text-xs focus:outline-none focus:border-blue-500 focus:bg-white font-semibold\"\n            >\n              <option value=\"\">&mdash; Choose Status &mdash;</option>\n              <option value=\"Pending\">Pending (Not Initiated)</option>\n              <option value=\"In Progress\">In Progress (Active)</option>\n              <option value=\"Completed\">Completed (No Debt)</option>\n              <option value=\"Paid\">Settled (Fully Zero Out)</option>\n            </select>\n          </div>\n\n          {/* STARTING DATE */}\n          <div>\n            <input\n              id=\"filter-start-date\"\n              type=\"date\"\n              title=\"Trip start date after\"\n              value={startDate}\n              onChange={(e) => setStartDate(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-200 text-slate-650 rounded-lg px-2.5 py-1.5 text-xs focus:outline-none focus:border-blue-500 focus:bg-white font-medium\"\n            />\n          </div>\n\n          {/* ENDING DATE */}\n          <div>\n            <input\n              id=\"filter-end-date\"\n              type=\"date\"\n              title=\"Trip end date before\"\n              value={endDate}\n              onChange={(e) => setEndDate(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-200 text-slate-650 rounded-lg px-2.5 py-1.5 text-xs focus:outline-none focus:border-blue-500 focus:bg-white font-medium\"\n            />\n          </div>\n        </div>\n\n        {/* ACTIVE FILTER DISMISS BLOCKS */}\n        {(selectedTruck || selectedStatus || startDate || endDate || search) && (\n          <div className=\"flex justify-between items-center bg-slate-50 border border-slate-100 rounded-lg p-3 px-4 shadow-3xs\">\n            <span className=\"text-xs text-slate-600 flex items-center gap-1.5 font-medium\">\n              <Filter className=\"w-3.5 h-3.5 text-blue-500\" />\n              Matched <strong>{filteredTrips.length}</strong> of <strong>{trips.length}</strong> master transport records.\n            </span>\n            <button\n              id=\"reset-filters\"\n              onClick={handleResetFilters}\n              className=\"text-xs font-bold text-rose-600 hover:text-rose-700 hover:underline cursor-pointer\"\n            >\n              Reset Filters\n            </button>\n          </div>\n        )}\n      </div>\n\n      {/* CORE MASTER LIST TABLE CONTAINER */}\n      <div className=\"bg-white border border-slate-200 rounded-xl shadow-xs overflow-hidden\">\n        <div className=\"overflow-x-auto\">\n          <table id=\"master-trips-table\" className=\"w-full text-left text-sm text-slate-700 whitespace-nowrap min-w-[1000px]\">\n            <thead className=\"text-[11px] text-slate-500 uppercase bg-slate-50 border-b border-slate-200 font-bold tracking-wider\">\n              <tr>\n                <th className=\"px-6 py-4 w-12 text-center\">Audit</th>\n                <th className=\"px-4 py-4 pl-2\">Trip ID (Group Code)</th>\n                <th className=\"px-4 py-4\">Truck & Driver</th>\n                <th className=\"px-4 py-4 text-center\">Trip duration dates</th>\n                <th className=\"px-4 py-4 bg-slate-100/25 text-center\">Sub-trips</th>\n                <th className=\"px-4 py-4 text-right\">Income Generated</th>\n                <th className=\"px-4 py-4 text-right\">Operational Costs</th>\n                <th className=\"px-4 py-4 text-right\">Net Profit Margin</th>\n                <th className=\"px-4 py-4 text-center\">Status</th>\n                <th className=\"px-6 py-4 text-right\">Actions</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-100 font-sans\">\n              {filteredTrips.length === 0 ? (\n                <tr>\n                  <td colSpan={10} className=\"text-center py-16 text-slate-400 font-medium italic\">\n                    No active transport references matched your operational filters.\n                  </td>\n                </tr>\n              ) : (\n                filteredTrips.map((trip) => {\n                  const m = getTripMetrics(trip);\n                  const isExpanded = expandedTripId === trip.id;\n\n                  return (\n                    <React.Fragment key={trip.id}>\n                      {/* MAIN MASTERS ROW */}\n                      <tr \n                        id={`trip-row-${trip.id}`} \n                        className={`hover:bg-slate-50/50 transition duration-150 cursor-pointer ${isExpanded ? \'bg-blue-50/15\' : \'\'}`}\n                        onClick={() => setExpandedTripId(isExpanded ? null : trip.id)}\n                      >\n                        {/* EXPANSION CONTROL ACCORDION TOGGLE */}\n                        <td className=\"px-6 py-4 text-center\">\n                          <div className=\"flex items-center justify-center\">\n                            {isExpanded ? (\n                              <ChevronDown className=\"w-4 h-4 text-blue-600 transition duration-200\" />\n                            ) : (\n                              <ChevronRight className=\"w-4 h-4 text-slate-400 hover:text-slate-600 transition duration-200\" />\n                            )}\n                          </div>\n                        </td>\n                        \n                        {/* TRIP ID */}\n                        <td className=\"px-4 py-4 pl-2\">\n                          <span className=\"font-mono font-extrabold text-blue-605 text-xs block text-blue-600\">{trip.tripNo}</span>\n                          <span className=\"text-[10px] text-slate-405 italic block mt-0.5\">Segs: {trip.subTrips?.length || 0}</span>\n                        </td>\n\n                        {/* TRUCK & OPERATOR */}\n                        <td className=\"px-4 py-4\">\n                          <span className=\"font-mono font-bold text-slate-900 tracking-wider text-[13px] block\">{trip.truckNo}</span>\n                          <span className=\"text-[10px] text-slate-500 font-medium flex items-center gap-1 mt-0.5 font-sans\">\n                            <User className=\"w-3 h-3 text-slate-400\" />\n                            {trip.driverName || \'No Driver\'}\n                          </span>\n                        </td>\n\n                        {/* TRIP TIMEFRAME */}\n                        <td className=\"px-4 py-4 text-center\">\n                          <div className=\"inline-flex items-center gap-1.5 bg-slate-50 border border-slate-150 px-2.5 py-1 rounded text-xs\">\n                            {dateFormatted(trip.startDate)}\n                            <span className=\"text-slate-350 font-normal select-none\">&rarr;</span>\n                            {dateFormatted(trip.endDate)}\n                          </div>\n                          <span className=\"text-[10px] text-slate-500 block mt-1 font-semibold\">{m.noOfDays} transport day{m.noOfDays > 1 ? \'s\' : \'\'}</span>\n                        </td>\n\n                        {/* SUB-TRIPS COUNTER */}\n                        <td className=\"px-4 py-4 text-center bg-slate-50/30\">\n                          <span className=\"inline-block bg-blue-50 border border-blue-100 text-blue-700 text-xs font-bold px-2.5 py-0.5 rounded-full shadow-3xs font-mono\">\n                            {trip.subTrips?.length || 0} segments\n                          </span>\n                        </td>\n\n                        {/* INCOMINGS */}\n                        <td className=\"px-4 py-4 text-right\">\n                          {currencyFormatted(m.income)}\n                        </td>\n\n                        {/* COSTING */}\n                        <td className=\"px-4 py-4 text-right font-mono font-bold text-red-600\">\n                          \342\202\271{m.totalExpense.toLocaleString(\'en-IN\')}\n                        </td>\n\n                        {/* PROFITS */}\n                        <td className={`px-4 py-4 text-right font-mono font-bold ${m.profit >= 0 ? \'text-emerald-700\' : \'text-red-700\'}`}>\n                          \342\202\271{m.profit.toLocaleString(\'en-IN\')}\n                          <span className=\"text-[9px] text-slate-400 block font-normal font-sans mt-0.5\">Margin: {m.income > 0 ? Math.round((m.profit/m.income)*100) : 0}%</span>\n                        </td>\n\n                        {/* GENERAL STATUS */}\n                        <td className=\"px-4 py-4 text-center\">\n                          {getStatusBadge(trip.status)}\n                        </td>\n\n                        {/* OPTIONS */}\n                        <td className=\"px-6 py-4 text-right\" onClick={(e) => e.stopPropagation()}>\n                          <div className=\"flex justify-end gap-1 px-1\">\n                            {/* INSPECTOR VIEW */}\n                            <button\n                              title=\"Full 23-Columns Sheet Inspector\"\n                              onClick={() => setViewingEntry(trip)}\n                              className=\"p-1 px-2.5 bg-slate-50 text-slate-600 hover:text-blue-600 hover:bg-slate-100 rounded border border-slate-200 transition cursor-pointer flex items-center h-8\"\n                            >\n                              <Eye className=\"w-3.5 h-3.5\" />\n                            </button>\n                            {/* MODIFY */}\n                            <button\n                              title=\"Modify Master Fleet Record\"\n                              onClick={() => {\n                                onEditEntry(trip);\n                              }}\n                              className=\"p-1 px-25 bg-slate-50 text-slate-605 text-slate-700 hover:text-slate-905 hover:bg-slate-100 rounded border border-slate-200 transition cursor-pointer flex items-center h-8\"\n                            >\n                              <Edit2 className=\"w-3.5 h-3.5\" />\n                            </button>\n                            {/* SCRAP */}\n                            <button\n                              title=\"Permanent deletion of trip segments\"\n                              onClick={() => {\n                                if (confirm(`Caution! Deleting Master Trip ${trip.tripNo} will permanently delete all ${trip.subTrips?.length || 0} sub-trip segments, loaded cargos, expenditures and advances receipts. Continue?`)) {\n                                  onDeleteEntry(trip.id);\n                                }\n                              }}\n                              className=\"p-1 px-2.5 bg-rose-50 text-rose-600 hover:sky-hover hover:bg-rose-100 rounded border border-rose-100 transition cursor-pointer flex items-center h-8\"\n                            >\n                              <Trash2 className=\"w-3.5 h-3.5\" />\n                            </button>\n                          </div>\n                        </td>\n                      </tr>\n\n                      {/* COLLAPSIBLE ACCORDION CONTAINER: RENDER DYNAMIC SUB-TRIPS DETAIL CHIPS */}\n                      {isExpanded && (\n                        <tr id={`subtrips-accordion-${trip.id}`} className=\"bg-slate-50/60 border-t border-b border-blue-100/65\">\n                          <td colSpan={10} className=\"p-5 pl-14 pr-6\">\n                            <div className=\"space-y-4 animate-scale-up\">\n                              \n                              <div className=\"flex flex-col md:flex-row md:items-center justify-between gap-3 border-b border-slate-200 pb-2.5\">\n                                <div className=\"space-y-0.5\">\n                                  <h4 className=\"text-xs font-bold text-slate-900 tracking-wider flex items-center gap-1.5 uppercase font-sans\">\n                                    <ListCollapse className=\"w-4 h-4 text-blue-650\" />\n                                    Active Sub_Trip Segments of {trip.tripNo}\n                                  </h4>\n                                  <p className=\"text-[11px] text-slate-505\">Details registered per individual load segment ref.</p>\n                                </div>\n\n                                <div className=\"flex flex-wrap items-center gap-3 text-xs\">\n                                  <div className=\"bg-slate-200/50 p-1.5 px-3 rounded-lg flex items-center gap-1.5\">\n                                    <Gauge className=\"w-3.5 h-3.5 text-slate-500\" />\n                                    <span className=\"text-slate-600 font-sans\">Odometer:</span>\n                                    <span className=\"font-mono font-bold text-slate-800\">{trip.startingKM || 0} KM &rarr; {trip.endingKM || 0} KM</span>\n                                    <span className=\"bg-blue-105 border border-blue-100 text-blue-750 text-[10px] font-bold px-1.5 rounded ml-1\">Total: {m.totalKM} KM</span>\n                                  </div>\n                                  \n                                  <div className=\"bg-amber-100/50 p-1.5 px-3 rounded-lg flex items-center gap-1.5 border border-amber-200/40\">\n                                    <Fuel className=\"w-3.5 h-3.5 text-amber-600\" />\n                                    <span className=\"text-slate-600 font-sans\">Mileage efficiency:</span>\n                                    <span className=\"font-mono font-bold text-slate-800\">{m.fuelLiters > 0 ? `${m.millage.toFixed(2)} KM/L` : \'0 KM/L\'}</span>\n                                    <span className=\"text-[10px] text-slate-450\">({m.fuelLiters} Liters of Fuel)</span>\n                                  </div>\n\n                                  <div className=\"bg-slate-200/50 p-1.5 px-3 rounded-lg flex items-center gap-1.5\">\n                                    <ArrowRightLeft className=\"w-3.5 h-3.5 text-slate-550\" />\n                                    <span className=\"text-slate-600\">Per KM cost:</span>\n                                    <span className=\"font-mono font-bold text-slate-800\">\342\202\271{m.perKM.toFixed(2)}/KM</span>\n                                  </div>\n                                </div>\n                              </div>\n\n                              {/* CHILD SUB-TRIPS LIST */}\n                              {(!trip.subTrips || trip.subTrips.length === 0) ? (\n                                <p className=\"text-xs text-slate-405 italic py-4\">No segment sub-trips defined yet. Edit Trip to register segments.</p>\n                              ) : (\n                                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                                  {trip.subTrips.map((st, sidx) => (\n                                    <div key={st.id} className=\"bg-white border border-slate-200 rounded-xl p-4 shadow-3xs hover:border-slate-300 transition relative\">\n                                      <div className=\"absolute top-3 right-3 text-[10px] font-mono text-slate-400 bg-slate-50 border border-slate-150 px-1.5 rounded font-extrabold shadow-3xs uppercase\">\n                                        Segment #{sidx + 1}\n                                      </div>\n\n                                      <div className=\"flex gap-2 items-start\">\n                                        <div className=\"p-1 px-2.5 bg-slate-50 border border-slate-200 rounded text-center shrink-0 shadow-3xs font-medium\">\n                                          <span className=\"block text-[9px] text-slate-450 uppercase tracking-widest font-bold\">Loaded On</span>\n                                          <span className=\"block font-mono text-[11px] font-extrabold text-slate-850\">{st.loadingDate || \'N/A\'}</span>\n                                        </div>\n                                        <div>\n                                          <div className=\"text-xs font-bold text-slate-900 flex items-center gap-1 font-sans\">\n                                            <MapPin className=\"w-3 h-3 text-slate-400\" />\n                                            {st.routeFrom || \'Origin\'} &rarr; {st.routeTo || \'Destination\'}\n                                          </div>\n                                          <span className=\"text-[10px] text-blue-650 font-bold block mt-0.5 capitalize bg-blue-50 border border-blue-50/50 px-1.5 rounded-sm max-w-max\">Office: {st.officeName}</span>\n                                        </div>\n                                      </div>\n\n                                      {/* SEG EXPENSES DETAIL ROW LIST */}\n                                      <div className=\"grid grid-cols-3 gap-2 mt-4 text-[10px] border-t border-slate-100 pt-3\">\n                                        <div>\n                                          <span className=\"text-slate-400 block font-normal\">Income / Load</span>\n                                          <span className=\"font-mono font-extrabold text-emerald-700\">\342\202\271{st.income?.toLocaleString(\'en-IN\')}</span>\n                                        </div>\n                                        <div>\n                                          <span className=\"text-slate-400 block font-normal\">Odo start KM</span>\n                                          <span className=\"font-mono font-semibold text-slate-700\">{st.startingKM || 0} KM</span>\n                                        </div>\n                                        <div>\n                                          <span className=\"text-slate-400 block font-normal\">Odo end KM</span>\n                                          <span className=\"font-mono font-semibold text-slate-700\">{st.endingKM || 0} KM</span>\n                                        </div>\n                                      </div>\n\n                                      {/* MORE DETAILED EXPENSES MATRICES */}\n                                      <div className=\"bg-slate-50 rounded-lg p-2.5 mt-3 grid grid-cols-2 md:grid-cols-4 gap-2 text-[9px] border border-slate-100 font-sans font-medium text-slate-600\">\n                                        <div>\n                                          <span className=\"text-slate-400 block font-light\">Loading EXP</span>\n                                          <span className=\"font-mono font-bold text-slate-800\">\342\202\271{st.loadingExpense}</span>\n                                        </div>\n                                        <div>\n                                          <span className=\"text-slate-400 block font-light\">Unloading EXP</span>\n                                          <span className=\"font-mono font-bold text-slate-800\">\342\202\271{st.unloadingExpense}</span>\n                                        </div>\n                                        <div>\n                                          <span className=\"text-slate-400 block font-light\">RTO EXP</span>\n                                          <span className=\"font-mono font-bold text-slate-800\">\342\202\271{st.rtoExpense}</span>\n                                        </div>\n                                        <div>\n                                          <span className=\"text-slate-400 block font-light text-amber-705 flex items-center gap-0.5\">Diesel {st.dieselLiters > 0 && `(${st.dieselLiters}L)`}</span>\n                                          <span className=\"font-mono font-bold text-amber-700\">\342\202\271{st.dieselAmount || 0}</span>\n                                        </div>\n                                        <div>\n                                          <span className=\"text-slate-400 block font-light\">Add Blue</span>\n                                          <span className=\"font-mono font-bold text-slate-800\">\342\202\271{st.addBlueExpense}</span>\n                                        </div>\n                                        <div>\n                                          <span className=\"text-slate-400 block font-light\">Fastag Expense</span>\n                                          <span className=\"font-mono font-bold text-slate-800\">\342\202\271{st.fastagExpense}</span>\n                                        </div>\n                                        <div>\n                                          <span className=\"text-slate-400 block font-light\">Driver Wages</span>\n                                          <span className=\"font-mono font-semibold text-slate-800\">\342\202\271{st.driverWages}</span>\n                                        </div>\n                                        <div>\n                                          <span className=\"text-slate-400 block font-light\">Segment Other</span>\n                                          <span className=\"font-mono font-semibold text-slate-800\">\342\202\271{st.otherExpense}</span>\n                                        </div>\n                                      </div>\n\n                                      {st.notes && (\n                                        <p className=\"text-[9px] text-slate-500 bg-amber-50 rounded-xs px-2 py-1 border border-amber-100/40 font-mono mt-3\">\n                                          Rem: {st.notes}\n                                        </p>\n                                      )}\n                                    </div>\n                                  ))}\n                                </div>\n                              )}\n\n                              {/* PAYMENT TRACKING ON COLLAPSED BAR */}\n                              <div className=\"bg-white border border-slate-200 rounded-xl p-4 shadow-3xs text-xs font-sans\">\n                                <h5 className=\"font-bold text-slate-800 uppercase tracking-widest text-[10px] mb-2.5 font-sans flex items-center gap-1 text-blue-600\">\n                                  <TrendingUp className=\"w-4 h-4\" />\n                                  Outstanding Receivables Status\n                                </h5>\n                                <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 text-slate-650\">\n                                  <div className=\"bg-slate-50 p-2.5 rounded border border-slate-100 font-medium text-slate-600\">\n                                    <span className=\"text-slate-450 block text-[9px] uppercase\">Income Billed</span>\n                                    <span className=\"font-mono text-xs font-black text-slate-900\">\342\202\271{m.income.toLocaleString()}</span>\n                                  </div>\n                                  <div className=\"bg-slate-50 p-2.5 rounded border border-slate-100 font-semibold text-slate-600\">\n                                    <span className=\"text-slate-450 block text-[9px] uppercase\">Advances realized</span>\n                                    <span className=\"font-mono text-xs font-black text-emerald-750\">\342\202\271{m.paymentsReceived.toLocaleString()}</span>\n                                  </div>\n                                  <div className=\"bg-slate-50 p-2.5 rounded border border-slate-100 font-bold text-slate-600\">\n                                    <span className=\"text-slate-450 block text-[9px] uppercase text-red-600 font-bold\">Outstanding Default</span>\n                                    <span className={`font-mono text-xs font-black ${m.outstandingBalance > 0 ? \'text-red-650 text-red-600\' : \'text-emerald-700\'}`}>\342\202\271{m.outstandingBalance.toLocaleString()}</span>\n                                  </div>\n                                  <div className=\"bg-slate-50 p-2.5 rounded border border-slate-100 flex items-center gap-1.5\">\n                                    <span className=\"text-slate-450 text-[9px] uppercase block w-1/2\">Receipts Log:</span>\n                                    <p className=\"font-mono text-[10px] text-slate-500 font-normal leading-tight flex-1\">\n                                      {(trip.payments || []).length > 0 \n                                        ? (trip.payments || []).map(p => `\342\202\271${p.amount} (${getAccountName(p.receivedBy)})`).join(\', \')\n                                        : \'No receipts registered.\'}\n                                    </p>\n                                  </div>\n                                </div>\n                              </div>\n\n                            </div>\n                          </td>\n                        </tr>\n                      )}\n                    </React.Fragment>\n                  );\n                })\n              )}\n            </tbody>\n\n            {/* GRAND FILTERED TOTALS ON FOOTER */}\n            {filteredTrips.length > 0 && (\n              <tfoot className=\"bg-slate-50 text-slate-705 font-bold text-[12px] border-t border-slate-200 uppercase tracking-wide font-mono\">\n                <tr className=\"bg-slate-50/90 shrink-0 font-bold\">\n                  <td colSpan={2} className=\"px-6 py-4 pl-14 text-left font-sans text-xs text-blue-650 font-extrabold pr-2\">\n                    Filtered Cumulative totals\n                  </td>\n                  <td className=\"px-4 py-4 text-left font-sans text-[10px] text-slate-500 font-semibold uppercase font-sans\">\n                    {filteredTrips.length} master trips &bull; {totals.km.toLocaleString(\'en-IN\')} KM total\n                  </td>\n                  <td className=\"px-4 py-4 text-right\"></td>\n                  <td className=\"px-4 py-4 text-center\"></td>\n                  <td className=\"px-4 py-4 text-right text-slate-900 text-[13px] font-extrabold\">\n                    \342\202\271{totals.income.toLocaleString(\'en-IN\')}\n                  </td>\n                  <td className=\"px-4 py-4 text-right text-red-600 font-extrabold\">\n                    \342\202\271{totals.expense.toLocaleString(\'en-IN\')}\n                  </td>\n                  <td className={`px-4 py-4 text-right text-[13px] font-black ${totals.profit >= 0 ? \'text-emerald-700\' : \'text-red-700\'}`}>\n                    \342\202\271{totals.profit.toLocaleString(\'en-IN\')}\n                  </td>\n                  <td className=\"px-4 py-4 text-center\"></td>\n                  <td className=\"px-6 py-4 text-right font-medium\"></td>\n                </tr>\n              </tfoot>\n            )}\n          </table>\n        </div>\n      </div>\n\n      {/* SINGLE MASTER TRIP COMPLETE 23-COLUMNS PRINT AUDIT TAB MODAL */}\n      {viewingEntry && (() => {\n        const m = getTripMetrics(viewingEntry);\n        return (\n          <div id=\"inspector-overlay\" className=\"fixed inset-0 bg-slate-950/65 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n            <div id=\"inspector-card\" className=\"bg-white border border-slate-200 rounded-xl w-full max-w-4xl shadow-xl overflow-hidden animate-scale-up\">\n              \n              <div className=\"px-6 py-4.5 bg-slate-50 border-b border-slate-200 flex justify-between items-center\">\n                <div>\n                  <span className=\"text-[10px] text-blue-600 uppercase tracking-wider font-extrabold block\">Ultimate Fleet-Book Document Ledger</span>\n                  <h3 className=\"text-lg font-bold text-slate-900 font-mono tracking-wide\">{viewingEntry.tripNo} &bull; {viewingEntry.truckNo}</h3>\n                </div>\n                <button\n                  id=\"btn-close-inspector\"\n                  onClick={() => setViewingEntry(null)}\n                  className=\"p-1 px-2.5 text-slate-400 hover:text-slate-650 bg-slate-200/50 hover:bg-slate-250 rounded-lg transition shrink-0 cursor-pointer\"\n                >\n                  <X className=\"w-4 h-4\" />\n                </button>\n              </div>\n\n              <div className=\"p-6 space-y-6 max-h-[75vh] overflow-y-auto\">\n                {/* primary bento grid details */}\n                <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n                  <div className=\"bg-slate-50/50 p-3 rounded-lg border border-slate-200\">\n                    <span className=\"text-[9px] text-slate-500 uppercase block font-bold leading-tight\">Driver Person</span>\n                    <span className=\"text-xs font-semibold text-slate-900 block mt-1\">{viewingEntry.driverName || \'No Driver\'}</span>\n                  </div>\n                  <div className=\"bg-slate-50/50 p-3 rounded-lg border border-slate-200\">\n                    <span className=\"text-[9px] text-slate-500 uppercase block font-bold leading-tight\">Segment Dates</span>\n                    <span className=\"text-xs font-semibold text-slate-800 font-mono block mt-1 truncate\">{viewingEntry.startDate} to {viewingEntry.endDate}</span>\n                  </div>\n                  <div className=\"bg-slate-50/50 p-3 rounded-lg border border-slate-200\">\n                    <span className=\"text-[9px] text-slate-500 uppercase block font-bold leading-tight\">Master odometer</span>\n                    <span className=\"text-xs font-semibold text-slate-800 font-mono block mt-1\">{viewingEntry.startingKM || 0} KM - {viewingEntry.endingKM || 0} KM</span>\n                  </div>\n                  <div className=\"bg-slate-50/50 p-3 rounded-lg border border-slate-200\">\n                    <span className=\"text-[9px] text-slate-500 uppercase block font-bold leading-tight\">Distance Logged</span>\n                    <span className=\"text-xs font-extrabold text-blue-650 font-mono block mt-1 text-blue-600\">{m.totalKM} KM Range</span>\n                  </div>\n                </div>\n\n                {/* 23 flat parameters audit section */}\n                <div className=\"border border-slate-200 rounded-xl overflow-hidden shadow-3xs bg-white\">\n                  <div className=\"bg-slate-50 px-4 py-2.5 border-b border-slate-200 font-bold uppercase text-[10px] tracking-widest text-slate-655 flex justify-between\">\n                    <span>Flat Consolidated Specifications (23 Columns Schema)</span>\n                    <span className=\"font-mono text-blue-600 text-xs font-extrabold\">{viewingEntry.tripNo}</span>\n                  </div>\n\n                  <div className=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-x-4 divide-y divide-slate-100 p-4 font-mono text-[11px] gap-y-3\">\n                    <div className=\"pt-2\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">1. Truck No</span>\n                      <span className=\"font-bold text-slate-800\">{viewingEntry.truckNo}</span>\n                    </div>\n                    <div>\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">2. Trip No</span>\n                      <span className=\"font-bold text-slate-800\">{viewingEntry.tripNo}</span>\n                    </div>\n                    <div>\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">3. Trip Start</span>\n                      <span className=\"text-slate-700\">{viewingEntry.startDate || \'N/A\'}</span>\n                    </div>\n                    <div>\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">4. Trip End</span>\n                      <span className=\"text-slate-700\">{viewingEntry.endDate || \'N/A\'}</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">5. Driver Name</span>\n                      <span className=\"font-sans text-slate-800 font-semibold\">{viewingEntry.driverName || \'N/A\'}</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">6. income (\342\202\271)</span>\n                      <span className=\"font-extrabold text-slate-850 text-emerald-800\">\342\202\271{m.income.toLocaleString()}</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">7. Loading EXP</span>\n                      <span className=\"text-slate-700\">\342\202\271{m.loadingExpense.toLocaleString()}</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">8. Unload EXP</span>\n                      <span className=\"text-slate-700\">\342\202\271{m.unloadingExpense.toLocaleString()}</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">9. RTO EXP</span>\n                      <span className=\"text-slate-700\">\342\202\271{m.rtoExpense.toLocaleString()}</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">10. Diesel EXP</span>\n                      <span className=\"font-black text-rose-650 text-red-600\">\342\202\271{m.dieselExpense.toLocaleString()}</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">11. Add Blue</span>\n                      <span className=\"text-slate-700\">\342\202\271{m.addBlueExpense.toLocaleString()}</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">12. Fastag EXP</span>\n                      <span className=\"text-slate-700\">\342\202\271{m.fastagExpense.toLocaleString()}</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">13. Driver Wages</span>\n                      <span className=\"text-slate-700\">\342\202\271{m.driverWages.toLocaleString()}</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">14. Other EXP</span>\n                      <span className=\"text-slate-700\">\342\202\271{m.otherExpense.toLocaleString()}</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">15. Fuel Liters</span>\n                      <span className=\"text-slate-700 font-extrabold\">{m.fuelLiters} Liters</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">16. Starting KM</span>\n                      <span className=\"text-slate-700\">{viewingEntry.startingKM || 0} KM</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">17. Ending KM</span>\n                      <span className=\"text-slate-700\">{viewingEntry.endingKM || 0} KM</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">18. Total Range</span>\n                      <span className=\"text-blue-600 font-bold\">{m.totalKM} KM</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">19. Fuel Mileage</span>\n                      <span className=\"font-extrabold text-amber-700 bg-amber-50 px-1 rounded\">{m.fuelLiters > 0 ? `${m.millage.toFixed(2)} KM/L` : \'0.00 KM/L\'}</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">20. Cost Per KM</span>\n                      <span className=\"text-slate-800 font-bold\">\342\202\271{m.perKM.toFixed(2)} / KM</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">21. Days Duration</span>\n                      <span className=\"text-slate-800 font-bold\">{m.noOfDays} Days</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">22. Total Outflow</span>\n                      <span className=\"font-bold text-red-600\">\342\202\271{m.totalExpense.toLocaleString()}</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">23. Profit Yield</span>\n                      <span className={`font-black tracking-tight text-xs ${m.profit >= 0 ? \'text-emerald-705 text-emerald-800\' : \'text-red-700\'}`}>\342\202\271{m.profit.toLocaleString()}</span>\n                    </div>\n                    <div className=\"pt-2.5\">\n                      <span className=\"text-slate-450 block font-sans text-[10px] uppercase font-bold\">Debit Status</span>\n                      <span className=\"font-sans font-extrabold\">{viewingEntry.status}</span>\n                    </div>\n                  </div>\n                </div>\n\n                {/* sub trip details segments table inside the modal */}\n                <div>\n                  <h4 className=\"text-xs font-bold text-slate-800 uppercase tracking-wider mb-2.5 pl-1 font-sans\">\n                    Detailed Segments & Loader Outlaws ({viewingEntry.subTrips?.length || 0} cargo loads)\n                  </h4>\n                  <div className=\"bg-white border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-100 text-xs\">\n                    {(!viewingEntry.subTrips || viewingEntry.subTrips.length === 0) ? (\n                      <p className=\"p-4 text-center text-slate-400 italic\">No sub-trip segments logged.</p>\n                    ) : (\n                      viewingEntry.subTrips.map((s, idx) => (\n                        <div key={s.id} className=\"p-4 hover:bg-slate-50/50 transition\">\n                          <div className=\"flex justify-between items-center bg-slate-50/70 p-2 rounded-lg border border-slate-150 mb-3\">\n                            <span className=\"text-slate-800 font-mono font-bold font-sans\">Segment #{idx + 1} &bull; {s.routeFrom} &rarr; {s.routeTo}</span>\n                            <span className=\"font-sans font-bold text-slate-500 text-[10px] bg-slate-205 py-0.5 px-2 rounded-md bg-slate-200 uppercase leading-none\">Office: {s.officeName}</span>\n                          </div>\n\n                          <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3 bg-white p-1 text-[11px] font-sans\">\n                            <div className=\"p-1 px-2 border-l-2 border-emerald-500\">\n                              <span className=\"text-slate-450 block font-sans text-[9px] uppercase\">Income (\342\202\271)</span>\n                              <span className=\"font-mono font-bold text-emerald-800\">\342\202\271{s.income.toLocaleString()}</span>\n                            </div>\n                            <div className=\"p-1 px-2 border-l-2 border-red-500\">\n                              <span className=\"text-slate-450 block font-sans text-[9px] uppercase\">Diesel Cost / Liters</span>\n                              <span className=\"font-mono font-bold text-slate-800\">\342\202\271{(s.dieselAmount || 0).toLocaleString()} <span className=\"text-[10px] font-normal text-slate-450\">({s.dieselLiters} L @ \342\202\271{s.dieselRate})</span></span>\n                            </div>\n                            <div className=\"p-1 px-2 border-l-2 border-slate-400\">\n                              <span className=\"text-slate-450 block font-sans text-[9px] uppercase\">Loading/Unloading</span>\n                              <span className=\"font-mono font-bold text-slate-800\">\342\202\271{(s.loadingExpense + s.unloadingExpense).toLocaleString()}</span>\n                            </div>\n                            <div className=\"p-1 px-2 border-l-2 border-slate-400\">\n                              <span className=\"text-slate-450 block font-sans text-[9px] uppercase\">Wages + Other</span>\n                              <span className=\"font-mono font-bold text-slate-800\">\342\202\271{(s.driverWages + s.otherExpense).toLocaleString()}</span>\n                            </div>\n                          </div>\n                        </div>\n                      ))\n                    )}\n                  </div>\n                </div>\n\n                {/* payments logs within modal audit sheet */}\n                <div className=\"border border-slate-200 rounded-xl overflow-hidden bg-white\">\n                  <div className=\"bg-slate-50 px-4 py-2 border-b border-slate-200\">\n                    <span className=\"text-[10px] text-blue-650 uppercase tracking-wider font-extrabold\">Advances & Outstanding collection log</span>\n                  </div>\n                  <div className=\"divide-y divide-slate-150\">\n                    {(!viewingEntry.payments || viewingEntry.payments.length === 0) ? (\n                      <div className=\"p-4 text-center text-xs text-slate-400 italic\">No payments or receipts registered. Balance is 100% collectable.</div>\n                    ) : (\n                      viewingEntry.payments.map((p, pidx) => (\n                        <div key={p.id} className=\"p-3 text-xs flex justify-between items-center items-center hover:bg-slate-50/50\">\n                          <div>\n                            <span className=\"font-bold text-slate-700\">Receipt Line #{pidx + 1}</span>\n                            {p.notes && <p className=\"text-[10px] text-slate-400 mt-0.5 italic\">{p.notes}</p>}\n                          </div>\n                          <div className=\"flex items-center gap-6 font-mono font-bold\">\n                            <span className=\"text-slate-900 border border-slate-150 rounded px-2 bg-slate-50 py-0.5\">\342\202\271{p.amount.toLocaleString()}</span>\n                            <span className=\"text-blue-650 font-bold font-sans text-[11px]\">{getAccountName(p.receivedBy)}</span>\n                            <span className=\"text-slate-450 text-[10px] font-normal font-mono\">{p.date}</span>\n                          </div>\n                        </div>\n                      ))\n                    )}\n                  </div>\n                </div>\n\n                {/* remarks */}\n                {viewingEntry.notes && (\n                  <div className=\"bg-amber-50/75 border border-amber-100 rounded-xl p-4 text-xs text-slate-600\">\n                    <span className=\"text-[10px] font-bold text-amber-800 uppercase tracking-widest block mb-1\">Remarks / Audit warnings</span>\n                    <p className=\"leading-relaxed\">{viewingEntry.notes}</p>\n                  </div>\n                )}\n              </div>\n\n              <div className=\"px-6 py-4 bg-slate-50 border-t border-slate-200 text-right\">\n                <button\n                  id=\"inspector-close-bottom\"\n                  onClick={() => setViewingEntry(null)}\n                  className=\"bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs px-5 py-2.5 rounded-lg transition shadow-2xs cursor-pointer h-10\"\n                >\n                  Finished Review\n                </button>\n              </div>\n\n            </div>\n          </div>\n        );\n      })()}\n    </div>\n  );\n}"
    }
