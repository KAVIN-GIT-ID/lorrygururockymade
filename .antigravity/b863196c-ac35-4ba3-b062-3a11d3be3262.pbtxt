          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            {subTrips.length > 0 ? ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              <div className=\"bg-white border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-150 shadow-3xs max-h-[220px] overflow-y-auto font-sans\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                <table className=\"w-full text-xs text-left\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <thead className=\"bg-slate-50 text-[10px] text-slate-500 font-bold uppercase tracking-wider\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    <tr>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
