border border-transparent text-right\">\n                      \342\202\271{dieselAmount.toLocaleString()}\n                    </div>\n                  </div>\n                </div>"
      replacement_content: "                {/* MULTI-FUEL N-LEVEL LOGGER BLOCK */}\n                <div className=\"md:col-span-4 bg-amber-50/70 border border-amber-200 rounded-xl p-3.5 space-y-3.5\">\n                  <div className=\"flex justify-between items-center border-b border-amber-100 pb-2\">\n                    <span className=\"text-[11px] font-extrabold text-amber-900 uppercase tracking-wider flex items-center gap-1\">\n                      <Fuel className=\"w-4 h-4 text-amber-700\" />\n                      Dynamic Diesel Fuel Receipts Log ({fuels.length} slips registered)\n                    </span>\n                    <span className=\"text-xs font-mono font-black text-amber-900 bg-amber-100/80 px-2 py-0.5 rounded\">\n                      Sum: {dieselLiters.toLocaleString()} L / \342\202\271{dieselAmount.toLocaleString()}\n                    </span>\n                  </div>\n\n                  {/* Inline fuel receipt add form */}\n                  <div className=\"grid grid-cols-2 md:grid-cols-6 gap-2.5 items-end\">\n                    <div>\n                      <label className=\"block text-[9px] text-amber-800 font-bold uppercase mb-1\">Receipt Date</label>\n                      <input\n                        type=\"date\"\n                        value={fuelDateInput}\n                        onChange={(e) => setFuelDateInput(e.target.value)}\n                        className=\"w-full bg-white border border-amber-200 text-slate-800 rounded px-2 py-1 text-xs font-mono\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-[9px] text-amber-800 font-bold uppercase mb-1\">Liters <span className=\"text-red-500\">*</span></label>\n                      <input\n                        type=\"number\"\n                        min=\"0\"\n                        step=\"any\"\n                        placeholder=\"0.0\"\n                        value={fuelLitersInput}\n                        onChange={(e) => setFuelLitersInput(e.target.value === \'\' ? \'\' : parseFloat(e.target.value) || 0)}\n                        className=\"w-full bg-white border border-amber-200 text-slate-850 rounded px-2 py-1 text-xs text-right font-mono\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-[9px] text-amber-800 font-bold uppercase mb-1\">Rate / Litre <span className=\"text-red-500\">*</span></label>\n                      <input\n                        type=\"number\"\n                        min=\"0\"\n                        step=\"any\"\n                        placeholder=\"\342\202\2710.0\"\n                        value={fuelRateInput}\n                        onChange={(e) => setFuelRateInput(e.target.value === \'\' ? \'\' : parseFloat(e.target.value) || 0)}\n                        className=\"w-full bg-white border border-amber-200 text-slate-850 rounded px-2 py-1 text-xs text-right font-mono\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-[9px] text-amber-800 font-bold uppercase mb-1\">Pump Vendor / Slip No</label>\n                      <input\n                        type=\"text\"\n                        placeholder=\"e.g. HP - Salem\"\n                        value={fuelVendorInput}\n                        onChange={(e) => setFuelVendorInput(e.target.value)}\n                        className=\"w-full bg-white border border-amber-200 text-slate-850 rounded px-2 py-1 text-xs\"\n                      />\n                    </div>\n                    <div>\n                      <label className=\"block text-[9px] text-amber-800 font-bold uppercase mb-1\">Payment Mode</label>\n                      <select\n                        value={fuelPayModeInput}\n                        onChange={(e) => setFuelPayModeInput(e.target.value)}\n                        className=\"w-full bg-white border border-amber-200 text-slate-800 rounded px-1.5 py-1 text-xs\"\n                      >\n                        <option value=\"Cash\">Cash</option>\n                        <option value=\"Fastag Mode\">Fastag Mode</option>\n                        <option value=\"GPay / UPI\">GPay / UPI</option>\n                        <option value=\"Corporate Card\">Corporate Card</option>\n                        <option value=\"Fuel Card\">Fuel Card</option>\n                      </select>\n                    </div>\n                    <div className=\"flex gap-1\">\n                      <div className=\"flex-1\">\n                        <label className=\"block text-[9px] text-amber-800 font-bold uppercase mb-1\">Status</label>\n                        <select\n                          value={fuelStatusInput}\n                          onChange={(e) => setFuelStatusInput(e.target.value as \'Paid\' | \'Pending\')}\n                          className=\"w-full bg-white border border-amber-200 text-slate-800 rounded px-1 py-1 text-xs\"\n                        >\n                          <option value=\"Paid\">Paid</option>\n                          <option value=\"Pending\">Pending</option>\n                        </select>\n                      </div>\n                      <button\n                        type=\"button\"\n                        onClick={handleAddFuelEntry}\n                        className=\"bg-amber-600 hover:bg-amber-700 text-white font-bold px-3.5 py-1 rounded shadow-sm text-xs cursor-pointer flex items-center h-[26px]\"\n                      >\n                        Add\n                      </button>\n                    </div>\n                  </div>\n\n                  {/* Registered fuel entries table list */}\n                  {fuels.length > 0 ? (\n                    <div className=\"border border-amber-200 bg-white rounded-lg overflow-hidden max-h-[160px] overflow-y-auto\">\n                      <table className=\"w-full text-left text-xs font-sans\">\n                        <thead className=\"bg-amber-100 text-amber-900 uppercase text-[9px] font-bold\">\n                          <tr>\n                            <th className=\"p-1.5 pl-2.5\">Date</th>\n                            <th className=\"p-1.5\">Pump Vendor</th>\n                            <th className=\"p-1.5 text-right\">Liters</th>\n                            <th className=\"p-1.5 text-right\">Rate</th>\n                            <th className=\"p-1.5 text-right\">Amount</th>\n                            <th className=\"p-1.5\">Pay Mode</th>\n                            <th className=\"p-1.5\">Status</th>\n                            <th className=\"p-1.5 text-center\">Action</th>\n                          </tr>\n                        </thead>\n                        <tbody className=\"divide-y divide-amber-100\">\n                          {fuels.map((f) => (\n                            <tr key={f.id} className=\"hover:bg-amber-50/55 text-slate-700\">\n                              <td className=\"p-1.5 pl-2.5 font-mono\">{f.date}</td>\n                              <td className=\"p-1.5 font-medium\">{f.vendor}</td>\n                              <td className=\"p-1.5 text-right font-mono font-bold\">{f.liters} L</td>\n                              <td className=\"p-1.5 text-right font-mono\">\342\202\271{f.rate}</td>\n                              <td className=\"p-1.5 text-right font-mono text-amber-900 font-bold\">\342\202\271{f.amount.toLocaleString()}</td>\n                              <td className=\"p-1.5\">{f.paymentMode}</td>\n                              <td className=\"p-1.5\">\n                                <span className={`px-1 rounded text-[10px] font-bold ${\n                                  f.status === \'Paid\' ? \'bg-emerald-50 text-emerald-700\' : \'bg-red-50 text-red-700\'\n                                }`}>\n                                  {f.status}\n                                </span>\n                              </td>\n                              <td className=\"p-1.5 text-center\">\n                                <button\n                                  type=\"button\"\n                                  onClick={() => handleRemoveFuelEntry(f.id)}\n                                  className=\"text-red-500 hover:text-red-700 font-bold text-xs\"\n                                >\n                                  Delete\n                                </button>\n                              </td>\n                            </tr>\n                          ))}\n                        </tbody>\n                      </table>\n                    </div>\n                  ) : (\n                    <div className=\"text-center py-4 bg-amber-50/40 rounded border border-dashed border-amber-200\">\n                      <p className=\"text-[11px] text-amber-805 italic text-amber-700\">No specific fuel receipts loaded yet. Use the inputs above to register multiple diesel logs.</p>\n                      <p className=\"text-[10px] text-amber-700/60 mt-0.5\">If you prefer single-input mode, type directly here: Liters{\' \'}\n                        <input\n                          type=\"number\"\n                          value={dieselLiters || \'\'}\n                          onChange={(e) => setDieselLiters(parseFloat(e.target.value) || 0)}\n                          className=\"w-16 bg-white border border-amber-250 text-slate-800 rounded px-1 text-[11px] text-right\"\n                        /> Rate{\' \'}\n                        <input\n                          type=\"number\"\n                          value={dieselRate || \'\'}\n                          onChange={(e) => setDieselRate(parseFloat(e.target.value) || 0)}\n                          className=\"w-16 bg-white border border-amber-250 text-slate-800 rounded px-1 text-[11px] text-right\"\n                        />\n  