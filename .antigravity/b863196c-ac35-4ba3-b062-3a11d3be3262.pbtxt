      target_content: "const SEED_TRIPS: TripEntry[] = [\n  {\n    id: \'tr1\',\n    tripNo: \'TRIP-2026-0001\',\n    truckNo: \'MH-12-PQ-4532\',\n    officeName: \'Mumbai Port Logistics\',\n    rental: 45000,\n    loadingDate: \'2026-05-10\',\n    commission: 1500,\n    loadingUnloading: 800,\n    officeMamul: 400,\n    payments: [\n      { id: \'pay1-1\', amount: 15000, date: \'2026-05-10\', receivedBy: \'a1\', notes: \'Stage 1 Advance\' },\n      { id: \'pay1-2\', amount: 10000, date: \'2026-05-12\', receivedBy: \'a3\', notes: \'Stage 2 Advance\' },\n      { id: \'pay1-3\', amount: 5000, date: \'2026-05-14\', receivedBy: \'a1\', notes: \'Stage 3 Advance\' }\n    ],\n    balance: 12300, \n    status: \'In Progress\',\n    notes: \'Primary steel load. Heavy cargo. Secured via Sree Manager GPay.\'\n  },\n  {\n    id: \'tr2\',\n    tripNo: \'TRIP-2026-0001\', // Notice: shared trip number!\n    truckNo: \'MH-12-PQ-4532\',\n    officeName: \'Delhi Transporthub\',\n    rental: 15000,\n    loadingDate: \'2026-05-11\',\n    commission: 500,\n    loadingUnloading: 300,\n    officeMamul: 100,\n    payments: [\n      { id: \'pay2-1\', amount: 10000, date: \'2026-05-11\', receivedBy: \'a3\', notes: \'Loading Advance\' },\n      { id: \'pay2-2\', amount: 4100, date: \'2026-05-13\', receivedBy: \'a2\', notes: \'Unloading Advance\' }\n    ],\n    balance: 0,\n    status: \'Paid\',\n    notes: \'Secondary return load. Associated to TRIP-2026-0001 to balance back.\'\n  },\n  {\n    id: \'tr3\',\n    tripNo: \'TRIP-2026-0002\',\n    truckNo: \'KA-51-AB-9876\',\n    officeName: \'Bangalore Cargo Corp\',\n    rental: 62000,\n    loadingDate: \'2026-05-18\',\n    commission: 2500,\n    loadingUnloading: 1200,\n    officeMamul: 600,\n    payments: [\n      { id: \'pay3-1\', amount: 25000, date: \'2026-05-18\', receivedBy: \'a4\', notes: \'Stage 1 Advance\' },\n      { id: \'pay3-2\', amount: 15000, date: \'2026-05-20\', receivedBy: \'a4\', notes: \'Stage 2 Advance\' },\n      { id: \'pay3-3\', amount: 10000, date: \'2026-05-22\', receivedBy: \'a1\', notes: \'Stage 3 Advance\' }\n    ],\n    balance: 7700,\n    status: \'In Progress\',\n    notes: \'Electronics consignment from Bangalore warehouse. High value.\'\n  }\n];\n\nconst migrateTripsIfNecessary = (list: any[]): TripEntry[] => {\n  return list.map(trip => {\n    if (trip.payments && Array.isArray(trip.payments)) {\n      return trip as TripEntry;\n    }\n    \n    // Create payments from old values\n    const payments = [];\n    if (Number(trip.advance1) > 0) {\n      payments.push({\n        id: \'old-adv1-\' + trip.id,\n        amount: Number(trip.advance1),\n        date: trip.advance1Date || trip.loadingDate || \'2026-05-10\',\n        receivedBy: trip.advance1ReceivedBy || \'\',\n        notes: \'Stage 1 Advance\'\n      });\n    }\n    if (Number(trip.advance2) > 0) {\n      payments.push({\n        id: \'old-adv2-\' + trip.id,\n        amount: Number(trip.advance2),\n        date: trip.advance2Date || trip.loadingDate || \'2026-05-10\',\n        receivedBy: trip.advance2ReceivedBy || \'\',\n        notes: \'Stage 2 Advance\'\n      });\n    }\n    if (Number(trip.advance3) > 0) {\n      payments.push({\n        id: \'old-adv3-\' + trip.id,\n        amount: Number(trip.advance3),\n        date: trip.advance3Date || trip.loadingDate || \'2026-05-10\',\n        receivedBy: trip.advance3ReceivedBy || \'\',\n        notes: \'Stage 3 Advance\'\n      });\n    }\n    // If balance was treated as paid and balance1ReceivedBy is present, let\'s inject it as a payment\n    if (trip.status === \'Paid\' && trip.balance1ReceivedBy) {\n      // Calculate original outstanding balance\n      const rental = Number(trip.rental) || 0;\n      const commission = Number(trip.commission) || 0;\n      const loadingUnloading = Number(trip.loadingUnloading) || 0;\n      const officeMamul = Number(trip.officeMamul) || 0;\n      const advancesSum = payments.reduce((sum, p) => sum + p.amount, 0);\n      const remainingBalance = rental - commission - loadingUnloading - officeMamul - advancesSum;\n      \n      if (remainingBalance > 0) {\n        payments.push({\n          id: \'old-bal-\' + trip.id,\n          amount: remainingBalance,\n          date: trip.balance1Date || trip.loadingDate || \'2026-05-10\',\n          receivedBy: trip.balance1ReceivedBy,\n          notes: \'Final Settlement\'\n        });\n      }\n    }\n    \n    const migrated: TripEntry = {\n      id: trip.id,\n      tripNo: trip.tripNo,\n      truckNo: trip.truckNo,\n      officeName: trip.officeName,\n      rental: Number(trip.rental) || 0,\n      loadingDate: trip.loadingDate || \'2026-05-10\',\n      commission: Number(trip.commission) || 0,\n      loadingUnloading: Number(trip.loadingUnloading) || 0,\n      officeMamul: Number(trip.officeMamul) || 0,\n      payments,\n      balance: 0,\n      status: trip.status || \'Pending\',\n      notes: trip.notes || \'\'\n    };\n    migrated.balance = calculateBalance(migrated);\n    return migrated;\n  });\n};"
      replacement_content: "const SEED_TRIPS: TripEntry[] = [\n  {\n    id: \'tr1\',\n    tripNo: \'TRIP-2026-0001\',\n    truckNo: \'MH-12-PQ-4532\',\n    startDate: \'2026-05-10\',\n    endDate: \'2026-05-15\',\n    driverName: \'Jagdish Singh\',\n    startingKM: 124500,\n    endingKM: 126200,\n    payments: [\n      { id: \'pay1-1\', amount: 35000, date: \'2026-05-10\', receivedBy: \'a1\', notes: \'GPay Loading Advance\' },\n      { id: \'pay1-2\', amount: 15000, date: \'2026-05-13\', receivedBy: \'a3\', notes: \'Office Petty Cash\' }\n    ],\n    subTrips: [\n      {\n        id: \'sub1-1\',\n        loadingDate: \'2026-05-10\',\n        officeName: \'Mumbai Port Logistics\',\n        routeFrom: \'Mumbai\',\n        routeTo: \'Pune\',\n        income: 30000,\n        loadingExpense: 1000,\n        unloadingExpense: 800,\n        rtoExpense: 500,\n        dieselLiters: 150,\n        dieselRate: 95,\n        dieselAmount: 14250,\n        addBlueExpense: 600,\n        fastagExpense: 1200,\n        driverWages: 2500,\n        otherExpense: 300,\n        startingKM: 124500,\n        endingKM: 125100,\n        notes: \'Steel consignment delivered to Pune dealer.\'\n      },\n      {\n        id: \'sub1-2\',\n        loadingDate: \'2026-05-13\',\n        officeName: \'Chennai Roadways Branch\',\n        routeFrom: \'Pune\',\n        routeTo: \'Mumbai\',\n        income: 32000,\n        loadingExpense: 1200,\n        unloadingExpense: 900,\n        rtoExpense: 400,\n        dieselLiters: 160,\n        dieselRate: 95,\n        dieselAmount: 15200,\n        addBlueExpense: 500,\n        fastagExpense: 1100,\n        driverWages: 2500,\n        otherExpense: 200,\n        startingKM: 125100,\n        endingKM: 126200,\n        notes: \'Industrial parts return load back to Mumbai headquarter.\'\n      }\n    ],\n    status: \'In Progress\',\n    notes: \'Primary steel load sequence. Completed both legs. Settlement due\'\n  },\n  {\n    id: \'tr2\',\n    tripNo: \'TRIP-2026-0002\',\n    truckNo: \'KA-51-AB-9876\',\n    startDate: \'2026-05-18\',\n    endDate: \'2026-05-22\',\n    driverName: \'Mahesh Kumar\',\n    startingKM: 84300,\n    endingKM: 85200,\n    payments: [\n      { id: \'pay2-1\', amount: 50000, date: \'2026-05-18\', receivedBy: \'a4\', notes: \'Bank transfer receipt\' }\n    ],\n    subTrips: [\n      {\n        id: \'sub2-1\',\n        loadingDate: \'2026-05-18\',\n        officeName: \'Bangalore Cargo Corp\',\n        routeFrom: \'Bangalore\',\n        routeTo: \'Chennai\',\n        income: 48000,\n        loadingExpense: 800,\n        unloadingExpense: 600,\n        rtoExpense: 300,\n        dieselLiters: 220,\n        dieselRate: 98,\n        dieselAmount: 21560,\n        addBlueExpense: 800,\n        fastagExpense: 1400,\n        driverWages: 3000,\n        otherExpense: 500,\n        startingKM: 84300,\n        endingKM: 85200,\n        notes: \'Apparel boxes consignment. Extremely fast delivery.\'\n      }\n    ],\n    status: \'Paid\',\n    notes: \'Consignment successfully paid and settled fully.\'\n  }\n];\n\nconst migrateTripsIfNecessary = (list: any[]): TripEntry[] => {\n  return list.map(trip => {\n    if (trip.subTrips && Array.isArray(trip.subTrips)) {\n      return trip as TripEntry;\n    }\n    \n    // Create payments and default values for old values\n    const payments = trip.payments || [];\n    \n    const oldRental = Number(trip.rental) || Number(trip.income) || 0;\n    const oldLoadingDate = trip.loadingDate || trip.startDate || \'2026-05-10\';\n    const oldOffice = trip.officeName || \'Mumbai Port Logistics\';\n    \n    const oldComm = Number(trip.commission) || 0;\n    const oldLoadUnload = Number(trip.loadingUnloading) || 0;\n    const oldMamul = Number(trip.officeMamul) || 0;\n\n    const sub: SubTrip = {\n      id: \'sub-migrated-\' + trip.id,\n      loadingDate: oldLoadingDate,\n      officeName: oldOffice,\n      routeFrom: \'Origin\',\n      routeTo: \'Destination\',\n      income: oldRental,\n      loadingExpense: oldLoadUnload / 2 || 200,\n      unloadingExpense: oldLoadUnload / 2 || 200,\n      rtoExpense: oldMamul / 2 || 100,\n      dieselLiters: 100,\n      dieselRate: 95,\n      dieselAmount: oldComm || 5000,\n      addBlueExpense: 300,\n      fastagExpense: 500,\n      driverWages: 2000,\n      otherExpense: 200,\n      startingKM: Number(trip.startingKM) || 124500,\n      endingKM: (Number(trip.startingKM) || 124500) + 400\n    };\n\n    const migrated: TripEntry = {\n      id: trip.id,\n      tripNo: trip.tripNo || \'TRIP-LEGACY\',\n      truckNo: trip.truckNo || \'MH-12-PQ-4532\',\n      startDate: oldLoadingDate,\n      endDate: oldLoadingDate,\n      driverName: trip.driverName || \'Jagdish Singh\',\n      startingKM: sub.startingKM,\n      endingKM: sub.endingKM,\n      payments: payments,\n      subTrips: [sub],\n      status: trip.status || \'Pending\',\n      notes: trip.notes || \'Migrated from legacy offline register.\'\n    };\n    return migrated;\n  });\n};"
