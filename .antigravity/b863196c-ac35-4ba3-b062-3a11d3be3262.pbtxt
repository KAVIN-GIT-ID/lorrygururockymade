        }
        lines {
          text: "                      <td className=\"px-4 py-3.5 text-right pr-6 font-medium\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        <div className=\"flex justify-end gap-1 px-1 opacity-90 sm:opacity-0 group-hover:opacity-100 transition duration-150\">"
