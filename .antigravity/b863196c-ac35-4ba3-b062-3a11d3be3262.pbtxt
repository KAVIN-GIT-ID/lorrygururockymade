        }
        lines {
          text: "                      <td className={`px-4 py-3.5 text-right pr-6 font-mono font-bold text-xs bg-blue-50/30 ${outAmt > 0 ? \'text-red-650\' : \'text-emerald-700\'}`}>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        \342\202\271{outAmt.toLocaleString(\'en-IN\')}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      </td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      {/* STATUS */}"
