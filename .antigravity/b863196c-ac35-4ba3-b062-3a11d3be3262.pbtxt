        lines {
          text: "                  <tbody className=\"divide-y divide-slate-100 font-medium\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    {payments.map((p, pidx) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const acc = activeAccounts.find(a => a.id === p.receivedBy);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const matchedSubTripIndex = subTrips.findIndex(st => st.id === p.subTripId);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const matchedSubTrip = subTrips.find(st => st.id === p.subTripId);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const segmentLabel = matchedSubTrip "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        ? `Leg #${matchedSubTripIndex + 1}: ${matchedSubTrip.routeFrom} \342\236\224 ${matchedSubTrip.routeTo} (${matchedSubTrip.officeName})` "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        : \'General Trip Balance\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      return ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        <tr key={p.id} className=\"hover:bg-slate-50 text-slate-705 font-medium\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
