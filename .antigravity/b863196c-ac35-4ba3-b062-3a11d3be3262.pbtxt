        }
        lines {
          text: "                            title=\"Delete Trip entry\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            onClick={() => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                              if (confirm(`Confirm permanent deletion of Trip segment under Entry ID: ${trip.tripNo}?`)) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                                onDeleteEntry(trip.id);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                              }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
