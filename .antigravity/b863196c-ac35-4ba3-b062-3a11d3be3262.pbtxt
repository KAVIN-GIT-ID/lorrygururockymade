    instruction: "Redesign TruckMaster design block contiguously to match light slate theme."
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div id=\"truck-master-panel\" className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl\">\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white tracking-tight\">Truck Datasheet</h2>\n          <p className=\"text-sm text-slate-400 mt-1\">Manage the fleet list. Only active trucks will appear in trip reports.</p>\n        </div>\n        <button\n          id=\"btn-add-truck\"\n          onClick={() => {\n            resetForm();\n            setShowAddForm(!showAddForm);\n          }}\n          className=\"flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-4 py-2.5 rounded-xl transition duration-150 shadow-lg shadow-indigo-600/20 text-sm\"\n        >\n          {showAddForm ? \'Close Form\' : (\n            <>\n              <Plus className=\"w-4 h-4\" /> Add New Truck\n            </>\n          )}\n        </button>\n      </div>\n\n      {showAddForm && (\n        <form id=\"truck-form\" onSubmit={handleSubmit} className=\"mb-8 p-5 bg-slate-950 rounded-xl border border-slate-800/80 animate-fade-in\">\n          <h3 className=\"text-sm font-semibold text-indigo-400 uppercase tracking-wider mb-4\">\n            {isEditing ? \'Modify Truck Information\' : \'Register New Truck\'}\n          </h3>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4\">\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Truck Number <span className=\"text-red-500\">*</span></label>\n              <input\n                id=\"input-truck-no\"\n                type=\"text\"\n                placeholder=\"e.g. MH-12-PQ-4532\"\n                value={truckNo}\n                onChange={(e) => setTruckNo(e.target.value)}\n                required\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 uppercase font-mono placeholder:lowercase\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Owner Name</label>\n              <input\n                id=\"input-owner-name\"\n                type=\"text\"\n                placeholder=\"Owner full name\"\n                value={ownerName}\n                onChange={(e) => setOwnerName(e.target.value)}\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Driver Name</label>\n              <input\n                id=\"input-driver-name\"\n                type=\"text\"\n                placeholder=\"Primary Driver\"\n                value={driverName}\n                onChange={(e) => setDriverName(e.target.value)}\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Driver Phone</label>\n              <input\n                id=\"input-driver-phone\"\n                type=\"tel\"\n                placeholder=\"10-digit mobile\"\n                value={phone}\n                onChange={(e) => setPhone(e.target.value)}\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Fleet Status</label>\n              <select