  file_change {
    absolute_path_uri: "file:///src/components/TruckMaster.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Truck } from \'../types\';\nimport { Plus, Edit2, Trash2, Shield, Phone, User, CheckCircle, XCircle } from \'lucide-react\';\n\ninterface TruckMasterProps {\n  trucks: Truck[];\n  onAddTruck: (truck: Omit<Truck, \'id\'>) => void;\n  onUpdateTruck: (truck: Truck) => void;\n  onDeleteTruck: (id: string) => void;\n}\n\nexport default function TruckMaster({ trucks, onAddTruck, onUpdateTruck, onDeleteTruck }: TruckMasterProps) {\n  const [isEditing, setIsEditing] = useState<string | null>(null);\n  const [showAddForm, setShowAddForm] = useState(false);\n  \n  // Form States\n  const [truckNo, setTruckNo] = useState(\'\');\n  const [ownerName, setOwnerName] = useState(\'\');\n  const [driverName, setDriverName] = useState(\'\');\n  const [phone, setPhone] = useState(\'\');\n  const [status, setStatus] = useState<\'Active\' | \'Inactive\'>(\'Active\');\n\n  const resetForm = () => {\n    setTruckNo(\'\');\n    setOwnerName(\'\');\n    setDriverName(\'\');\n    setPhone(\'\');\n    setStatus(\'Active\');\n    setIsEditing(null);\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!truckNo.trim()) return;\n\n    if (isEditing) {\n      onUpdateTruck({\n        id: isEditing,\n        truckNo: truckNo.toUpperCase(),\n        ownerName,\n        driverName,\n        phone,\n        status\n      });\n    } else {\n      onAddTruck({\n        truckNo: truckNo.toUpperCase(),\n        ownerName,\n        driverName,\n        phone,\n        status\n      });\n    }\n    resetForm();\n    setShowAddForm(false);\n  };\n\n  const startEdit = (truck: Truck) => {\n    setIsEditing(truck.id);\n    setTruckNo(truck.truckNo);\n    setOwnerName(truck.ownerName || \'\');\n    setDriverName(truck.driverName || \'\');\n    setPhone(truck.phone || \'\');\n    setStatus(truck.status);\n    setShowAddForm(true);\n  };\n\n  return (\n    <div id=\"truck-master-panel\" className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl\">\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white tracking-tight\">Truck Datasheet</h2>\n          <p className=\"text-sm text-slate-400 mt-1\">Manage the fleet list. Only active trucks will appear in trip reports.</p>\n        </div>\n        <button\n          id=\"btn-add-truck\"\n          onClick={() => {\n            resetForm();\n            setShowAddForm(!showAddForm);\n          }}\n          className=\"flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-4 py-2.5 rounded-xl transition duration-150 shadow-lg shadow-indigo-600/20 text-sm\"\n        >\n          {showAddForm ? \'Close Form\' : (\n            <>\n              <Plus className=\"w-4 h-4\" /> Add New Truck\n            </>\n          )}\n        </button>\n      </div>\n\n      {showAddForm && (\n        <form id=\"truck-form\" onSubmit={handleSubmit} className=\"mb-8 p-5 bg-slate-950 rounded-xl border border-slate-800/80 animate-fade-in\">\n          <h3 className=\"text-sm font-semibold text-indigo-400 uppercase tracking-wider mb-4\">\n            {isEditing ? \'Modify Truck Information\' : \'Register New Truck\'}\n          </h3>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4\">\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Truck Number <span className=\"text-red-500\">*</span></label>\n              <input\n                id=\"input-truck-no\"\n                type=\"text\"\n                placeholder=\"e.g. MH-12-PQ-4532\"\n                value={truckNo}\n                onChange={(e) => setTruckNo(e.target.value)}\n                required\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500 uppercase font-mono placeholder:lowercase\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Owner Name</label>\n              <input\n                id=\"input-owner-name\"\n                type=\"text\"\n                placeholder=\"Owner full name\"\n                value={ownerName}\n                onChange={(e) => setOwnerName(e.target.value)}\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Driver Name</label>\n              <input\n                id=\"input-driver-name\"\n                type=\"text\"\n                placeholder=\"Primary Driver\"\n                value={driverName}\n                onChange={(e) => setDriverName(e.target.value)}\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Driver Phone</label>\n              <input\n                id=\"input-driver-phone\"\n                type=\"tel\"\n                placeholder=\"10-digit mobile\"\n                value={phone}\n                onChange={(e) => setPhone(e.target.value)}\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Fleet Status</label>\n              <select\n                id=\"select-truck-status\"\n                value={status}\n                onChange={(e) => setStatus(e.target.value as \'Active\' | \'Inactive\')}\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"Active\">Operational (Active)</option>\n                <option value=\"Inactive\">Under Maintenance (Inactive)</option>\n              </select>\n            </div>\n          </div>\n          <div className=\"flex justify-end gap-3 mt-4 pt-3 border-t border-slate-800/50\">\n            <button\n              type=\"button\"\n              onClick={resetForm}\n              className=\"px-4 py-2 text-xs font-medium text-slate-400 hover:text-white\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs px-4 py-2 rounded-lg transition\"\n            >\n              {isEditing ? \'Update Truck\' : \'Add Truck\'}\n            </button>\n          </div>\n        </form>\n      )}\n\n      <div className=\"overflow-x-auto\">\n        <table id=\"trucks-table\" className=\"w-full text-left text-sm text-slate-300\">\n          <thead className=\"text-xs text-slate-400 uppercase bg-slate-950/60 border-y border-slate-800\">\n            <tr>\n              <th className=\"px-4 py-3\">Truck Number</th>\n              <th className=\"px-4 py-3\">Owner Details</th>\n              <th className=\"px-4 py-3\">Driver Details</th>\n              <th className=\"px-4 py-3\">Contact</th>\n              <th className=\"px-4 py-3 text-center\">Status</th>\n              <th className=\"px-4 py-3 text-right\">Actions</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-800\">\n            {trucks.length === 0 ? (\n              <tr>\n                <td colSpan={6} className=\"text-center py-8 text-slate-500 font-medium\">No trucks found. Add your first truck using the button above.</td>\n              </tr>\n            ) : (\n              trucks.map((truck) => (\n                <tr key={truck.id} id={`row-truck-${truck.id}`} className=\"hover:bg-slate-800/40 transition\">\n                  <td className=\"px-4 py-3.5 font-mono font-semibold text-white tracking-widest\">\n                    <span className=\"flex items-center gap-2\">\n                      <Shield className=\"w-3.5 h-3.5 text-indigo-400\" />\n                      {truck.truckNo}\n                    </span>\n                  </td>\n                  <td className=\"px-4 py-3.5 font-medium text-slate-200\">\n                    {truck.ownerName || <span className=\"text-slate-600 italic text-xs\">&mdash;</span>}\n                  </td>\n                  <td className=\"px-4 py-3.5 text-slate-300 font-medium\">\n                    {truck.driverName ? (\n                      <span className=\"flex items-center gap-1.5\">\n                        <User className=\"w-3.5 h-3.5 text-slate-500\" />\n                        {truck.driverName}\n                      </span>\n                    ) : (\n                      <span className=\"text-slate-600 italic text-xs\">&mdash;</span>\n                    )}\n                  </td>\n                  <td className=\"px-4 py-3.5 font-mono text-xs text-slate-400\">\n                    {truck.phone ? (\n                      <span className=\"flex items-center gap-1.5\">\n                        <Phone className=\"w-3 h-3 text-slate-500\" />\n                        {truck.phone}\n                      </span>\n                    ) : (\n                      <span className=\"text-slate-600 italic text-xs\">&mdash;</span>\n                    )}\n                  </td>\n                  <td className=\"px-4 py-3.5 text-center\">\n                    <span className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold ${\n                      truck.status === \'Active\' \n                        ? \'bg-transparent border border-emerald-500/30 text-emerald-400\' \n                        : \'bg-transparent border border-rose-500/30 text-rose-400\'\n                    }`}>\n                      {truck.status === \'Active\' ? (\n                        <>\n                          <CheckCircle className=\"w-3 h-3 text-emerald-400\" />\n                          Active\n                        </>\n                      ) : (\n                        <>\n                          <XCircle className=\"w-3 h-3 text-rose-400\" />\n                          Inactive\n                        </>\n                      )}\n                    </span>\n                  </td>\n                  <td className=\"px-4 py-3.5 text-right font-medium\">\n                    <div className=\"flex justify-end gap-2\">\n                      <button\n                        title=\"Edit Truck\"\n                        onClick={() => startEdit(truck)}\n                        className=\"p-1 px-2.5 bg-slate-800 text-slate-300 hover:text-white rounded-lg hover:bg-slate-750 transition\"\n                      >\n                        <Edit2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                      <button\n                        title=\"Delete Truck\"\n                        onClick={() => {\n                          if (confirm(`Are you sure you want to delete Truck ${truck.truckNo}?`)) {\n                            onDeleteTruck(truck.id);\n                          }\n                        }}\n                        className=\"p-1 px-2.5 bg-slate-800 text-rose-400 hover:text-rose-300 rounded-lg hover:bg-rose-950/20 transition\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </td>\n                </tr>\n              ))\n            )}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  );\n}\n"
    }
