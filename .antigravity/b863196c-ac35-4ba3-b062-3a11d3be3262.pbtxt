        lines {
          text: "              <div className=\"bg-white border border-slate-200 rounded-xl overflow-hidden divide-y divide-slate-150 font-sans shadow-3xs text-xs max-h-[220px] overflow-y-auto\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                <table className=\"w-full text-left\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                  <thead className=\"bg-slate-50 text-[10px] text-slate-500 uppercase font-bold text-slate-505 tracking-wider\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    <tr>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <th className=\"p-2.5 pl-4\">#</th>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <th className=\"p-2.5\">Date Received</th>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <th className=\"p-2.5\">Ledger Account</th>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <th className=\"p-2.5 text-right\">Amount (\342\202\271)</th>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
