      target_content: "              </div>\n            </div>\n          </div>"
      replacement_content: "              </div>\n            </div>\n\n            {/* OVERLAND COMMON TRIP EXPENDITURES BLOCK */}\n            <div className=\"bg-blue-50/50 border border-blue-100 rounded-xl p-4 space-y-4 shadow-3xs border-blue-200 font-sans\">\n              <span className=\"text-[10px] font-bold text-blue-700 uppercase tracking-widest block border-b border-blue-105 pb-1.5 flex items-center gap-1.5\">\n                <Fuel className=\"w-3.5 h-3.5 text-blue-600\" />\n                Trip Overland Common Expenses (Diesel Fuel, RTO Permits, AdBlue, Fastag Tolls, Misc)\n              </span>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4 items-end\">\n                {/* DIESEL fuel calculations */}\n                <div className=\"md:col-span-2 grid grid-cols-3 gap-2 bg-amber-50 border border-amber-200 rounded-lg p-2.5\">\n                  <div>\n                    <label className=\"block text-[9px] text-amber-800 font-bold uppercase mb-1\">Fuel Liters</label>\n                    <input\n                      id=\"input-common-dieselLiters\"\n                      type=\"number\"\n                      min=\"0\"\n                      step=\"any\"\n                      value={dieselLiters || \'\'}\n                      onChange={(e) => setDieselLiters(parseFloat(e.target.value) || 0)}\n                      placeholder=\"Liters\"\n                      className=\"w-full bg-white border border-amber-250 text-slate-800 rounded-lg px-2 py-1 text-xs text-right font-mono font-bold\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-[9px] text-amber-800 font-bold uppercase mb-1\">Rate / Liter</label>\n                    <input\n                      id=\"input-common-dieselRate\"\n                      type=\"number\"\n                      min=\"0\"\n                      step=\"any\"\n                      value={dieselRate || \'\'}\n                      onChange={(e) => setDieselRate(parseFloat(e.target.value) || 0)}\n                      placeholder=\"Rate\"\n                      className=\"w-full bg-white border border-amber-250 text-slate-800 rounded-lg px-2 py-1 text-xs text-right font-mono font-bold\"\n                    />\n                  </div>\n                  <div>\n                    <label className=\"block text-[9px] text-amber-800 font-bold uppercase mb-1\">Diesel Amount</label>\n                    <div className=\"w-full px-2 py-1 text-xs font-black font-mono text-amber-900 border border-transparent text-right leading-none self-center truncate\">\n                      \342\202\271{dieselAmount.toLocaleString()}\n                    </div>\n                  </div>\n                </div>\n\n                {/* RTO Expense */}\n                <div>\n                  <label className=\"block text-[10px] text-slate-550 font-bold uppercase mb-1 flex items-center gap-1\">\342\202\271 RTO Permits Expense</label>\n                  <input\n                    id=\"input-common-rtoExpense\"\n                    type=\"number\"\n                    min=\"0\"\n                    value={rtoExpense || \'\'}\n                    onChange={(e) => setRtoExpense(parseFloat(e.target.value) || 0)}\n                    placeholder=\"0\"\n                    className=\"w-full bg-white border border-slate-205 text-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-right font-mono\"\n                  />\n                </div>\n\n                {/* AdBlue Cost */}\n                <div>\n                  <label className=\"block text-[10px] text-slate-550 font-bold uppercase mb-1\">\342\202\271 AdBlue Cost</label>\n                  <input\n                    id=\"input-common-addBlueExpense\"\n                    type=\"number\"\n                    min=\"0\"\n                    value={addBlueExpense || \'\'}\n                    onChange={(e) => setAddBlueExpense(parseFloat(e.target.value) || 0)}\n                    placeholder=\"0\"\n                    className=\"w-full bg-white border border-slate-205 text-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-right font-mono\"\n                  />\n                </div>\n              </div>\n\n              <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4 pt-1\">\n                {/* Fastag tolls */}\n                <div>\n                  <label className=\"block text-[10px] text-slate-550 font-bold uppercase mb-1\">\342\202\271 Fastag Toll Charges</label>\n                  <input\n                    id=\"input-common-fastagExpense\"\n                    type=\"number\"\n                    min=\"0\"\n                    value={fastagExpense || \'\'}\n                    onChange={(e) => setFastagExpense(parseFloat(e.target.value) || 0)}\n                    placeholder=\"0\"\n                    className=\"w-full bg-white border border-slate-205 text-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-right font-mono\"\n                  />\n                </div>\n\n                {/* Other/Misc Overland */}\n                <div>\n                  <label className=\"block text-[10px] text-slate-550 font-bold uppercase mb-1\">\342\202\271 Miscellaneous Other</label>\n                  <input\n                    id=\"input-common-otherExpense\"\n                    type=\"number\"\n                    min=\"0\"\n                    value={otherExpense || \'\'}\n                    onChange={(e) => setOtherExpense(parseFloat(e.target.value) || 0)}\n                    placeholder=\"0\"\n                    className=\"w-full bg-white border border-slate-205 text-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-right font-mono\"\n                  />\n                </div>\n              </div>\n            </div>\n          </div>"
