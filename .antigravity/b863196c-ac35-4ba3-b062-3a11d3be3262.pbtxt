eet Status</label>\n              <select\n                id=\"select-truck-status\"\n                value={status}\n                onChange={(e) => setStatus(e.target.value as \'Active\' | \'Inactive\')}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-blue-500 font-medium\"\n              >\n                <option value=\"Active\">Operational (Active)</option>\n                <option value=\"Inactive\">Under Maintenance (Inactive)</option>\n              </select>\n            </div>\n          </div>\n          <div className=\"flex justify-end gap-3 mt-4 pt-3 border-t border-slate-200\">\n            <button\n              type=\"button\"\n              onClick={resetForm}\n              className=\"px-4 py-2 text-xs font-bold text-slate-500 hover:text-slate-805 cursor-pointer\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"bg-blue-650 hover:bg-blue-700 text-white font-semibold text-xs px-4 py-2 rounded-lg transition shadow-2xs cursor-pointer\"\n            >\n              {isEditing ? \'Update Truck\' : \'Add Truck\'}\n            </button>\n          </div>\n        </form>\n      )}\n\n      <div className=\"overflow-x-auto border border-slate-200 rounded-lg\">\n        <table id=\"trucks-table\" className=\"w-full text-left text-sm text-slate-700\">\n          <thead className=\"text-xs text-slate-500 uppercase bg-slate-50 border-b border-slate-200 font-bold tracking-wider\">\n            <tr>\n              <th className=\"px-4 py-3.5 pl-6\">Truck Number</th>\n              <th className=\"px-4 py-3.5\">Owner Details</th>\n              <th className=\"px-4 py-3.5\">Driver Details</th>\n              <th className=\"px-4 py-3.5\">Contact</th>\n              <th className=\"px-4 py-3.5 text-center\">Status</th>\n              <th className=\"px-4 py-3.5 text-right 