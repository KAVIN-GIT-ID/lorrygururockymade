  file_change {
    absolute_path_uri: "file:///src/components/TripForm.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { TripEntry, TripPayment, Truck, Office, Account, TripStatus, calculateBalance } from \'../types\';\nimport { X, Calculator, Calendar, Landmark, Coins } from \'lucide-react\';\n\ninterface TripFormProps {\n  isOpen: boolean;\n  onClose: () => void;\n  trucks: Truck[];\n  offices: Office[];\n  accounts: Account[];\n  existingTripNos: string[];\n  onSubmit: (entry: Omit<TripEntry, \'id\' | \'balance\'>) => void;\n  editingEntry?: TripEntry | null;\n}\n\nexport default function TripForm({\n  isOpen,\n  onClose,\n  trucks,\n  offices,\n  accounts,\n  existingTripNos,\n  onSubmit,\n  editingEntry\n}: TripFormProps) {\n  // Trip No Option\n  const [tripNoOption, setTripNoOption] = useState<\'AUTO\' | \'EXISTING\'>(\'AUTO\');\n  \n  // Form values\n  const [tripNo, setTripNo] = useState(\'\');\n  const [selectedExistingTripNo, setSelectedExistingTripNo] = useState(\'\');\n  const [truckNo, setTruckNo] = useState(\'\');\n  const [officeName, setOfficeName] = useState(\'\');\n  const [rental, setRental] = useState<number>(0);\n  const [loadingDate, setLoadingDate] = useState(() => new Date().toISOString().substring(0, 10));\n  const [commission, setCommission] = useState<number>(0);\n  const [loadingUnloading, setLoadingUnloading] = useState<number>(0);\n  const [officeMamul, setOfficeMamul] = useState<number>(0);\n  \n  // Dynamic payments list state\n  const [payments, setPayments] = useState<TripPayment[]>([]);\n\n  // Input states for registering a new payment draft\n  const [newPayAmount, setNewPayAmount] = useState<number | \'\'>(\'\');\n  const [newPayDate, setNewPayDate] = useState(() => new Date().toISOString().substring(0, 10));\n  const [newPayReceivedBy, setNewPayReceivedBy] = useState(\'\');\n  const [newPayNotes, setNewPayNotes] = useState(\'\');\n\n  const [status, setStatus] = useState<TripStatus>(\'Pending\');\n  const [notes, setNotes] = useState(\'\');\n\n  // Auto-generate trip code on mount/active if not editing\n  useEffect(() => {\n    if (!editingEntry) {\n      const currentYear = new Date().getFullYear();\n      let lastSeq = 0;\n      \n      existingTripNos.forEach(v => {\n        const match = v.match(/TRIP-(\\d+)-(\\d+)/);\n        if (match && parseInt(match[1]) === currentYear) {\n          const seq = parseInt(match[2]);\n          if (seq > lastSeq) lastSeq = seq;\n        }\n      });\n      \n      const newSeq = String(lastSeq + 1).padStart(4, \'0\');\n      const generated = `TRIP-${currentYear}-${newSeq}`;\n      setTripNo(generated);\n      setSelectedExistingTripNo(existingTripNos[0] || \'\');\n    }\n  }, [isOpen, editingEntry, existingTripNos]);\n\n  // Handle Editing Load state or Resets\n  useEffect(() => {\n    if (editingEntry) {\n      setTripNoOption(\'AUTO\'); \n      setTripNo(editingEntry.tripNo);\n      setTruckNo(editingEntry.truckNo);\n      setOfficeName(editingEntry.officeName);\n      setRental(editingEntry.rental);\n      setLoadingDate(editingEntry.loadingDate);\n      setCommission(editingEntry.commission);\n      setLoadingUnloading(editingEntry.loadingUnloading);\n      setOfficeMamul(editingEntry.officeMamul);\n      \n      setPayments(editingEntry.payments || []);\n      setStatus(editingEntry.status);\n      setNotes(editingEntry.notes || \'\');\n\n      setNewPayAmount(\'\');\n      setNewPayDate(editingEntry.loadingDate || new Date().toISOString().substring(0, 10));\n      setNewPayReceivedBy(accounts.length > 0 ? accounts[0].id : \'\');\n      setNewPayNotes(\'\');\n    } else {\n      setTruckNo(trucks[0]?.truckNo || \'\');\n      setOfficeName(offices[0]?.officeName || \'\');\n      setRental(0);\n      setLoadingDate(new Date().toISOString().substring(0, 10));\n      setCommission(0);\n      setLoadingUnloading(0);\n      setOfficeMamul(0);\n      \n      setPayments([]);\n      setStatus(\'Pending\');\n      setNotes(\'\');\n\n      setNewPayAmount(\'\');\n      setNewPayDate(new Date().toISOString().substring(0, 10));\n      setNewPayReceivedBy(accounts.length > 0 ? accounts[0].id : \'\');\n      setNewPayNotes(\'\');\n    }\n  }, [editingEntry, isOpen, trucks, offices, accounts]);\n\n  // Sync new pay received default accounts\n  useEffect(() => {\n    if (!newPayReceivedBy && accounts.length > 0) {\n      setNewPayReceivedBy(accounts[0].id);\n    }\n  }, [accounts, newPayReceivedBy]);\n\n  // Sync payment draft date with Loading date if unchanged\n  useEffect(() => {\n    if (loadingDate) {\n      setNewPayDate(loadingDate);\n    }\n  }, [loadingDate]);\n\n  // Live Calculations\n  const calculatedLiveBalance = calculateBalance({\n    rental,\n    commission,\n    loadingUnloading,\n    officeMamul,\n    payments\n  });\n\n  // Auto transition status based on balance clearing\n  useEffect(() => {\n    if (editingEntry) return; \n    \n    if (calculatedLiveBalance <= 0 && rental > 0) {\n      setStatus(\'Paid\');\n    } else if (payments.length > 0) {\n      setStatus(\'In Progress\');\n    } else {\n      setStatus(\'Pending\');\n    }\n  }, [calculatedLiveBalance, rental, payments, editingEntry]);\n\n  // Helper functions for dynamic payments array inside modal form\n  const handleAddPayment = () => {\n    const amt = Number(newPayAmount) || 0;\n    if (amt <= 0) {\n      alert(\"Please enter a valid payment amount greater than 0.\");\n      return;\n    }\n    if (!newPayReceivedBy) {\n      alert(\"Please select an active Account Ledger for this receipt.\");\n      return;\n    }\n    \n    const newPayment: TripPayment = {\n      id: \'pay_\' + Date.now() + \'_\' + Math.random().toString(36).substring(2, 6),\n      amount: amt,\n      date: newPayDate || new Date().toISOString().substring(0, 10),\n      receivedBy: newPayReceivedBy,\n      notes: newPayNotes.trim() || undefined\n    };\n\n    setPayments(prev => [...prev, newPayment]);\n    setNewPayAmount(\'\');\n    setNewPayNotes(\'\');\n  };\n\n  const handleRemovePayment = (id: string) => {\n    setPayments(prev => prev.filter(p => p.id !== id));\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    \n    const finalTripNo = editingEntry \n      ? tripNo \n      : (tripNoOption === \'AUTO\' ? tripNo : selectedExistingTripNo);\n\n    if (!finalTripNo || !truckNo || !officeName) {\n      alert(\"Please ensure Trip No, Truck No and Office Name are fully selected.\");\n      return;\n    }\n\n    onSubmit({\n      tripNo: finalTripNo,\n      truckNo,\n      officeName,\n      rental: Number(rental) || 0,\n      loadingDate,\n      commission: Number(commission) || 0,\n      loadingUnloading: Number(loadingUnloading) || 0,\n      officeMamul: Number(officeMamul) || 0,\n      payments,\n      status,\n      notes\n    });\n\n    onClose();\n  };\n\n  if (!isOpen) return null;\n\n  const activeTrucks = trucks.filter(t => t.status === \'Active\');\n  const activeOffices = offices.filter(o => o.status === \'Active\');\n  const activeAccounts = accounts.filter(a => a.status === \'Active\');\n\n  return (\n    <div id=\"trip-modal-overlay\" className=\"fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 overflow-y-auto\">\n      <div id=\"trip-modal-container\" className=\"bg-white border border-slate-200 rounded-xl w-full max-w-4xl shadow-xl overflow-hidden my-8 animate-scale-up\">\n        \n        {/* Header */}\n        <div className=\"px-6 py-4 bg-slate-50 border-b border-slate-200 flex justify-between items-center\">\n          <div>\n            <h3 className=\"text-lg font-bold text-slate-800 flex items-center gap-2\">\n              <Coins className=\"w-5 h-5 text-blue-650\" />\n              {editingEntry ? `Edit Log Reference ID: ${editingEntry.tripNo}` : \'Record New Transport Trip Segment\'}\n            </h3>\n            <p className=\"text-xs text-slate-500\">Specify details down below. Add dynamic payments/advances list as they occur.</p>\n          </div>\n          <button\n            id=\"btn-close-modal\"\n            onClick={onClose}\n            className=\"p-1 px-2 text-slate-400 hover:text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition shrink-0 cursor-pointer\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Action Panel / Form */}\n        <form id=\"trip-entry-form\" onSubmit={handleSubmit} className=\"p-6 overflow-y-auto max-h-[75vh] space-y-6\">\n          \n          {/* TRIP ASSIGNMENT SECTOR */}\n          {!editingEntry && (\n            <div className=\"bg-slate-50 p-4 rounded-lg border border-slate-200 grid grid-cols-1 md:grid-cols-3 gap-4 items-center\">\n              <div>\n                <span className=\"block text-xs font-bold uppercase tracking-wider text-slate-700\">Trip Joint Management</span>\n                <span className=\"text-[11px] text-slate-500 block leading-tight mt-1\">Combine multiple cargos into a unified trip index number.</span>\n              </div>\n              <div className=\"flex bg-slate-200/55 rounded-lg p-1 gap-1 h-10 col-span-2\">\n                <button\n                  id=\"tab-trip-auto\"\n                  type=\"button\"\n                  onClick={() => setTripNoOption(\'AUTO\')}\n                  className={`flex-1 rounded px-3 text-xs font-bold transition duration-150 cursor-pointer ${\n                    tripNoOption === \'AUTO\' \n                      ? \'bg-white text-slate-800 shadow-3xs\' \n                      : \'text-slate-550 hover:text-slate-800\'\n                  }`}\n                >\n                  Auto-Generate New ID\n                </button>\n                <button\n                  id=\"tab-trip-existing\"\n                  type=\"button\"\n                  disabled={existingTripNos.length === 0}\n                  onClick={() => setTripNoOption(\'EXISTING\')}\n                  className={`flex-1 rounded px-3 text-xs font-bold transition duration-150 disabled:opacity-40 disabled:hover:bg-transparent cursor-pointer ${\n                    tripNoOption === \'EXISTING\' \n                      ? \'bg-white text-slate-800 shadow-3xs\' \n                      : \'text-slate-550 hover:text-slate-800\'\n                  }`}\n                >\n                  Join Existing Trip ({existingTripNos.length})\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* BASIC TRUCK, OFFICE & LOAD SPECS */}\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-5\">\n            {/* TRIP NO DISPLAY / CHOOSE */}\n            <div>\n              <label className=\"block text-xs font-bold text-slate-600 mb-1.5 flex items-center gap-1.5\">\n                Trip Number <span className=\"text-red-500\">*</span>\n              </label>\n              {editingEntry ? (\n                <input\n                  id=\"form-trip-no-disabled\"\n                  type=\"text\"\n                  disabled\n                  value={tripNo}\n                  className=\"w-full bg-slate-100 border border-slate-200 text-slate-550 font-mono font-bold tracking-wider rounded-lg px-3 py-2 text-sm\"\n                />\n              ) : tripNoOption === \'AUTO\' ? (\n                <div className=\"relative\">\n                  <input\n                    id=\"form-trip-no-auto\"\n                    type=\"text\"\n                    required\n                    value={tripNo}\n                    onChange={(e) => setTripNo(e.target.value.toUpperCase())}\n                    className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 font-mono font-bold tracking-wider rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:bg-white\"\n                  />\n                  <span className=\"absolute bottom-1.5 right-2 text-[9px] text-slate-400 bg-slate-100 border border-slate-200 rounded px-1 font-bold\">PREVIEW</span>\n                </div>\n              ) : (\n                <select\n                  id=\"form-trip-no-existing-select\"\n                  value={selectedExistingTripNo}\n                  onChange={(e) => setSelectedExistingTripNo(e.target.value)}\n                  required\n                  className=\"w-full bg-slate-50 border border-slate-200 text-blue-700 font-mono font-bold tracking-wider rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-blue-500 focus:bg-white\"\n                >\n                  {existingTripNos.map(no => (\n                    <option key={no} value={no}>{no}</option>\n                  ))}\n                </select>\n              )}\n            </div>\n\n            {/* TRUCK SELECT */}\n            <div>\n              <label className=\"block text-xs font-bold text-slate-600 mb-1.5\">\n                Truck Number <span className=\"text-red-500\">*</span>\n              </label>\n              <select\n                id=\"form-truck-select\"\n                value={truckNo}\n                onChange={(e) => setTruckNo(e.target.value)}\n                required\n                className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 font-mono font-semibold rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-blue-500 focus:bg-white\"\n              >\n                <option value=\"\">&mdash; Choose Active Truck &mdash;</option>\n                {activeTrucks.map(truck => (\n                  <option key={truck.id} value={truck.truckNo}>{truck.truckNo} ({truck.ownerName || \'Self\'})</option>\n                ))}\n              </select>\n              {activeTrucks.length === 0 && (\n                <span className=\"text-[10px] text-amber-600 mt-1 block\">\342\232\240\357\270\217 No operational trucks. Registry is empty.</span>\n              )}\n            </div>\n\n            {/* OFFICE SELECT */}\n            <div>\n              <label className=\"block text-xs font-bold text-slate-600 mb-1.5\">\n                Loading Office <span className=\"text-red-500\">*</span>\n              </label>\n              <select\n                id=\"form-office-select\"\n                value={officeName}\n                onChange={(e) => setOfficeName(e.target.value)}\n                required\n                className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 font-medium rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-blue-500 focus:bg-white\"\n              >\n                <option value=\"\">&mdash; Choose Active Office &mdash;</option>\n                {activeOffices.map(off => (\n                  <option key={off.id} value={off.officeName}>{off.officeName}</option>\n                ))}\n              </select>\n              {activeOffices.length === 0 && (\n                <span className=\"text-[10px] text-amber-600 mt-1 block\">\342\232\240\357\270\217 No active offices configuration found.</span>\n              )}\n            </div>\n          </div>\n\n          {/* DATES & EXPENSES GRID */}\n          <div className=\"bg-slate-50 border border-slate-200 rounded-lg p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4\">\n            <div>\n              <label className=\"block text-[11px] font-bold text-slate-600 mb-1\">Loading Date</label>\n              <div className=\"relative\">\n                <Calendar className=\"absolute left-2.5 top-2.5 w-4 h-4 text-slate-400\" />\n                <input\n                  id=\"form-loading-date\"\n                  type=\"date\"\n                  required\n                  value={loadingDate}\n                  onChange={(e) => setLoadingDate(e.target.value)}\n                  className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg pl-9 pr-2 py-1.5 text-sm focus:outline-none focus:border-blue-500\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-bold text-slate-600 mb-1\">Rental (\342\202\271 Contract Amount)</label>\n              <input\n                id=\"form-rental\"\n                type=\"number\"\n                min=\"0\"\n                value={rental || \'\'}\n                onChange={(e) => setRental(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono font-semibold focus:border-blue-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-bold text-slate-600 mb-1\">Commission (\342\202\271)</label>\n              <input\n                id=\"form-commission\"\n                type=\"number\"\n                min=\"0\"\n                value={commission || \'\'}\n                onChange={(e) => setCommission(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono focus:border-blue-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-bold text-slate-600 mb-1\">Loading / Unloading (\342\202\271)</label>\n              <input\n                id=\"form-loading-unloading\"\n                type=\"number\"\n                min=\"0\"\n                value={loadingUnloading || \'\'}\n                onChange={(e) => setLoadingUnloading(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono focus:border-blue-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-bold text-slate-600 mb-1\">Office Mamul (\342\202\271 tips)</label>\n              <input\n                id=\"form-office-mamul\"\n                type=\"number\"\n                min=\"0\"\n                value={officeMamul || \'\'}\n                onChange={(e) => setOfficeMamul(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono focus:border-blue-500\"\n              />\n            </div>\n          </div>\n\n          {/* PAYMENTS RECORD SYSTEM */}\n          <div className=\"border border-slate-200 rounded-xl p-5 bg-slate-50/50 space-y-4\">\n            <div className=\"flex justify-between items-center border-b border-slate-200 pb-2\">\n              <h4 className=\"text-sm font-bold text-slate-800 flex items-center gap-2\">\n                <Landmark className=\"w-4 h-4 text-blue-650\" />\n                Payments & Advances Register ({payments.length} Registered)\n              </h4>\n              <span className=\"text-xs text-slate-500 font-medium font-sans\">Arbitrary / N Number of Receipts</span>\n            </div>\n\n            {/* List of current payments */}\n            {payments.length > 0 ? (\n              <div className=\"bg-white border border-slate-200 rounded-lg overflow-hidden divide-y divide-slate-100 shadow-3xs max-h-[170px] overflow-y-auto\">\n                <table className=\"w-full text-xs text-slate-700 text-left font-sans\">\n                  <thead className=\"bg-slate-50 text-[10px] text-slate-500 uppercase font-bold tracking-wider\">\n                    <tr>\n                      <th className=\"p-2.5 pl-4\">#</th>\n                      <th className=\"p-2.5\">Date</th>\n                      <th className=\"p-2.5\">Account Ledger</th>\n                      <th className=\"p-2.5\">Amount (\342\202\271)</th>\n                      <th className=\"p-2.5\">Remarks / Notes</th>\n                      <th className=\"p-2.5 text-right pr-4\">Action</th>\n                    </tr>\n                  </thead>\n                  <tbody className=\"divide-y divide-slate-100 font-medium\">\n                    {payments.map((p, index) => {\n                      const accObj = accounts.find(a => a.id === p.receivedBy);\n                      return (\n                        <tr key={p.id} className=\"hover:bg-slate-50/80 transition\">\n                          <td className=\"p-2.5 pl-4 font-bold text-slate-400\">{index + 1}</td>\n                          <td className=\"p-2.5 font-mono text-slate-650\">{p.date}</td>\n                          <td className=\"p-2.5 text-blue-650 font-bold\">{accObj?.accountName || p.receivedBy}</td>\n                          <td className=\"p-2.5 font-bold font-mono text-slate-900\">\342\202\271{p.amount.toLocaleString(\'en-IN\')}</td>\n                          <td className=\"p-2.5 text-slate-500 max-w-[150px] truncate\" title={p.notes}>{p.notes || <span className=\"text-slate-300\">&mdash;</span>}</td>\n                          <td className=\"p-2.5 text-right pr-4\">\n                            <button\n                              type=\"button\"\n                              onClick={() => handleRemovePayment(p.id)}\n                              className=\"text-rose-650 hover:text-rose-800 font-bold hover:underline cursor-pointer transition text-[11px]\"\n                            >\n                              Delete\n                            </button>\n                          </td>\n                        </tr>\n                      );\n                    })}\n                  </tbody>\n                </table>\n              </div>\n            ) : (\n              <p className=\"text-center bg-white border border-slate-150 py-6 text-xs text-slate-400 italic rounded-lg\">No payments recorded yet. Fill the quick registry line below to add a payment.</p>\n            )}\n\n            {/* Form line to add payment */}\n            <div className=\"bg-white border border-dashed border-slate-300 rounded-lg p-4 grid grid-cols-1 md:grid-cols-4 gap-3 items-end shadow-3xs\">\n              <div>\n                <label className=\"block text-[10px] text-slate-500 mb-1 flex items-center font-bold uppercase tracking-wider\">Payment Date</label>\n                <input\n                  id=\"form-new-pay-date\"\n                  type=\"date\"\n                  value={newPayDate}\n                  onChange={(e) => setNewPayDate(e.target.value)}\n                  className=\"w-full bg-slate-50 border border-slate-200 text-slate-850 rounded-lg px-2.5 py-1.5 text-xs focus:bg-white focus:outline-none focus:border-blue-500 font-mono\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] text-slate-500 mb-1 flex items-center font-bold uppercase tracking-wider\">Account Ledger</label>\n                <select\n                  id=\"form-new-pay-receivedby\"\n                  value={newPayReceivedBy}\n                  onChange={(e) => setNewPayReceivedBy(e.target.value)}\n                  className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-2 py-1.5 text-xs focus:bg-white focus:outline-none focus:border-blue-500 font-medium\"\n                >\n                  <option value=\"\">-- Select Ledger --</option>\n                  {activeAccounts.map(ac => (\n                    <option key={ac.id} value={ac.id}>{ac.accountName}</option>\n                  ))}\n                </select>\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] text-slate-500 mb-1 flex items-center font-bold uppercase tracking-wider\">Amount (\342\202\271)</label>\n                <input\n                  id=\"form-new-pay-amount\"\n                  type=\"number\"\n                  min=\"1\"\n                  step=\"any\"\n                  value={newPayAmount}\n                  onChange={(e) => setNewPayAmount(e.target.value === \'\' ? \'\' : parseFloat(e.target.value) || 0)}\n                  placeholder=\"\342\202\2710.00\"\n                  className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-2.5 py-1.5 text-xs font-mono text-right focus:bg-white focus:outline-none focus:border-blue-500 font-semibold\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] text-slate-500 mb-1 flex items-center font-bold uppercase tracking-wider\">Purpose / Remarks</label>\n                <div className=\"flex gap-2\">\n                  <input\n                    id=\"form-new-pay-notes\"\n                    type=\"text\"\n                    maxLength={100}\n                    value={newPayNotes}\n                    onChange={(e) => setNewPayNotes(e.target.value)}\n                    placeholder=\"e.g. Fuel Advance, Driver Expense\"\n                    className=\"flex-1 bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-2.5 py-1.5 text-xs focus:bg-white focus:outline-none focus:border-blue-500\"\n                  />\n                  <button\n                    type=\"button\"\n                    onClick={handleAddPayment}\n                    className=\"bg-blue-600 hover:bg-blue-700 text-white text-[11px] font-bold px-3.5 py-1.5 rounded-lg active:scale-95 transition shrink-0 cursor-pointer shadow-3xs\"\n                  >\n                    + Add Payment\n                  </button>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* DYNAMIC CALCULATION BAR & OVERVIEW */}\n          <div className=\"border border-slate-200 rounded-xl bg-slate-50 p-4 md:p-5 flex flex-col md:flex-row justify-between items-start md:items-center gap-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"p-2.5 bg-blue-50 border border-blue-100 rounded-xl text-blue-600 shrink-0\">\n                <Calculator className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <span className=\"text-[10px] uppercase font-bold tracking-wider text-slate-500\">Live Recalculation Engine</span>\n                <div className=\"flex flex-wrap text-xs gap-x-3 text-slate-650 mt-1 font-medium\">\n                  <span>Contract: <strong className=\"text-slate-800 font-mono\">\342\202\271{rental.toLocaleString()}</strong></span>\n                  <span>&bull;</span>\n                  <span>Expenses: <strong className=\"text-slate-700 font-mono\">\342\202\271{(commission + loadingUnloading + officeMamul).toLocaleString()}</strong></span>\n                  <span>&bull;</span>\n                  <span>Payments: <strong className=\"text-blue-700 font-mono\">\342\202\271{payments.reduce((sum, p) => sum + p.amount, 0).toLocaleString()}</strong></span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"bg-slate-900 border border-slate-950 rounded-xl p-3 px-5 text-right flex flex-col justify-center min-w-[200px] shadow-sm font-sans\">\n              <span className=\"text-[10px] text-slate-400 uppercase tracking-wider font-bold\">Outstanding Balance</span>\n              <span className={`text-xl font-extrabold font-mono tracking-tight ${calculatedLiveBalance > 0 ? \'text-amber-400\' : \'text-emerald-400\'}`}>\n                \342\202\271{calculatedLiveBalance.toLocaleString()}\n              </span>\n            </div>\n          </div>\n\n          {/* FINAL SETTLEMENT DETAILS */}\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5 border-t border-slate-150 pt-5\">\n            {/* DYNAMIC TRIP STATUS */}\n            <div>\n              <label className=\"block text-xs font-bold text-slate-600 mb-1.5\">\n                Trip Ledger Status\n              </label>\n              <select\n                id=\"form-status\"\n                value={status}\n                onChange={(e) => setStatus(e.target.value as TripStatus)}\n                className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-3 py-1.5 text-sm font-semibold focus:outline-none focus:border-blue-500 focus:bg-white\"\n              >\n                <option value=\"Pending\" className=\"text-slate-600 font-semibold\">Pending (No Payments)</option>\n                <option value=\"In Progress\" className=\"text-amber-700 font-semibold\">In Progress (Active/Partial Paid)</option>\n                <option value=\"Completed\" className=\"text-blue-700 font-semibold\">Completed (Road/Delivered)</option>\n                <option value=\"Paid\" className=\"text-emerald-700 font-semibold\">Paid (Settled / Zero Out)</option>\n              </select>\n            </div>\n\n            {/* ROUTE REMARKS */}\n            <div>\n              <label className=\"block text-xs font-bold text-slate-600 mb-1.5\">Route Remarks / Consignment Notes</label>\n              <textarea\n                id=\"form-notes\"\n                rows={2}\n                placeholder=\"e.g. Coal consignment loaded at Mumbai port. Driver: Jagdish. Delivered on time.\"\n                value={notes}\n                onChange={(e) => setNotes(e.target.value)}\n                className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500 focus:bg-white placeholder:text-slate-400\"\n              />\n            </div>\n          </div>\n\n          {/* SUBMIT BUTTON ACTIONS */}\n          <div className=\"flex justify-end gap-3 pt-5 border-t border-slate-150\">\n            <button\n              id=\"btn-form-cancel\"\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-5 py-2 text-sm font-bold text-slate-500 hover:text-slate-850 transition cursor-pointer\"\n            >\n              Cancel\n            </button>\n            <button\n              id=\"btn-form-submit\"\n              type=\"submit\"\n              className=\"bg-blue-650 hover:bg-blue-700 text-white font-bold text-xs px-6 py-2.5 rounded-lg shadow-sm transition hover:scale-[1.01] cursor-pointer animate-fade-in\"\n            >\n              {editingEntry ? \'Update Trip Entry\' : \'Post Trip Entries\'}\n            </button>\n          </div>\n\n        </form>\n      </div>\n    </div>\n  );\n}\n"
    }
