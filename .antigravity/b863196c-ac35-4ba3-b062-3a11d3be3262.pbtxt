          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        {currencyFormattedForCol(trip.commission, true)}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      </td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <td className=\"px-4 py-3.5 text-right font-mono text-xs text-slate-500\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
