        }
      }
    }
    instruction: "Redesign TripForm layout, overlays, labels, inputs, selects, calculation panel, and CTA buttons to fit the light theme with a polished professional finish."
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div id=\"trip-modal-overlay\" className=\"fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 overflow-y-auto\">\n      <div id=\"trip-modal-container\" className=\"bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-4xl shadow-2xl overflow-hidden my-8 animate-scale-up\">\n        \n        {/* Header */}\n        <div className=\"px-6 py-4 bg-slate-950/80 border-b border-slate-800 flex justify-between items-center\">\n          <div>\n            <h3 className=\"text-lg font-bold text-white flex items-center gap-2\">\n              <Coins className=\"w-5 h-5 text-indigo-400\" />\n              {editingEntry ? `Edit Log Reference ID: ${editingEntry.tripNo}` : \'Record New Transport Trip Segment\'}\n            </h3>\n            <p className=\"text-xs text-slate-400\">Specify details down below. Trip ledger recalculates live liabilities automatically.</p>\n          </div>\n          <button\n            id=\"btn-close-modal\"\n            onClick={onClose}\n            className=\"p-1 px-2.5 bg-slate-855 hover:bg-slate-800 text-slate-400 hover:text-white rounded-lg transition\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Action Panel / Form */}\n        <form id=\"trip-entry-form\" onSubmit={handleSubmit} className=\"p-6 overflow-y-auto max-h-[80vh] space-y-6\">\n          \n          {/* TRIP ASSIGNMENT SECTOR */}\n          {!editingEntry && (\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-indigo-500/10 grid grid-cols-1 md:grid-cols-3 gap-4 items-center\">\n              <div>\n                <span className=\"block text-xs font-semibold uppercase tracking-wider text-indigo-400\">Trip No Management</span>\n                <span className=\"text-[11px] text-slate-500 block leading-tight mt-1\">Combine multiple cargos into a unified trip index number.</span>\n              </div>\n              <div className=\"flex bg-slate-905 border border-slate-800 rounded-lg p-1 gap-1 h-10 col-span-2\">\n                <button\n                  id=\"tab-trip-auto\"\n                  type=\"button\"\n                  onClick={() => setTripNoOption(\'AUTO\')}\n                  className={`flex-1 rounded px-3 text-xs font-medium transition ${\n                    tripNoOption === \'AUTO\' \n                      ? \'bg-indigo-600 text-white shadow\' \n                      : \'text-slate-400 hover:text-white hover:bg-slate-800\'\n                  }`}\n                >\n                  Auto-Generate New ID\n                </button>\n                <button\n                  id=\"tab-trip-existing\"\n                  type=\"button\"\n                  disabled={existingTripNos.length === 0}\n                  onClick={() => setTripNoOption(\'EXISTING\')}\n                  className={`flex-1 rounded px-3 text-xs font-medium transition disabled:opacity-40 disabled:hover:bg-transparent ${\n                    tripNoOption === \'EXISTING\' \n                      ? \'bg-indigo-600 text-white shadow\' \n                      : \'text-slate-400 hover:text-white hover:bg-slate-800\'\n                  }`}\n                >\n                  Join Existing Trip ({existingTripNos.length})\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* BASIC TRUCK, OFFICE & LOAD SPECS */}\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-5\">\n            {/* TRIP NO DISPLAY / CHOOSE */}\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1.5 flex items-center gap-1.5\">\n                Trip Number <span className=\"text-red-500\">*</span>\n              </label>\n              {editingEntry ? (\n                <input\n                  id=\"form-trip-no-disabled\"\n                  type=\"text\"\n                  disabled\n                  value={tripNo}\n                  className=\"w-full bg-slate-950 border border-slate-800 text-slate-400 font-mono font-bold tracking-widest rounded-lg px-3 py-2 text-sm\"\n                />\n              ) : tripNoOption === \'AUTO\' ? (\n                <div className=\"relative\">\n                  <input\n                    id=\"form-trip-no-auto\"\n                    type=\"text\"\n                    required\n                    value={tripNo}\n                    onChange={(e) => setTripNo(e.target.value.toUpperCase())}\n                    className=\"w-full bg-slate-950 border border-indigo-500/30 text-white font-mono font-bold tracking-widest rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n                  />\n                  <span className=\"absolute bottom-1 right-2 text-[9px] text-slate-500 bg-slate-900 border border-slate-800 rounded px-1\">PREVIEW</span>\n                </div>\n              ) : (\n                <select\n                  id=\"form-trip-no-existing-select\"\n                  value={selectedExistingTripNo}\n                  onChange={(e) => setSelectedExistingTripNo(e.target.value)}\n                  required\n                  className=\"w-full bg-slate-950 border border-indigo-500/30 text-indigo-300 font-mono font-bold tracking-widest rounded-lg px-3 py-2 text-sm focus:outline-none\"\n                >\n                  {existingTripNos.map(no => (\n                    <option key={no} value={no}>{no}</option>\n                  ))}\n                </select>\n              )}\n            </div>\n\n            {/* TRUCK SELECT */}\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1.5\">\n                Truck Number <span className=\"text-red-500\">*</span>\n              </label>\n              <select\n                id=\"form-truck-select\"\n                value={truckNo}\n                onChange={(e) => setTruckNo(e.target.value)}\n                required\n                className=\"w-full bg-slate-950 border border-slate-800 text-white font-mono font-medium rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"\">&mdash; Choose Active Truck &mdash;</option>\n                {activeTrucks.map(truck => (\n                  <option key={truck.id} value={truck.truckNo}>{truck.truckNo} ({truck.ownerName || \'Self\'})</option>\n                ))}\n              </select>\n              {activeTrucks.length === 0 && (\n                <span className=\"text-[10px] text-amber-400 mt-1 block\">\342\232\240\357\270\217 No operational trucks. Registry is empty.</span>\n              )}\n            </div>\n\n            {/* OFFICE SELECT */}\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1.5\">\n                Loading Office <span className=\"text-red-500\">*</span>\n              </label>\n              <select\n                id=\"form-office-select\"\n                value={officeName}\n                onChange={(e) => setOfficeName(e.target.value)}\n                required\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"\">&mdash; Choose Active Office &mdash;</option>\n                {activeOffices.map(off => (\n                  <option key={off.id} value={off.officeName}>{off.officeName}</option>\n                ))}\n              </select>\n              {activeOffices.length === 0 && (\n                <span className=\"text-[10px] text-amber-400 mt-1 block\">\342\232\240\357\270\217 No active offices configuration found.</span>\n              )}\n            </div>\n          </div>\n\n          {/* DATES & EXPENSES GRID */}\n          <div className=\"bg-slate-950/40 border border-slate-800 rounded-xl p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4\">\n            <div>\n              <label className=\"block text-[11px] font-semibold text-slate-400 mb-1\">Loading Date</label>\n              <div className=\"relative\">\n                <Calendar className=\"absolute left-2.5 top-2.5 w-4 h-4 text-slate-500\" />\n                <input\n                  id=\"form-loading-date\"\n                  type=\"date\"\n                  required\n                  value={loadingDate}\n                  onChange={(e) => setLoadingDate(e.target.value)}\n                  className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg pl-9 pr-2 py-2 text-sm focus:outline-none\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-semibold text-slate-400 mb-1\">Rental (\342\202\271 Contract Amount)</label>\n              <input\n                id=\"form-rental\"\n                type=\"number\"\n                min=\"0\"\n                value={rental || \'\'}\n                onChange={(e) => setRental(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-semibold text-slate-400 mb-1\">Brokerage Commission (\342\202\271)</label>\n              <input\n                id=\"form-commission\"\n                type=\"number\"\n                min=\"0\"\n                value={commission || \'\'}\n                onChange={(e) => setCommission(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-semibold text-slate-400 mb-1\">Loading / Unloading (\342\202\271)</label>\n              <input\n                id=\"form-loading-unloading\"\n                type=\"number\"\n                min=\"0\"\n                value={loadingUnloading || \'\'}\n                onChange={(e) => setLoadingUnloading(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-semibold text-slate-400 mb-1\">Office Mamul (\342\202\271 local tips)</label>\n              <input\n                id=\"form-office-mamul\"\n                type=\"number\"\n                min=\"0\"\n                value={officeMamul || \'\'}\n                onChange={(e) => setOfficeMamul(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono\"\n              />\n            </div>\n          </div>\n\n          {/* ADVANCES RECORD SYSTEM */}\n          <div className=\"border border-slate-800 rounded-2xl p-5 bg-slate-950/20 space-y-4\">\n            <h4 className=\"text-sm font-bold text-white flex items-center gap-2\">\n              <Landmark className=\"w-4 h-4 text-indigo-400\" />\n              Interim Advances Register (Up to 3 Stages)\n            </h4>\n            \n            <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-5\">\n              {/* ADVANCE 1 */}\n              <div className=\"p-4 bg-slate-950/60 rounded-xl border border-slate-850\">\n                <span className=\"text-[11px] font-bold text-indigo-400 uppercase tracking-widest block mb-3\">Stage 1 Advance</span>\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"block text-[10px] text-slate-400 mb-1\">Advance 1 Amount (\342\202\271)</label>\n                    <input\n                      id=\"form-advance1\"\n                      type=\"number\"\n                      min=\"0\"\n                      value={advance1 || \'\'}\n                      onChange={(e) => setAdvance1(parseFloat(e.target.value) || 0)}\n                      placeholder=\"0\"\n                      className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2.5 py-1.5 text-xs text-right font-mono\"\n                    />\n                  </div>\n                  {advance1 > 0 && (\n                    <>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-400 mb-1\">Advance 1 Date</label>\n                        <input\n                          id=\"form-advance1-date\"\n                          type=\"date\"\n                          value={advance1Date}\n                          onChange={(e) => setAdvance1Date(e.target.value)}\n                          className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2 text-xs\"\n                        />\n                      </div>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-400 mb-1\">Received Into Account</label>\n                        <select\n                          id=\"form-advance1-receivedby\"\n                          value={advance1ReceivedBy}\n                          onChange={(e) => setAdvance1ReceivedBy(e.target.value)}\n                          className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2 py-1.5 text-xs\"\n                        >\n                          <option value=\"\">Choose Settlement A/c</option>\n                          {activeAccounts.map(acount => (\n                            <option key={acount.id} value={acount.id}>{acount.accountName}</option>\n                          ))}\n                        </select>\n                      </div>\n                    </>\n                  )}\n                </div>\n              </div>\n\n              {/* ADVANCE 2 */}\n              <div className=\"p-4 bg-slate-950/60 rounded-xl border border-slate-850\">\n                <span className=\"text-[11px] font-bold text-indigo-400 uppercase tracking-widest block mb-3\">Stage 2 Advance</span>\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"block text-[10px] text-slate-400 mb-1\">Advance 2 Amount (\342\202\271)</label>\n                    <input\n                      id=\"form-advance2\"\n                      type=\"number\"\n                      min=\"0\"\n                      value={advance2 || \'\'}\n                      onChange={(e) => setAdvance2(parseFloat(e.target.value) || 0)}\n                      placeholder=\"0\"\n                      className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2.5 py-1.5 text-xs text-right font-mono\"\n                    />\n                  </div>\n                  {advance2 > 0 && (\n                    <>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-400 mb-1\">Advance 2 Date</label>\n                        <input\n                          id=\"form-advance2-date\"\n                          type=\"date\"\n                          value={advance2Date}\n                          onChange={(e) => setAdvance2Date(e.target.value)}\n                          className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2 text-xs\"\n                        />\n                      </div>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-400 mb-1\">Received Into Account</label>\n                        <select\n                          id=\"form-advance2-receivedby\"\n                          value={advance2ReceivedBy}\n                          onChange={(e) => setAdvance2ReceivedBy(e.target.value)}\n                          className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2 py-1.5 text-xs\"\n                        >\n                          <option value=\"\">Choose Settlement A/c</option>\n                          {activeAccounts.map(acount => (\n                            <option key={acount.id} value={acount.id}>{acount.accountName}</option>\n                          ))}\n                        </select>\n                      </div>\n                    </>\n                  )}\n                </div>\n              </div>\n\n              {/* ADVANCE 3 */}\n              <div className=\"p-4 bg-slate-950/60 rounded-xl border border-slate-850\">\n                <span className=\"text-[11px] font-bold text-indigo-400 uppercase tracking-widest block mb-3\">Stage 3 Advance</span>\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"block text-[10px] text-slate-400 mb-1\">Advance 3 Amount (\342\202\271)</label>\n                    <input\n                      id=\"form-advance3\"\n                      type=\"number\"\n                      min=\"0\"\n                      value={advance3 || \'\'}\n                      onChange={(e) => setAdvance3(parseFloat(e.target.value) || 0)}\n                      placeholder=\"0\"\n                      className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2.5 py-1.5 text-xs text-right font-mono\"\n                    />\n                  </div>\n                  {advance3 > 0 && (\n                    <>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-400 mb-1\">Advance 3 Date</label>\n                        <input\n                          id=\"form-advance3-date\"\n                          type=\"date\"\n                          value={advance3Date}\n                          onChange={(e) => setAdvance3Date(e.target.value)}\n                          className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2 text-xs\"\n                        />\n                      </div>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-400 mb-1\">Received Into Account</label>\n                        <select\n                          id=\"form-advance3-receivedby\"\n                          value={advance3ReceivedBy}\n                          onChange={(e) => setAdvance3ReceivedBy(e.target.value)}\n                          className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2 py-1.5 text-xs\"\n                        >\n                          <option value=\"\">Choose Settlement A/c</option>\n                          {activeAccounts.map(acount => (\n                            <option key={acount.id} value={acount.id}>{acount.accountName}</option>\n                          ))}\n                        </select>\n                      </div>\n                    </>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* DYNAMIC CALCULATION BAR & OVERVIEW */}\n          <div className=\"border border-slate-800 rounded-2xl bg-indigo-950/20 p-5 p-r flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-indigo-500/10\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"p-2.5 bg-indigo-600/10 border border-indigo-500/30 rounded-xl text-indigo-400-u\">\n                <Calculator className=\"w-5 h-5 text-indigo-400\" />\n              </div>\n              <div>\n                <span className=\"text-xs font-semibold text-indigo-400\">LIQUID LEDGER CALCULATION</span>\n                <div className=\"flex flex-wrap text-[11px] gap-x-3 text-slate-400 mt-1\">\n                  <span>Contract: <strong className=\"text-white font-mono\">\342\202\271{rental.toLocaleString()}</strong></span>\n                  <span>&bull;</span>\n                  <span>Expenses: <strong className=\"text-yellow-500 font-mono\">\342\202\271{(commission + loadingUnloading + officeMamul).toLocaleString()}</strong></span>\n                  <span>&bull;</span>\n                  <span>Advances: <strong className=\"text-cyan-400 font-mono\">\342\202\271{(advance1 + advance2 + advance3).toLocaleString()}</strong></span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"bg-slate-950/80 border border-slate-800 rounded-xl p-3 px-5 text-right flex flex-col justify-center min-w-[200px]\">\n              <span className=\"text-[10px] text-slate-400 uppercase tracking-widest font-bold\">Outstanding Balance</span>\n              <span className={`text-xl font-bold font-mono tracking-tight ${calculatedLiveBalance > 0 ? \'text-amber-400\' : \'text-emerald-400\'}`}>\n                \342\202\271{calculatedLiveBalance.toLocaleString()}\n              </span>\n            </div>\n          </div>\n\n          {/* FINAL SETTLEMENT DETAILS */}\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-5 border-t border-slate-800 pt-5\">\n            {/* BALANCE SETTLEMENT DATA */}\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-400 mb-1 flex items-center gap-1\">\n                Settlement Date (Balance 1)\n              </label>\n              <input\n                id=\"form-balance-date\"\n                type=\"date\"\n                value={balance1Date}\n                onChange={(e) => setBalance1Date(e.target.value)}\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n\n            {/* BALANCE SETTLED BY ACCOUNT */}\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-400 mb-1\">\n                Settled Account (Balance 1)\n              </label>\n              <select\n                id=\"form-balance-receivedby\"\n                value={balance1ReceivedBy}\n                onChange={(e) => setBalance1ReceivedBy(e.target.value)}\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"\">&mdash; Unsettled &mdash;</option>\n                {activeAccounts.map(ac => (\n                  <option key={ac.id} value={ac.id}>{ac.accountName}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* DYNAMIC TRIP STATUS */}\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-400 mb-1\">\n                Trip Ledger Status\n              </label>\n              <select\n                id=\"form-status\"\n                value={status}\n                onChange={(e) => setStatus(e.target.value as TripStatus)}\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm font-semibold focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"Pending\" className=\"text-slate-400 font-semibold\">Pending (No Advances)</option>\n                <option value=\"In Progress\" className=\"text-amber-400 font-semibold\">In Progress (Active/Advances Paid)</option>\n                <option value=\"Completed\" className=\"text-blue-400 font-semibold\">Completed (On-Road / Goods Delivered)</option>\n                <option value=\"Paid\" className=\"text-emerald-400 font-semibold\">Paid (Settled / Zero Outstanding)</option>\n              </select>\n            </div>\n          </div>\n\n          {/* NOTES AREA */}\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-400 mb-1.5\">Route Remarks / Consignment Notes</label>\n            <textarea\n              id=\"form-notes\"\n              rows={2}\n              placeholder=\"e.g. Coal consignment loaded at Mumbai port. Driver: Jagdish. Delivered on time.\"\n              value={notes}\n              onChange={(e) => setNotes(e.target.value)}\n              className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-indigo-500\"\n            />\n          </div>\n\n          {/* SUBMIT BUTTON ACTIONS */}\n          <div className=\"flex justify-end gap-3 pt-5 border-t border-slate-800\">\n            <button\n              id=\"btn-form-cancel\"\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-5 py-2.5 text-sm font-semibold text-slate-400 hover:text-white transition\"\n            >\n              Cancel\n            </button>\n            <button\n              id=\"btn-form-submit\"\n              type=\"submit\"\n              className=\"bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm px-6 py-2.5 rounded-xl shadow-lg shadow-indigo-600/20 transition\"\n            >\n              {editingEntry ? \'Update Trip Entry\' : \'Post Trip Entries\'}\n            </button>\n          </div>\n\n        </form>\n      </div>\n    </div>"
        replacement_content: "  return (\n    <div id=\"trip-modal-overlay\" className=\"fixed inset-0 bg-slate-950/50 backdrop-blur-xs z-50 flex items-center justify-center p-4 overflow-y-auto\">\n      <div id=\"trip-modal-container\" className=\"bg-white border border-slate-200 rounded-xl w-full max-w-4xl shadow-xl overflow-hidden my-8 animate-scale-up\">\n        \n        {/* Header */}\n        <div className=\"px-6 py-4 bg-slate-50 border-b border-slate-200 flex justify-between items-center\">\n          <div>\n            <h3 className=\"text-lg font-bold text-slate-800 flex items-center gap-2\">\n              <Coins className=\"w-5 h-5 text-blue-650\" />\n              {editingEntry ? `Edit Log Reference ID: ${editingEntry.tripNo}` : \'Record New Transport Trip Segment\'}\n            </h3>\n            <p className=\"text-xs text-slate-500\">Specify details down below. Trip ledger recalculates live liabilities automatically.</p>\n          </div>\n          <button\n            id=\"btn-close-modal\"\n            onClick={onClose}\n            className=\"p-1 px-2 text-slate-400 hover:text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg transition shrink-0 cursor-pointer\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Action Panel / Form */}\n        <form id=\"trip-entry-form\" onSubmit={handleSubmit} className=\"p-6 overflow-y-auto max-h-[75vh] space-y-6\">\n          \n          {/* TRIP ASSIGNMENT SECTOR */}\n          {!editingEntry && (\n            <div className=\"bg-slate-50 p-4 rounded-lg border border-slate-200 grid grid-cols-1 md:grid-cols-3 gap-4 items-center\">\n              <div>\n                <span className=\"block text-xs font-bold uppercase tracking-wider text-slate-700\">Trip Joint Management</span>\n                <span className=\"text-[11px] text-slate-500 block leading-tight mt-1\">Combine multiple cargos into a unified trip index number.</span>\n              </div>\n              <div className=\"flex bg-slate-200/55 rounded-lg p-1 gap-1 h-10 col-span-2\">\n                <button\n                  id=\"tab-trip-auto\"\n                  type=\"button\"\n                  onClick={() => setTripNoOption(\'AUTO\')}\n                  className={`flex-1 rounded px-3 text-xs font-bold transition duration-150 cursor-pointer ${\n                    tripNoOption === \'AUTO\' \n                      ? \'bg-white text-slate-800 shadow-3xs\' \n                      : \'text-slate-550 hover:text-slate-800\'\n                  }`}\n                >\n                  Auto-Generate New ID\n                </button>\n                <button\n                  id=\"tab-trip-existing\"\n                  type=\"button\"\n                  disabled={existingTripNos.length === 0}\n                  onClick={() => setTripNoOption(\'EXISTING\')}\n                  className={`flex-1 rounded px-3 text-xs font-bold transition duration-150 disabled:opacity-40 disabled:hover:bg-transparent cursor-pointer ${\n                    tripNoOption === \'EXISTING\' \n                      ? \'bg-white text-slate-800 shadow-3xs\' \n                      : \'text-slate-550 hover:text-slate-800\'\n                  }`}\n                >\n                  Join Existing Trip ({existingTripNos.length})\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* BASIC TRUCK, OFFICE & LOAD SPECS */}\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-5\">\n            {/* TRIP NO DISPLAY / CHOOSE */}\n            <div>\n              <label className=\"block text-xs font-bold text-slate-600 mb-1.5 flex items-center gap-1.5\">\n                Trip Number <span className=\"text-red-500\">*</span>\n              </label>\n              {editingEntry ? (\n                <input\n                  id=\"form-trip-no-disabled\"\n                  type=\"text\"\n                  disabled\n                  value={tripNo}\n                  className=\"w-full bg-slate-100 border border-slate-200 text-slate-550 font-mono font-bold tracking-wider rounded-lg px-3 py-2 text-sm\"\n                />\n              ) : tripNoOption === \'AUTO\' ? (\n                <div className=\"relative\">\n                  <input\n                    id=\"form-trip-no-auto\"\n                    type=\"text\"\n                    required\n                    value={tripNo}\n                    onChange={(e) => setTripNo(e.target.value.toUpperCase())}\n                    className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 font-mono font-bold tracking-wider rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-500 focus:bg-white\"\n                  />\n                  <span className=\"absolute bottom-1.5 right-2 text-[9px] text-slate-400 bg-slate-100 border border-slate-200 rounded px-1 font-bold\">PREVIEW</span>\n                </div>\n              ) : (\n                <select\n                  id=\"form-trip-no-existing-select\"\n                  value={selectedExistingTripNo}\n                  onChange={(e) => setSelectedExistingTripNo(e.target.value)}\n                  required\n                  className=\"w-full bg-slate-50 border border-slate-200 text-blue-700 font-mono font-bold tracking-wider rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-blue-500 focus:bg-white\"\n                >\n                  {existingTripNos.map(no => (\n                    <option key={no} value={no}>{no}</option>\n                  ))}\n                </select>\n              )}\n            </div>\n\n            {/* TRUCK SELECT */}\n            <div>\n              <label className=\"block text-xs font-bold text-slate-600 mb-1.5\">\n                Truck Number <span className=\"text-red-500\">*</span>\n              </label>\n              <select\n                id=\"form-truck-select\"\n                value={truckNo}\n                onChange={(e) => setTruckNo(e.target.value)}\n                required\n                className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 font-mono font-semibold rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-blue-500 focus:bg-white\"\n              >\n                <option value=\"\">&mdash; Choose Active Truck &mdash;</option>\n                {activeTrucks.map(truck => (\n                  <option key={truck.id} value={truck.truckNo}>{truck.truckNo} ({truck.ownerName || \'Self\'})</option>\n                ))}\n              </select>\n              {activeTrucks.length === 0 && (\n                <span className=\"text-[10px] text-amber-600 mt-1 block\">\342\232\240\357\270\217 No operational trucks. Registry is empty.</span>\n              )}\n            </div>\n\n            {/* OFFICE SELECT */}\n            <div>\n              <label className=\"block text-xs font-bold text-slate-600 mb-1.5\">\n                Loading Office <span className=\"text-red-500\">*</span>\n              </label>\n              <select\n                id=\"form-office-select\"\n                value={officeName}\n                onChange={(e) => setOfficeName(e.target.value)}\n                required\n                className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 font-medium rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-blue-500 focus:bg-white\"\n              >\n                <option value=\"\">&mdash; Choose Active Office &mdash;</option>\n                {activeOffices.map(off => (\n                  <option key={off.id} value={off.officeName}>{off.officeName}</option>\n                ))}\n              </select>\n              {activeOffices.length === 0 && (\n                <span className=\"text-[10px] text-amber-600 mt-1 block\">\342\232\240\357\270\217 No active offices configuration found.</span>\n              )}\n            </div>\n          </div>\n\n          {/* DATES & EXPENSES GRID */}\n          <div className=\"bg-slate-50 border border-slate-200 rounded-lg p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4\">\n            <div>\n              <label className=\"block text-[11px] font-bold text-slate-600 mb-1\">Loading Date</label>\n              <div className=\"relative\">\n                <Calendar className=\"absolute left-2.5 top-2.5 w-4 h-4 text-slate-400\" />\n                <input\n                  id=\"form-loading-date\"\n                  type=\"date\"\n                  required\n                  value={loadingDate}\n                  onChange={(e) => setLoadingDate(e.target.value)}\n                  className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg pl-9 pr-2 py-1.5 text-sm focus:outline-none focus:border-blue-500\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-bold text-slate-600 mb-1\">Rental (\342\202\271 Contract Amount)</label>\n              <input\n                id=\"form-rental\"\n                type=\"number\"\n                min=\"0\"\n                value={rental || \'\'}\n                onChange={(e) => setRental(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono font-semibold focus:border-blue-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-bold text-slate-600 mb-1\">Commission (\342\202\271)</label>\n              <input\n                id=\"form-commission\"\n                type=\"number\"\n                min=\"0\"\n                value={commission || \'\'}\n                onChange={(e) => setCommission(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono focus:border-blue-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-bold text-slate-600 mb-1\">Loading / Unloading (\342\202\271)</label>\n              <input\n                id=\"form-loading-unloading\"\n                type=\"number\"\n                min=\"0\"\n                value={loadingUnloading || \'\'}\n                onChange={(e) => setLoadingUnloading(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono focus:border-blue-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-bold text-slate-600 mb-1\">Office Mamul (\342\202\271 tips)</label>\n              <input\n                id=\"form-office-mamul\"\n                type=\"number\"\n                min=\"0\"\n                value={officeMamul || \'\'}\n                onChange={(e) => setOfficeMamul(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono focus:border-blue-500\"\n              />\n            </div>\n          </div>\n\n          {/* ADVANCES RECORD SYSTEM */}\n          <div className=\"border border-slate-200 rounded-xl p-5 bg-slate-50/50 space-y-4\">\n            <h4 className=\"text-sm font-bold text-slate-800 flex items-center gap-2\">\n              <Landmark className=\"w-4 h-4 text-blue-600\" />\n              Interim Advances Register (Up to 3 Stages)\n            </h4>\n            \n            <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-4\">\n              {/* ADVANCE 1 */}\n              <div className=\"p-4 bg-white rounded-lg border border-slate-200 shadow-3xs\">\n                <span className=\"text-[11px] font-bold text-blue-600 uppercase tracking-wider block mb-3\">Stage 1 Advance</span>\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"block text-[10px] text-slate-500 mb-1 font-semibold\">Advance 1 Amount (\342\202\271)</label>\n                    <input\n                      id=\"form-advance1\"\n                      type=\"number\"\n                      min=\"0\"\n                      value={advance1 || \'\'}\n                      onChange={(e) => setAdvance1(parseFloat(e.target.value) || 0)}\n                      placeholder=\"0\"\n                      className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-right font-mono focus:bg-white focus:outline-none focus:border-blue-500\"\n                    />\n                  </div>\n                  {advance1 > 0 && (\n                    <>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-500 mb-1 font-semibold\">Advance 1 Date</label>\n                        <input\n                          id=\"form-advance1-date\"\n                          type=\"date\"\n                          value={advance1Date}\n                          onChange={(e) => setAdvance1Date(e.target.value)}\n                          className=\"w-full bg-slate-50 border border-slate-200 text-slate-850 rounded-lg px-2 py-1 text-xs focus:bg-white focus:outline-none focus:border-blue-500\"\n                        />\n                      </div>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-500 mb-1 font-semibold\">Received Into Account</label>\n                        <select\n                          id=\"form-advance1-receivedby\"\n                          value={advance1ReceivedBy}\n                          onChange={(e) => setAdvance1ReceivedBy(e.target.value)}\n                          className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-2 py-1.5 text-xs focus:bg-white focus:outline-none focus:border-blue-500\"\n                        >\n                          <option value=\"\">Choose Settlement A/c</option>\n                          {activeAccounts.map(acount => (\n                            <option key={acount.id} value={acount.id}>{acount.accountName}</option>\n                          ))}\n                        </select>\n                      </div>\n                    </>\n                  )}\n                </div>\n              </div>\n\n              {/* ADVANCE 2 */}\n              <div className=\"p-4 bg-white rounded-lg border border-slate-200 shadow-3xs\">\n                <span className=\"text-[11px] font-bold text-blue-600 uppercase tracking-wider block mb-3\">Stage 2 Advance</span>\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"block text-[10px] text-slate-500 mb-1 font-semibold\">Advance 2 Amount (\342\202\271)</label>\n                    <input\n                      id=\"form-advance2\"\n                      type=\"number\"\n                      min=\"0\"\n                      value={advance2 || \'\'}\n                      onChange={(e) => setAdvance2(parseFloat(e.target.value) || 0)}\n                      placeholder=\"0\"\n                      className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-right font-mono focus:bg-white focus:outline-none focus:border-blue-500\"\n                    />\n                  </div>\n                  {advance2 > 0 && (\n                    <>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-500 mb-1 font-semibold\">Advance 2 Date</label>\n                        <input\n                          id=\"form-advance2-date\"\n                          type=\"date\"\n                          value={advance2Date}\n                          onChange={(e) => setAdvance2Date(e.target.value)}\n                          className=\"w-full bg-slate-50 border border-slate-200 text-slate-850 rounded-lg px-2 py-1 text-xs focus:bg-white focus:outline-none focus:border-blue-500\"\n                        />\n                      </div>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-500 mb-1 font-semibold\">Received Into Account</label>\n                        <select\n                          id=\"form-advance2-receivedby\"\n                          value={advance2ReceivedBy}\n                          onChange={(e) => setAdvance2ReceivedBy(e.target.value)}\n                          className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-2 py-1.5 text-xs focus:bg-white focus:outline-none focus:border-blue-500\"\n                        >\n                          <option value=\"\">Choose Settlement A/c</option>\n                          {activeAccounts.map(acount => (\n                            <option key={acount.id} value={acount.id}>{acount.accountName}</option>\n                          ))}\n                        </select>\n                      </div>\n                    </>\n                  )}\n                </div>\n              </div>\n\n              {/* ADVANCE 3 */}\n              <div className=\"p-4 bg-white rounded-lg border border-slate-200 shadow-3xs\">\n                <span className=\"text-[11px] font-bold text-blue-600 uppercase tracking-wider block mb-3\">Stage 3 Advance</span>\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"block text-[10px] text-slate-500 mb-1 font-semibold\">Advance 3 Amount (\342\202\271)</label>\n                    <input\n                      id=\"form-advance3\"\n                      type=\"number\"\n                      min=\"0\"\n                      value={advance3 || \'\'}\n                      onChange={(e) => setAdvance3(parseFloat(e.target.value) || 0)}\n                      placeholder=\"0\"\n                      className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-2.5 py-1.5 text-xs text-right font-mono focus:bg-white focus:outline-none focus:border-blue-500\"\n                    />\n                  </div>\n                  {advance3 > 0 && (\n                    <>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-500 mb-1 font-semibold\">Advance 3 Date</label>\n                        <input\n                          id=\"form-advance3-date\"\n                          type=\"date\"\n                          value={advance3Date}\n                          onChange={(e) => setAdvance3Date(e.target.value)}\n                          className=\"w-full bg-slate-50 border border-slate-200 text-slate-850 rounded-lg px-2 py-1 text-xs focus:bg-white focus:outline-none focus:border-blue-500\"\n                        />\n                      </div>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-500 mb-1 font-semibold\">Received Into Account</label>\n                        <select\n                          id=\"form-advance3-receivedby\"\n                          value={advance3ReceivedBy}\n                          onChange={(e) => setAdvance3ReceivedBy(e.target.value)}\n                          className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-2 py-1.5 text-xs focus:bg-white focus:outline-none focus:border-blue-500\"\n                        >\n                          <option value=\"\">Choose Settlement A/c</option>\n                          {activeAccounts.map(acount => (\n                            <option key={acount.id} value={acount.id}>{acount.accountName}</option>\n                          ))}\n                        </select>\n                      </div>\n                    </>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* DYNAMIC CALCULATION BAR & OVERVIEW */}\n          <div className=\"border border-slate-200 rounded-xl bg-slate-50 p-4 md:p-5 flex flex-col md:flex-row justify-between items-start md:items-center gap-4\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"p-2.5 bg-blue-50 border border-blue-100 rounded-xl text-blue-600 shrink-0\">\n                <Calculator className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <span className=\"text-[10px] uppercase font-bold tracking-wider text-slate-500\">Live Recalculation Engine</span>\n                <div className=\"flex flex-wrap text-xs gap-x-3 text-slate-650 mt-1 font-medium\">\n                  <span>Contract: <strong className=\"text-slate-800 font-mono\">\342\202\271{rental.toLocaleString()}</strong></span>\n                  <span>&bull;</span>\n                  <span>Expenses: <strong className=\"text-slate-700 font-mono\">\342\202\271{(commission + loadingUnloading + officeMamul).toLocaleString()}</strong></span>\n                  <span>&bull;</span>\n                  <span>Advances: <strong className=\"text-blue-700 font-mono\">\342\202\271{(advance1 + advance2 + advance3).toLocaleString()}</strong></span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"bg-slate-900 border border-slate-950 rounded-xl p-3 px-5 text-right flex flex-col justify-center min-w-[200px] shadow-sm\">\n              <span className=\"text-[10px] text-slate-400 uppercase tracking-wider font-bold\">Outstanding Balance</span>\n              <span className={`text-xl font-extrabold font-mono tracking-tight ${calculatedLiveBalance > 0 ? \'text-amber-400\' : \'text-emerald-400\'}`}>\n                \342\202\271{calculatedLiveBalance.toLocaleString()}\n              </span>\n            </div>\n          </div>\n\n          {/* FINAL SETTLEMENT DETAILS */}\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-5 border-t border-slate-150 pt-5\">\n            {/* BALANCE SETTLEMENT DATA */}\n            <div>\n              <label className=\"block text-xs font-bold text-slate-600 mb-1 flex items-center gap-1\">\n                Settlement Date (Balance 1)\n              </label>\n              <input\n                id=\"form-balance-date\"\n                type=\"date\"\n                value={balance1Date}\n                onChange={(e) => setBalance1Date(e.target.value)}\n                className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-blue-500 focus:bg-white\"\n              />\n            </div>\n\n            {/* BALANCE SETTLED BY ACCOUNT */}\n            <div>\n              <label className=\"block text-xs font-bold text-slate-600 mb-1\">\n                Settled Account (Balance 1)\n              </label>\n              <select\n                id=\"form-balance-receivedby\"\n                value={balance1ReceivedBy}\n                onChange={(e) => setBalance1ReceivedBy(e.target.value)}\n                className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-3 py-1.5 text-sm focus:outline-none focus:border-blue-500 focus:bg-white\"\n              >\n                <option value=\"\">&mdash; Unsettled &mdash;</option>\n                {activeAccounts.map(ac => (\n                  <option key={ac.id} value={ac.id}>{ac.accountName}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* DYNAMIC TRIP STATUS */}\n            <div>\n              <label className=\"block text-xs font-bold text-slate-600 mb-1\">\n                Trip Ledger Status\n              </label>\n              <select\n                id=\"form-status\"\n                value={status}\n                onChange={(e) => setStatus(e.target.value as TripStatus)}\n                className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-3 py-1.5 text-sm font-semibold focus:outline-none focus:border-blue-500 focus:bg-white\"\n              >\n                <option value=\"Pending\" className=\"text-slate-600 font-semibold\">Pending (No Advances)</option>\n                <option value=\"In Progress\" className=\"text-amber-700 font-semibold\">In Progress (Active/Advances)</option>\n                <option value=\"Completed\" className=\"text-blue-700 font-semibold\">Completed (Road/Delivered)</option>\n                <option value=\"Paid\" className=\"text-emerald-700 font-semibold\">Paid (Settled / Zero Out)</option>\n              </select>\n            </div>\n          </div>\n\n          {/* NOTES AREA */}\n          <div>\n            <label className=\"block text-xs font-bold text-slate-600 mb-1.5\">Route Remarks / Consignment Notes</label>\n            <textarea\n              id=\"form-notes\"\n              rows={2}\n              placeholder=\"e.g. Coal consignment loaded at Mumbai port. Driver: Jagdish. Delivered on time.\"\n              value={notes}\n              onChange={(e) => setNotes(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500 focus:bg-white placeholder:text-slate-400\"\n            />\n          </div>\n\n          {/* SUBMIT BUTTON ACTIONS */}\n          <div className=\"flex justify-end gap-3 pt-5 border-t border-slate-150\">\n            <button\n              id=\"btn-form-cancel\"\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-5 py-2 text-sm font-bold text-slate-500 hover:text-slate-850 transition cursor-pointer\"\n            >\n              Cancel\n            </button>\n            <button\n              id=\"btn-form-submit\"\n              type=\"submit\"\n              className=\"bg-blue-650 hover:bg-blue-700 text-white font-bold text-xs px-6 py-2.5 rounded-lg shadow-sm transition hover:scale-[1.01] cursor-pointer\"\n            >\n              {editingEntry ? \'Update Trip Entry\' : \'Post Trip Entries\'}\n            </button>\n          </div>\n\n        </form>\n      </div>\n    </div>\n  );\n}"
      }
      fuzzy_match: "  return (\n    <div id=\"trip-modal-overlay\" className=\"fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 flex items-center justify-center p-4 overflow-y-auto\">\n      <div id=\"trip-modal-container\" className=\"bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-4xl shadow-2xl overflow-hidden my-8 animate-scale-up\">\n        \n        {/* Header */}\n        <div className=\"px-6 py-4 bg-slate-950/80 border-b border-slate-800 flex justify-between items-center\">\n          <div>\n            <h3 className=\"text-lg font-bold text-white flex items-center gap-2\">\n              <Coins className=\"w-5 h-5 text-indigo-400\" />\n              {editingEntry ? `Edit Log Reference ID: ${editingEntry.tripNo}` : \'Record New Transport Trip Segment\'}\n            </h3>\n            <p className=\"text-xs text-slate-400\">Specify details down below. Trip ledger recalculates live liabilities automatically.</p>\n          </div>\n          <button\n            id=\"btn-close-modal\"\n            onClick={onClose}\n            className=\"p-1 px-2.5 bg-slate-850 hover:bg-slate-800 text-slate-400 hover:text-white rounded-lg transition\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        {/* Action Panel / Form */}\n        <form id=\"trip-entry-form\" onSubmit={handleSubmit} className=\"p-6 overflow-y-auto max-h-[80vh] space-y-6\">\n          \n          {/* TRIP ASSIGNMENT SECTOR */}\n          {!editingEntry && (\n            <div className=\"bg-slate-950 p-4 rounded-xl border border-indigo-500/10 grid grid-cols-1 md:grid-cols-3 gap-4 items-center\">\n              <div>\n                <span className=\"block text-xs font-semibold uppercase tracking-wider text-indigo-400\">Trip No Management</span>\n                <span className=\"text-[11px] text-slate-500 block leading-tight mt-1\">Combine multiple cargos into a unified trip index number.</span>\n              </div>\n              <div className=\"flex bg-slate-905 border border-slate-800 rounded-lg p-1 gap-1 h-10 col-span-2\">\n                <button\n                  id=\"tab-trip-auto\"\n                  type=\"button\"\n                  onClick={() => setTripNoOption(\'AUTO\')}\n                  className={`flex-1 rounded px-3 text-xs font-medium transition ${\n                    tripNoOption === \'AUTO\' \n                      ? \'bg-indigo-600 text-white shadow\' \n                      : \'text-slate-400 hover:text-white hover:bg-slate-800\'\n                  }`}\n                >\n                  Auto-Generate New ID\n                </button>\n                <button\n                  id=\"tab-trip-existing\"\n                  type=\"button\"\n                  disabled={existingTripNos.length === 0}\n                  onClick={() => setTripNoOption(\'EXISTING\')}\n                  className={`flex-1 rounded px-3 text-xs font-medium transition disabled:opacity-40 disabled:hover:bg-transparent ${\n                    tripNoOption === \'EXISTING\' \n                      ? \'bg-indigo-600 text-white shadow\' \n                      : \'text-slate-400 hover:text-white hover:bg-slate-800\'\n                  }`}\n                >\n                  Join Existing Trip ({existingTripNos.length})\n                </button>\n              </div>\n            </div>\n          )}\n\n          {/* BASIC TRUCK, OFFICE & LOAD SPECS */}\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-5\">\n            {/* TRIP NO DISPLAY / CHOOSE */}\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1.5 flex items-center gap-1.5\">\n                Trip Number <span className=\"text-red-500\">*</span>\n              </label>\n              {editingEntry ? (\n                <input\n                  id=\"form-trip-no-disabled\"\n                  type=\"text\"\n                  disabled\n                  value={tripNo}\n                  className=\"w-full bg-slate-950 border border-slate-800 text-slate-400 font-mono font-bold tracking-widest rounded-lg px-3 py-2 text-sm\"\n                />\n              ) : tripNoOption === \'AUTO\' ? (\n                <div className=\"relative\">\n                  <input\n                    id=\"form-trip-no-auto\"\n                    type=\"text\"\n                    required\n                    value={tripNo}\n                    onChange={(e) => setTripNo(e.target.value.toUpperCase())}\n                    className=\"w-full bg-slate-950 border border-indigo-500/30 text-white font-mono font-bold tracking-widest rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n                  />\n                  <span className=\"absolute bottom-1 right-2 text-[9px] text-slate-500 bg-slate-900 border border-slate-800 rounded px-1\">PREVIEW</span>\n                </div>\n              ) : (\n                <select\n                  id=\"form-trip-no-existing-select\"\n                  value={selectedExistingTripNo}\n                  onChange={(e) => setSelectedExistingTripNo(e.target.value)}\n                  required\n                  className=\"w-full bg-slate-950 border border-indigo-500/30 text-indigo-300 font-mono font-bold tracking-widest rounded-lg px-3 py-2 text-sm focus:outline-none\"\n                >\n                  {existingTripNos.map(no => (\n                    <option key={no} value={no}>{no}</option>\n                  ))}\n                </select>\n              )}\n            </div>\n\n            {/* TRUCK SELECT */}\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1.5\">\n                Truck Number <span className=\"text-red-500\">*</span>\n              </label>\n              <select\n                id=\"form-truck-select\"\n                value={truckNo}\n                onChange={(e) => setTruckNo(e.target.value)}\n                required\n                className=\"w-full bg-slate-950 border border-slate-800 text-white font-mono font-medium rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"\">&mdash; Choose Active Truck &mdash;</option>\n                {activeTrucks.map(truck => (\n                  <option key={truck.id} value={truck.truckNo}>{truck.truckNo} ({truck.ownerName || \'Self\'})</option>\n                ))}\n              </select>\n              {activeTrucks.length === 0 && (\n                <span className=\"text-[10px] text-amber-400 mt-1 block\">\342\232\240\357\270\217 No operational trucks. Registry is empty.</span>\n              )}\n            </div>\n\n            {/* OFFICE SELECT */}\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1.5\">\n                Loading Office <span className=\"text-red-500\">*</span>\n              </label>\n              <select\n                id=\"form-office-select\"\n                value={officeName}\n                onChange={(e) => setOfficeName(e.target.value)}\n                required\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"\">&mdash; Choose Active Office &mdash;</option>\n                {activeOffices.map(off => (\n                  <option key={off.id} value={off.officeName}>{off.officeName}</option>\n                ))}\n              </select>\n              {activeOffices.length === 0 && (\n                <span className=\"text-[10px] text-amber-400 mt-1 block\">\342\232\240\357\270\217 No active offices configuration found.</span>\n              )}\n            </div>\n          </div>\n\n          {/* DATES & EXPENSES GRID */}\n          <div className=\"bg-slate-950/40 border border-slate-800 rounded-xl p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4\">\n            <div>\n              <label className=\"block text-[11px] font-semibold text-slate-400 mb-1\">Loading Date</label>\n              <div className=\"relative\">\n                <Calendar className=\"absolute left-2.5 top-2.5 w-4 h-4 text-slate-500\" />\n                <input\n                  id=\"form-loading-date\"\n                  type=\"date\"\n                  required\n                  value={loadingDate}\n                  onChange={(e) => setLoadingDate(e.target.value)}\n                  className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg pl-9 pr-2 py-2 text-sm focus:outline-none\"\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-semibold text-slate-400 mb-1\">Rental (\342\202\271 Contract Amount)</label>\n              <input\n                id=\"form-rental\"\n                type=\"number\"\n                min=\"0\"\n                value={rental || \'\'}\n                onChange={(e) => setRental(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-semibold text-slate-400 mb-1\">Brokerage Commission (\342\202\271)</label>\n              <input\n                id=\"form-commission\"\n                type=\"number\"\n                min=\"0\"\n                value={commission || \'\'}\n                onChange={(e) => setCommission(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-semibold text-slate-400 mb-1\">Loading / Unloading (\342\202\271)</label>\n              <input\n                id=\"form-loading-unloading\"\n                type=\"number\"\n                min=\"0\"\n                value={loadingUnloading || \'\'}\n                onChange={(e) => setLoadingUnloading(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[11px] font-semibold text-slate-400 mb-1\">Office Mamul (\342\202\271 local tips)</label>\n              <input\n                id=\"form-office-mamul\"\n                type=\"number\"\n                min=\"0\"\n                value={officeMamul || \'\'}\n                onChange={(e) => setOfficeMamul(parseFloat(e.target.value) || 0)}\n                placeholder=\"0\"\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none text-right font-mono\"\n              />\n            </div>\n          </div>\n\n          {/* ADVANCES RECORD SYSTEM */}\n          <div className=\"border border-slate-800 rounded-2xl p-5 bg-slate-950/20 space-y-4\">\n            <h4 className=\"text-sm font-bold text-white flex items-center gap-2\">\n              <Landmark className=\"w-4 h-4 text-indigo-400\" />\n              Interim Advances Register (Up to 3 Stages)\n            </h4>\n            \n            <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-5\">\n              {/* ADVANCE 1 */}\n              <div className=\"p-4 bg-slate-950/60 rounded-xl border border-slate-850\">\n                <span className=\"text-[11px] font-bold text-indigo-400 uppercase tracking-widest block mb-3\">Stage 1 Advance</span>\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"block text-[10px] text-slate-400 mb-1\">Advance 1 Amount (\342\202\271)</label>\n                    <input\n                      id=\"form-advance1\"\n                      type=\"number\"\n                      min=\"0\"\n                      value={advance1 || \'\'}\n                      onChange={(e) => setAdvance1(parseFloat(e.target.value) || 0)}\n                      placeholder=\"0\"\n                      className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2.5 py-1.5 text-xs text-right font-mono\"\n                    />\n                  </div>\n                  {advance1 > 0 && (\n                    <>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-400 mb-1\">Advance 1 Date</label>\n                        <input\n                          id=\"form-advance1-date\"\n                          type=\"date\"\n                          value={advance1Date}\n                          onChange={(e) => setAdvance1Date(e.target.value)}\n                          className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2 text-xs\"\n                        />\n                      </div>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-400 mb-1\">Received Into Account</label>\n                        <select\n                          id=\"form-advance1-receivedby\"\n                          value={advance1ReceivedBy}\n                          onChange={(e) => setAdvance1ReceivedBy(e.target.value)}\n                          className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2 py-1.5 text-xs\"\n                        >\n                          <option value=\"\">Choose Settlement A/c</option>\n                          {activeAccounts.map(acount => (\n                            <option key={acount.id} value={acount.id}>{acount.accountName}</option>\n                          ))}\n                        </select>\n                      </div>\n                    </>\n                  )}\n                </div>\n              </div>\n\n              {/* ADVANCE 2 */}\n              <div className=\"p-4 bg-slate-950/60 rounded-xl border border-slate-850\">\n                <span className=\"text-[11px] font-bold text-indigo-400 uppercase tracking-widest block mb-3\">Stage 2 Advance</span>\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"block text-[10px] text-slate-400 mb-1\">Advance 2 Amount (\342\202\271)</label>\n                    <input\n                      id=\"form-advance2\"\n                      type=\"number\"\n                      min=\"0\"\n                      value={advance2 || \'\'}\n                      onChange={(e) => setAdvance2(parseFloat(e.target.value) || 0)}\n                      placeholder=\"0\"\n                      className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2.5 py-1.5 text-xs text-right font-mono\"\n                    />\n                  </div>\n                  {advance2 > 0 && (\n                    <>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-400 mb-1\">Advance 2 Date</label>\n                        <input\n                          id=\"form-advance2-date\"\n                          type=\"date\"\n                          value={advance2Date}\n                          onChange={(e) => setAdvance2Date(e.target.value)}\n                          className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2 text-xs\"\n                        />\n                      </div>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-400 mb-1\">Received Into Account</label>\n                        <select\n                          id=\"form-advance2-receivedby\"\n                          value={advance2ReceivedBy}\n                          onChange={(e) => setAdvance2ReceivedBy(e.target.value)}\n                          className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2 py-1.5 text-xs\"\n                        >\n                          <option value=\"\">Choose Settlement A/c</option>\n                          {activeAccounts.map(acount => (\n                            <option key={acount.id} value={acount.id}>{acount.accountName}</option>\n                          ))}\n                        </select>\n                      </div>\n                    </>\n                  )}\n                </div>\n              </div>\n\n              {/* ADVANCE 3 */}\n              <div className=\"p-4 bg-slate-950/60 rounded-xl border border-slate-850\">\n                <span className=\"text-[11px] font-bold text-indigo-400 uppercase tracking-widest block mb-3\">Stage 3 Advance</span>\n                <div className=\"space-y-3\">\n                  <div>\n                    <label className=\"block text-[10px] text-slate-400 mb-1\">Advance 3 Amount (\342\202\271)</label>\n                    <input\n                      id=\"form-advance3\"\n                      type=\"number\"\n                      min=\"0\"\n                      value={advance3 || \'\'}\n                      onChange={(e) => setAdvance3(parseFloat(e.target.value) || 0)}\n                      placeholder=\"0\"\n                      className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2.5 py-1.5 text-xs text-right font-mono\"\n                    />\n                  </div>\n                  {advance3 > 0 && (\n                    <>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-400 mb-1\">Advance 3 Date</label>\n                        <input\n                          id=\"form-advance3-date\"\n                          type=\"date\"\n                          value={advance3Date}\n                          onChange={(e) => setAdvance3Date(e.target.value)}\n                          className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2 text-xs\"\n                        />\n                      </div>\n                      <div>\n                        <label className=\"block text-[10px] text-slate-400 mb-1\">Received Into Account</label>\n                        <select\n                          id=\"form-advance3-receivedby\"\n                          value={advance3ReceivedBy}\n                          onChange={(e) => setAdvance3ReceivedBy(e.target.value)}\n                          className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-2 py-1.5 text-xs\"\n                        >\n                          <option value=\"\">Choose Settlement A/c</option>\n                          {activeAccounts.map(acount => (\n                            <option key={acount.id} value={acount.id}>{acount.accountName}</option>\n                          ))}\n                        </select>\n                      </div>\n                    </>\n                  )}\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* DYNAMIC CALCULATION BAR & OVERVIEW */}\n          <div className=\"border border-slate-800 rounded-2xl bg-indigo-950/20 p-5 p-r flex flex-col md:flex-row justify-between items-start md:items-center gap-4 border-indigo-500/10\">\n            <div className=\"flex items-center gap-3\">\n              <div className=\"p-2.5 bg-indigo-600/10 border border-indigo-500/30 rounded-xl text-indigo-400-u\">\n                <Calculator className=\"w-5 h-5 text-indigo-400\" />\n              </div>\n              <div>\n                <span className=\"text-xs font-semibold text-indigo-400\">LIQUID LEDGER CALCULATION</span>\n                <div className=\"flex flex-wrap text-[11px] gap-x-3 text-slate-400 mt-1\">\n                  <span>Contract: <strong className=\"text-white font-mono\">\342\202\271{rental.toLocaleString()}</strong></span>\n                  <span>&bull;</span>\n                  <span>Expenses: <strong className=\"text-yellow-500 font-mono\">\342\202\271{(commission + loadingUnloading + officeMamul).toLocaleString()}</strong></span>\n                  <span>&bull;</span>\n                  <span>Advances: <strong className=\"text-cyan-400 font-mono\">\342\202\271{(advance1 + advance2 + advance3).toLocaleString()}</strong></span>\n                </div>\n              </div>\n            </div>\n\n            <div className=\"bg-slate-950/80 border border-slate-800 rounded-xl p-3 px-5 text-right flex flex-col justify-center min-w-[200px]\">\n              <span className=\"text-[10px] text-slate-400 uppercase tracking-widest font-bold\">Outstanding Balance</span>\n              <span className={`text-xl font-bold font-mono tracking-tight ${calculatedLiveBalance > 0 ? \'text-amber-400\' : \'text-emerald-400\'}`}>\n                \342\202\271{calculatedLiveBalance.toLocaleString()}\n              </span>\n            </div>\n          </div>\n\n          {/* FINAL SETTLEMENT DETAILS */}\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-5 border-t border-slate-800 pt-5\">\n            {/* BALANCE SETTLEMENT DATA */}\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-400 mb-1 flex items-center gap-1\">\n                Settlement Date (Balance 1)\n              </label>\n              <input\n                id=\"form-balance-date\"\n                type=\"date\"\n                value={balance1Date}\n                onChange={(e) => setBalance1Date(e.target.value)}\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n\n            {/* BALANCE SETTLED BY ACCOUNT */}\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-400 mb-1\">\n                Settled Account (Balance 1)\n              </label>\n              <select\n                id=\"form-balance-receivedby\"\n                value={balance1ReceivedBy}\n                onChange={(e) => setBalance1ReceivedBy(e.target.value)}\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"\">&mdash; Unsettled &mdash;</option>\n                {activeAccounts.map(ac => (\n                  <option key={ac.id} value={ac.id}>{ac.accountName}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* DYNAMIC TRIP STATUS */}\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-400 mb-1\">\n                Trip Ledger Status\n              </label>\n              <select\n                id=\"form-status\"\n                value={status}\n                onChange={(e) => setStatus(e.target.value as TripStatus)}\n                className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm font-semibold focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"Pending\" className=\"text-slate-400 font-semibold\">Pending (No Advances)</option>\n                <option value=\"In Progress\" className=\"text-amber-400 font-semibold\">In Progress (Active/Advances Paid)</option>\n                <option value=\"Completed\" className=\"text-blue-400 font-semibold\">Completed (On-Road / Goods Delivered)</option>\n                <option value=\"Paid\" className=\"text-emerald-400 font-semibold\">Paid (Settled / Zero Outstanding)</option>\n              </select>\n            </div>\n          </div>\n\n          {/* NOTES AREA */}\n          <div>\n            <label className=\"block text-xs font-semibold text-slate-400 mb-1.5\">Route Remarks / Consignment Notes</label>\n            <textarea\n              id=\"form-notes\"\n              rows={2}\n              placeholder=\"e.g. Coal consignment loaded at Mumbai port. Driver: Jagdish. Delivered on time.\"\n              value={notes}\n              onChange={(e) => setNotes(e.target.value)}\n              className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-indigo-500\"\n            />\n          </div>\n\n          {/* SUBMIT BUTTON ACTIONS */}\n          <div className=\"flex justify-end gap-3 pt-5 border-t border-slate-800\">\n            <button\n              id=\"btn-form-cancel\"\n              type=\"button\"\n              onClick={onClose}\n              className=\"px-5 py-2.5 text-sm font-semibold text-slate-400 hover:text-white transition\"\n            >\n              Cancel\n            </button>\n            <button\n              id=\"btn-form-submit\"\n              type=\"submit\"\n              className=\"bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-sm px-6 py-2.5 rounded-xl shadow-lg shadow-indigo-600/20 transition\"\n            >\n              {editingEntry ? \'Update Trip Entry\' : \'Post Trip Entries\'}\n            </button>\n          </div>\n\n        <"
