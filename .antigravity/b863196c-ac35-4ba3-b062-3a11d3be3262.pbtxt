      target_content: "  return (\n    <div id=\"dashboard-tab\" className=\"space-y-6\">\n      \n      {/* STATS OVERVIEW CARDS */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4\">\n        {/* CONTRACT RENTAL */}\n        <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg flex items-center justify-between\">\n          <div className=\"space-y-1\">\n            <span className=\"text-xs text-slate-400 font-semibold block uppercase tracking-wider\">Gross Rental Volume</span>\n            <span className=\"text-2xl font-bold text-white font-mono leading-tight\">\342\202\271{totalRental.toLocaleString()}</span>\n            <p className=\"text-[10px] text-slate-500\">From {trips.length} registered trips</p>\n          </div>\n          <div className=\"p-3 bg-indigo-500/10 rounded-xl border border-indigo-500/20 text-indigo-400\">\n            <TrendingUp className=\"w-5 h-5\" />\n          </div>\n        </div>\n\n        {/* OUTSTANDING BALANCES */}\n        <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg flex items-center justify-between\">\n          <div className=\"space-y-1\">\n            <span className=\"text-xs text-slate-400 font-semibold block uppercase tracking-wider\">Total Outstanding</span>\n            <span className={`text-2xl font-bold font-mono leading-tight ${totalOutstanding > 0 ? \'text-amber-400\' : \'text-emerald-400\'}`}>\n              \342\202\271{totalOutstanding.toLocaleString()}\n            </span>\n            <p className=\"text-[10px] text-slate-500\">Collectable from broker sheets</p>\n          </div>\n          <div className={`p-3 rounded-xl border ${totalOutstanding > 0 ? \'bg-amber-500/10 border-amber-500/20 text-amber-400\' : \'bg-emerald-50 border-emerald-100 text-emerald-400\'}`}>\n            <AlertCircle className=\"w-5 h-5\" />\n          </div>\n        </div>\n\n        {/* BRK COMMISSION */}\n        <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg flex items-center justify-between\">\n          <div className=\"space-y-1\">\n            <span className=\"text-xs text-slate-400 font-semibold block uppercase tracking-wider\">Brokerage Commission</span>\n            <span className=\"text-2xl font-bold text-slate-100 font-mono leading-tight\">\342\202\271{totalCommission.toLocaleString()}</span>\n            <p className=\"text-[10px] text-slate-500\">{(totalRental > 0 ? ((totalCommission / totalRental) * 100).toFixed(1) : 0)}% of Gross Rental</p>\n          </div>\n          <div className=\"p-3 bg-rose-500/10 rounded-xl border border-rose-500/20 text-rose-400\">\n            <BadgeCent className=\"w-5 h-5\" />\n          </div>\n        </div>\n\n        {/* OPERATIONAL RECOVERY RATE */}\n        <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-5 shadow-lg flex items-center justify-between\">\n          <div className=\"space-y-1\">\n            <span className=\"text-xs text-slate-400 font-semibold block uppercase tracking-wider\">Collection Rate</span>\n            <span className=\"text-2xl font-bold text-emerald-400 font-mono leading-tight\">{validRecoveryRate}%</span>\n            <p className=\"text-[10px] text-slate-500\">Net collected vs net billed</p>\n          </div>\n          <div className=\"p-3 bg-emerald-500/10 rounded-xl border border-emerald-500/20 text-emerald-400\">\n            <CheckCircle2 className=\"w-5 h-5\" />\n          </div>\n        </div>\n      </div>\n\n      {/* MID SECTION CHARTS AND MASTER INSIGHTS */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        \n        {/* COLLECTION RATIO PIE GRAPH */}\n        <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg flex flex-col justify-between\">\n          <div>\n            <h3 className=\"text-sm font-bold text-white uppercase tracking-wider mb-1\">Receipts & Expenses Pipeline</h3>\n            <p className=\"text-xs text-slate-400\">Visual mapping of overall contract capital conversion.</p>\n          </div>\n\n          <div className=\"my-6 flex items-center justify-center relative\">\n            {/* SVG custom gauge representation */}\n            <svg viewBox=\"0 0 100 100\" className=\"w-36 h-36 transform -rotate-90\">\n              <circle cx=\"50\" cy=\"50\" r=\"40\" fill=\"transparent\" stroke=\"#1f2937\" strokeWidth=\"10\" />\n              <circle \n                cx=\"50\" \n                cy=\"50\" \n                r=\"40\" \n                fill=\"transparent\" \n                stroke=\"#10b981\" \n                strokeWidth=\"10\" \n                strokeDasharray={`${2 * Math.PI * 40}`}\n                strokeDashoffset={`${2 * Math.PI * 40 * (1 - validRecoveryRate / 100)}`}\n                className=\"transition-all duration-1000 ease-out\"\n              />\n            </svg>\n            <div className=\"absolute inset-0 flex flex-col items-center justify-center\">\n              <span className=\"text-xl font-bold text-white font-mono\">{validRecoveryRate}%</span>\n              <span className=\"text-[9px] text-slate-400 uppercase font-semibold\">Cleared</span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2 text-xs\">\n            <div className=\"flex justify-between text-slate-300\">\n              <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded-full bg-emerald-500\"></span>Net Capital Collected</span>\n              <span className=\"font-mono text-white\">\342\202\271{(totalAdvances + (totalRental - totalExpenses - totalAdvances - totalOutstanding)).toLocaleString()}</span>\n            </div>\n            <div className=\"flex justify-between text-slate-300\">\n              <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded-full bg-amber-500\"></span>Pending Outstandings</span>\n              <span className=\"font-mono text-white\">\342\202\271{totalOutstanding.toLocaleString()}</span>\n            </div>\n            <div className=\"flex justify-between text-slate-300\">\n              <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded-full bg-rose-500\"></span>Operating Expenses</span>\n              <span className=\"font-mono text-white\">\342\202\271{totalExpenses.toLocaleString()}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* LEDGER ACCOUNTS COLLECTION SPLIT */}\n        <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg flex flex-col justify-between\">\n          <div>\n            <h3 className=\"text-sm font-bold text-white uppercase tracking-wider mb-1\">Receipts by Accounts</h3>\n            <p className=\"text-xs text-slate-400\">Total advances & settlements received into operational accounts.</p>\n          </div>\n\n          <div className=\"my-4 divide-y divide-slate-800/60 overflow-y-auto max-h-[180px] pr-1\">\n            {fundsByAccount.length === 0 ? (\n              <p className=\"text-center py-12 text-xs text-slate-500 italic\">No account transitions logged yet.</p>\n            ) : (\n              fundsByAccount.map(({ accountName, amount }) => {\n                const pct = totalRental > 0 ? Math.round((amount / (totalRental - totalExpenses)) * 100) : 0;\n                return (\n                  <div key={accountName} className=\"py-2.5 flex items-center justify-between gap-4\">\n                    <span className=\"text-xs font-semibold text-slate-300 truncate max-w-[150px]\">{accountName}</span>\n                    <div className=\"flex-1 max-w-[80px]\">\n                      <div className=\"w-full bg-slate-850 h-1.5 rounded-full overflow-hidden\">\n                        <div className=\"bg-indigo-500 h-full rounded-full\" style={{ width: `${Math.min(100, pct)}%` }}></div>\n                      </div>\n                    </div>\n                    <span className=\"text-xs font-mono font-bold text-white text-right\">\342\202\271{amount.toLocaleString()}</span>\n                  </div>\n                );\n              })\n            )}\n          </div>\n\n          <div className=\"text-[10px] text-slate-500 bg-slate-950/40 p-2.5 rounded-lg border border-slate-800 flex items-center gap-2\">\n            <Landmark className=\"w-3.5 h-3.5 text-indigo-400 flex-shrink-0\" />\n            <span>Map accounts to Advance 1, Advance 2, Advance 3 or Balance Received By parameters.</span>\n          </div>\n        </div>\n\n        {/* TOP OUTSTANDING LIABILITIES BY TRUCK */}\n        <div className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-lg flex flex-col justify-between\">\n          <div>\n            <h3 className=\"text-sm font-bold text-white uppercase tracking-wider mb-1\">Balance Risk by Truck</h3>\n            <p className=\"text-xs text-slate-400 font-sans\">Active pending outstandings grouped per truck datasheet reference.</p>\n          </div>\n\n          <div className=\"my-4 divide-y divide-slate-800/60 overflow-y-auto max-h-[180px] pr-1\">\n            {topOutstandingTrucks.length === 0 ? (\n              <p className=\"text-center py-12 text-xs text-slate-500 italic\">Excellent! All truck balances are fully settled.</p>\n            ) : (\n              topOutstandingTrucks.map(({ truckNo, amount }) => (\n                <div key={truckNo} className=\"py-2.5 flex items-center justify-between gap-4\">\n                  <span className=\"text-xs font-bold text-slate-200 uppercase font-mono tracking-wider flex items-center gap-1.5\">\n                    <Navigation className=\"w-3 h-3 text-slate-500 rotate-45\" />\n                    {truckNo}\n                  </span>\n                  <span className=\"text-xs font-mono font-bold text-amber-400 bg-amber-500/10 px-2 py-0.5 rounded\">\n                    \342\202\271{amount.toLocaleString()}\n                  </span>\n                </div>\n              ))\n            )}\n          </div>\n\n          <div className=\"text-[10px] text-slate-500 bg-slate-950/40 p-2.5 rounded-lg border border-slate-800 flex items-center gap-2\">\n            <ShieldAlert className=\"w-3.5 h-3.5 text-amber-500 flex-shrink-0\" />\n            <span>Alert drivers or billing office if a single truck exceeds safety credit limit threshold.</span>\n          </div>\n        </div>\n\n      </div>\n\n      {/* PIE CHART STATS */}\n      <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n        <div className=\"bg-slate-950 border border-slate-800/60 p-4 rounded-xl text-center\">\n          <span className=\"text-[10px] text-slate-400 uppercase font-semibold\">Pending Advances</span>\n          <p className=\"text-lg font-mono font-bold text-slate-200 mt-1\">{pendingCount}</p>\n        </div>\n        <div className=\"bg-slate-950 border border-slate-800/60 p-4 rounded-xl text-center\">\n          <span className=\"text-[10px] text-slate-400 uppercase font-semibold\">Active Transitions</span>\n          <p className=\"text-lg font-mono font-bold text-amber-400 mt-1\">{inProgressCount}</p>\n        </div>\n        <div className=\"bg-slate-950 border border-slate-800/60 p-4 rounded-xl text-center\">\n          <span className=\"text-[10px] text-slate-400 uppercase font-semibold\">Delivered Goods</span>\n          <p className=\"text-lg font-mono font-bold text-blue-400 mt-1\">{completedCount}</p>\n        </div>\n        <div className=\"bg-slate-950 border border-slate-800/60 p-4 rounded-xl text-center\">\n          <span className=\"text-[10px] text-slate-400 uppercase font-semibold\">Settled Trips</span>\n          <p className=\"text-lg font-mono font-bold text-emerald-400 mt-1\">{paidCount}</p>\n        </div>\n      </div>\n\n    </div>"
      replacement_content: "  return (\n    <div id=\"dashboard-tab\" className=\"space-y-6 animate-fade-in\">\n      \n      {/* STATS OVERVIEW CARDS */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6\">\n        {/* CONTRACT RENTAL */}\n        <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-xs flex items-center justify-between transition-all hover:shadow-xs duration-200\">\n          <div className=\"space-y-1\">\n            <span className=\"text-xs text-slate-500 font-bold block uppercase tracking-wider\">Gross Rental Volume</span>\n            <span className=\"text-2xl font-extrabold text-slate-900 font-sans tracking-tight leading-none\">\342\202\271{totalRental.toLocaleString()}</span>\n            <p className=\"text-[10px] text-slate-400 mt-1\">From {trips.length} registered trips</p>\n          </div>\n          <div className=\"p-3 bg-blue-50 rounded-lg border border-blue-100 text-blue-600 shadow-3xs\">\n            <TrendingUp className=\"w-5 h-5\" />\n          </div>\n        </div>\n\n        {/* OUTSTANDING BALANCES */}\n        <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-xs flex items-center justify-between transition-all hover:shadow-xs duration-200\">\n          <div className=\"space-y-1\">\n            <span className=\"text-xs text-slate-500 font-bold block uppercase tracking-wider\">Total Outstanding</span>\n            <span className={`text-2xl font-extrabold font-sans tracking-tight leading-none ${totalOutstanding > 0 ? \'text-red-650 font-bold\' : \'text-emerald-600\'}`}>\n              \342\202\271{totalOutstanding.toLocaleString()}\n            </span>\n            <p className=\"text-[10px] text-slate-400 mt-1\">Collectable from broker sheets</p>\n          </div>\n          <div className={`p-3 rounded-lg border shadow-3xs ${totalOutstanding > 0 ? \'bg-red-50 border-red-100 text-red-600\' : \'bg-emerald-50 border-emerald-100 text-emerald-600\'}