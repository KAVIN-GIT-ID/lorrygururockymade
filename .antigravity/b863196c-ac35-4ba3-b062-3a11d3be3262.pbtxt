        target_content: "  const totalAdvances = trips.reduce((sum, t) => sum + (Number(t.advance1) || 0) + (Number(t.advance2) || 0) + (Number(t.advance3) || 0), 0);\n  \n  const totalOutstanding = trips.reduce((sum, t) => {\n    return sum + calculateBalance(t);\n  }, 0);\n\n  // Status counts\n  const pendingCount = trips.filter(t => t.status === \'Pending\').length;\n  const inProgressCount = trips.filter(t => t.status === \'In Progress\').length;\n  const completedCount = trips.filter(t => t.status === \'Completed\').length;\n  const paidCount = trips.filter(t => t.status === \'Paid\').length;\n\n  // Let\'s obtain the Account Name mapping for easy readability\n  const getAccountName = (id: string) => {\n    return accounts.find(a => a.id === id)?.accountName || id || \'N/A\';\n  };\n\n  // Group accounts receiving funds and sum up their collections\n  const accountFundsMap: { [key: string]: number } = {};\n  trips.forEach(t => {\n    if (t.advance1 > 0 && t.advance1ReceivedBy) {\n      accountFundsMap[t.advance1ReceivedBy] = (accountFundsMap[t.advance1ReceivedBy] || 0) + Number(t.advance1);\n    }\n    if (t.advance2 > 0 && t.advance2ReceivedBy) {\n      accountFundsMap[t.advance2ReceivedBy] = (accountFundsMap[t.advance2ReceivedBy] || 0) + Number(t.advance2);\n    }\n    if (t.advance3 > 0 && t.advance3ReceivedBy) {\n      accountFundsMap[t.advance3ReceivedBy] = (accountFundsMap[t.advance3ReceivedBy] || 0) + Number(t.advance3);\n    }\n    // If balance settled\n    const balAmt = calculateBalance(t);\n    if (balAmt <= 0 && t.balance1ReceivedBy && t.rental > 0) {\n      // Net settlement includes remaining balance settled\n      const netRem = (Number(t.rental) || 0) - (Number(t.commission) || 0) - (Number(t.loadingUnloading) || 0) - (Number(t.officeMamul) || 0) - (Number(t.advance1) || 0) - (Number(t.advance2) || 0) - (Number(t.advance3) || 0);\n      if (netRem > 0) {\n        accountFundsMap[t.balance1ReceivedBy] = (accountFundsMap[t.balance1ReceivedBy] || 0) + netRem;\n      }\n    }\n  });"
        replacement_content: "  const totalAdvances = trips.reduce((sum, t) => sum + (t.payments?.reduce((pSum, p) => pSum + (Number(p.amount) || 0), 0) || 0), 0);\n  \n  const totalOutstanding = trips.reduce((sum, t) => {\n    return sum + calculateBalance(t);\n  }, 0);\n\n  // Status counts\n  const pendingCount = trips.filter(t => t.status === \'Pending\').length;\n  const inProgressCount = trips.filter(t => t.status === \'In Progress\').length;\n  const completedCount = trips.filter(t => t.status === \'Completed\').length;\n  const paidCount = trips.filter(t => t.status === \'Paid\').length;\n\n  // Let\'s obtain the Account Name mapping for easy readability\n  const getAccountName = (id: string) => {\n    return accounts.find(a => a.id === id)?.accountName || id || \'N/A\';\n  };\n\n  // Group accounts receiving funds and sum up their collections\n  const accountFundsMap: { [key: string]: number } = {};\n  trips.forEach(t => {\n    (t.payments || []).forEach(p => {\n      if (p.amount > 0 && p.receivedBy) {\n        accountFundsMap[p.receivedBy] = (accountFundsMap[p.receivedBy] || 0) + Number(p.amount);\n      }\n    });\n  });"
