          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                              className=\"text-rose-600 hover:text-rose-800 hover:underline font-bold text-[11px]\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
