      target_content: "  // Auto-calculate diesel amount dynamically\n  useEffect(() => {\n    setDieselAmount(Math.max(0, Number(dieselLiters) * Number(dieselRate)));\n  }, [dieselLiters, dieselRate]);"
      replacement_content: "  // Auto-calculate diesel amount dynamically only if no fuels array entries exist\n  useEffect(() => {\n    if (fuels.length === 0) {\n      setDieselAmount(Math.max(0, Number(dieselLiters) * Number(dieselRate)));\n    }\n  }, [dieselLiters, dieselRate, fuels]);\n\n  // Synchronize dynamic multi-fuel entries totals\n  useEffect(() => {\n    if (fuels.length > 0) {\n      const totLiters = fuels.reduce((sum, f) => sum + (Number(f.liters) || 0), 0);\n      const totAmount = fuels.reduce((sum, f) => sum + (Number(f.amount) || 0), 0);\n      setDieselLiters(totLiters);\n      setDieselAmount(totAmount);\n      if (totLiters > 0) {\n        setDieselRate(Number((totAmount / totLiters).toFixed(2)));\n      }\n    }\n  }, [fuels]);"
    }
