      original_chunk {
        target_content: "  const showNotification = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => {\n      setToastMessage(null);\n    }, 4000);\n  };\n\n  // --- TRUCK CRUD HANDLERS ---"
        replacement_content: "  const showNotification = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => {\n      setToastMessage(null);\n    }, 4000);\n  };\n\n  // --- DRIVER CRUD HANDLERS ---\n  const handleAddDriver = (driverInput: Omit<Driver, \'id\'>) => {\n    const isDup = drivers.some(d => d.driverName.toUpperCase().trim() === driverInput.driverName.toUpperCase().trim());\n    if (isDup) {\n      alert(\"Driver Name is already registered.\");\n      return;\n    }\n    const d = { ...driverInput, id: \'d_id_\' + Date.now() };\n    saveDrivers([...drivers, d]);\n    showNotification(`Driver ${d.driverName} added successfully.`);\n  };\n\n  const handleUpdateDriver = (updated: Driver) => {\n    const next = drivers.map(d => d.id === updated.id ? updated : d);\n    saveDrivers(next);\n    showNotification(`Driver details updated.`);\n  };\n\n  const handleDeleteDriver = (id: string) => {\n    const dr = drivers.find(d => d.id === id);\n    const inUse = trips.some(tr => tr.driverName === dr?.driverName);\n    if (inUse) {\n      alert(`Cannot delete Driver ${dr?.driverName}. This driver is assigned to historical journeys.`);\n      return;\n    }\n    const next = drivers.filter(d => d.id !== id);\n    saveDrivers(next);\n    showNotification(`Driver deleted from records.`);\n  };\n\n  // --- TRUCK CRUD HANDLERS ---"
      }
      num_matches: 1
    }
  }
}
