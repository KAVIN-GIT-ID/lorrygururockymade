          text: "                      <th className=\"p-3 pl-4\"># Seg</th>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <th className=\"p-3\">Load Date</th>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <th className=\"p-3\">Office Name</th>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <th className=\"p-3\">Route Path</th>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <th className=\"p-3 text-right\">Income (\342\202\271)</th>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <th className=\"p-3 text-right\">Fuel spent (\342\202\271)</th>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      <th className=\"p-3 text-right\">Other EXP (\342\202\271)</th>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
