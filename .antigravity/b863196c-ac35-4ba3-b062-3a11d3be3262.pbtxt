      target_content: "        {/* TOP OUTSTANDING LIABILITIES BY TRUCK */}\n        <div className=\"bg-white border border-slate-200 rounded-xl p-6 shadow-xs flex flex-col justify-between\">\n          <div>\n            <h3 className=\"text-sm font-bold text-slate-800 uppercase tracking-wider mb-1 font-sans\">Outstanding by Truck</h3>\n            <p className=\"text-xs text-slate-500 font-sans\">Active pending outstandings grouped per truck datasheet reference.</p>\n          </div>\n\n          <div className=\"my-4 divide-y divide-slate-100 overflow-y-auto max-h-[180px] pr-1 flex-1\">\n            {topOutstandingTrucks.length === 0 ? (\n              <p className=\"text-center py-12 text-xs text-emerald-600 italic font-medium font-sans\">Excellent! All truck balances are fully settled.</p>\n            ) : (\n              topOutstandingTrucks.map(({ truckNo, amount }) => (\n                <div key={truckNo} className=\"py-2.5 flex items-center justify-between gap-4 font-sans\">\n                  <span className=\"text-xs font-bold text-slate-705 uppercase font-mono tracking-wider flex items-center gap-1.5\">\n                    <Navigation className=\"w-3 h-3 text-slate-400 rotate-45\" />\n                    {truckNo}\n                  </span>\n                  <span className=\"text-xs font-mono font-bold text-red-650 bg-red-50 border border-red-100 px-2 py-0.5 rounded shadow-3xs text-red-650 text-red-600\">\n                    \342\202\271{amount.toLocaleString(\'en-IN\')}\n                  </span>\n                </div>\n              ))\n            )}\n          </div>\n\n          <div className=\"text-[10px] text-slate-500 bg-slate-50 p-2.5 rounded-lg border border-slate-100 flex items-center gap-2 mt-4 shadow-3xs font-sans\">\n            <ShieldAlert className=\"w-3.5 h-3.5 text-amber-500 flex-shrink-0\" />\n            <span>Provides direct oversight over customer-side defaults.</span>\n          </div>\n        </div>"
      replacement_content: "        {/* TOP OUTSTANDING LIABILITIES BY TRUCK */}\n        <div className=\"bg-white border border-slate-200 rounded-xl p-6 shadow-xs flex flex-col justify-between\">\n          <div>\n            <h3 className=\"text-sm font-bold text-slate-800 uppercase tracking-wider mb-1 font-sans\">Outstanding by Truck</h3>\n            <p className=\"text-xs text-slate-500 font-sans\">Active pending outstandings. Hover over a truck to see loading offices, advances, and balances.</p>\n          </div>\n\n          <div className=\"my-4 divide-y divide-slate-100 overflow-visible max-h-[180px] pr-1 flex-1 relative\">\n            {topOutstandingTrucks.length === 0 ? (\n              <p className=\"text-center py-12 text-xs text-emerald-600 italic font-medium font-sans\">Excellent! All truck balances are fully settled.</p>\n            ) : (\n              topOutstandingTrucks.map(({ truckNo, amount }) => {\n                // Find all trips for this truck that are pending/unpaid\n                const activeTrips = trips.filter(t => t.truckNo === truckNo && getTripMetrics(t).outstandingBalance > 0);\n                \n                return (\n                  <div \n                    key={truckNo} \n                    className=\"py-2.5 flex items-center justify-between gap-4 font-sans relative group cursor-help transition-colors hover:bg-slate-50 px-2 rounded-lg\"\n                    onMouseEnter={() => setHoveredTruck(truckNo)}\n                    onMouseLeave={() => setHoveredTruck(null)}\n                  >\n                    <span className=\"text-xs font-bold text-slate-705 uppercase font-mono tracking-wider flex items-center gap-1.5\">\n                      <Navigation className=\"w-3 h-3 text-blue-500 rotate-45\" />\n                      {truckNo}\n                    </span>\n                    <span className=\"text-xs font-mono font-bold text-red-600 bg-red-50 border border-red-100 px-2 py-0.5 rounded shadow-3xs\">\n                      \342\202\271{amount.toLocaleString(\'en-IN\')}\n                    </span>\n\n                    {/* HOVER TOOLTIP FLOATING INSIGHT OVERLAY */}\n                    {hoveredTruck === truckNo && activeTrips.length > 0 && (\n                      <div className=\"absolute right-0 top-full mt-2 md:right-full md:top-0 md:mr-3 md:mt-0 z-50 bg-slate-900 border border-slate-800 text-slate-100 p-4 rounded-xl shadow-xl w-80 text-xs text-left pointer-events-none space-y-3\">\n                        <div className=\"border-b border-slate-800 pb-1.5 flex justify-between items-center\">\n                          <span className=\"font-mono font-bold uppercase tracking-wider text-blue-400 text-[11px]\">{truckNo} Outstanding Dues</span>\n                          <span className=\"text-[10px] text-slate-400 font-semibold\">{activeTrips.length} Active Trip(s)</span>\n                        </div>\n\n                        <div className=\"space-y-3 max-h-[220px] overflow-y-auto divide-y divide-slate-800/60\">\n                          {activeTrips.slice(0, 3).map((tripObj, idx) => {\n                            const tm = getTripMetrics(tripObj);\n                            return (\n                              <div key={tripObj.id || idx} className=\"pt-2 first:pt-0 space-y-1.5\">\n                                <div className=\"flex justify-between items-center text-[10px] font-bold text-slate-400\">\n                                  <span>{tripObj.tripNo}</span>\n                                  <span className=\"font-mono text-slate-500\">{tripObj.startDate}</span>\n                                </div>\n                                \n                                {/* Cargo Segments & Offices info */}\n                                {tripObj.subTrips && tripObj.subTrips.length > 0 ? (\n                                  <div className=\"space-y-1 bg-slate-950 p-1.5 rounded border border-slate-850 text-[10px]\">\n                                    {tripObj.subTrips.map((st, sidx) => (\n                                      <div key={st.id || sidx} className=\"flex flex-col text-[10px] space-y-0.5\">\n                                        <div className=\"flex items-center gap-1 text-slate-300 font-medium font-sans\">\n                                          <MapPin className=\"w-2.5 h-2.5 text-blue-500 shrink-0\" />\n                                          <span className=\"truncate max-w-[120px] font-bold\">{st.officeName}</span>\n                                        </div>\n                                        <div className=\"pl-3.5 text-slate-400 flex items-center justify-between\">\n                                          <span className=\"truncate max-w-[140px]\">{st.routeFrom} \342\236\224 {st.routeTo}</span>\n                                          <span className=\"font-mono text-emerald-400 font-bold whitespace-nowrap\">\342\202\271{st.income.toLocaleString()}</span>\n                                        </div>\n                                      </div>\n                                    ))}\n                                  </div>\n                                ) : (\n                                  <div className=\"text-[10px] text-slate-500 italic\">No cargo legs.</div>\n                                )}\n\n                                {/* Financial overview */}\n                                <div className=\"grid grid-cols-2 gap-1 text-[10px]\">\n                                  <div className=\"bg-slate-950 px-2 py-0.5 rounded\">\n                                    <span className=\"text-slate-500 block\">Total Income</span>\n                                    <span className=\"font-mono font-bold text-slate-300\">\342\202\271{tm.income.toLocaleString()}</span>\n                                  </div>\n                                  <div className=\"bg-slate-950 px-2 py-0.5 rounded\">\n                                    <span className=\"text-slate-500 block\">Advances Received</span>\n                                    <span className=\"font-mono font-bold text-emerald-400\">\342\202\271{tm.paymentsReceived.toLocaleString()}</span>\n                                  </div>\n                                </div>\n\n                                <div className=\"flex justify-between items-center text-[10px] pt-1\">\n                                  <span className=\"text-red-400 font-bold\">Trip Balance:</span>\n                                  <span className=\"font-mono font-bold text-red-400\">\342\202\271{tm.outstandingBalance.toLocaleString()}</span>\n                                </div>\n                              </div>\n                            );\n                          })}\n                          {activeTrips.length > 3 && (\n                            <div className=\"text-[10px] text-slate-500 text-center pt-1.5 italic font-medium\">\n                              + {activeTrips.length - 3} more trips\n                            </div>\n                          )}\n                        </div>\n                      </div>\n                    )}\n                  </div>\n                );\n              })\n            )}\n          </div>\n\n          <div className=\"text-[10px] text-slate-500 bg-slate-50 p-2.5 rounded-lg border border-slate-100 flex items-center gap-2 mt-4 shadow-3xs font-sans\">\n            <ShieldAlert className=\"w-3.5 h-3.5 text-amber-500 flex-shrink-0\" />\n            <span>Provides direct oversight over customer-side defaults.</span>\n          </div>\n        </div>"
    }
