    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Driver } from \'../types\';\nimport { Plus, Edit2, Trash2, User, Phone, FileText, CheckCircle, XCircle } from \'lucide-react\';\n\ninterface DriverMasterProps {\n  drivers: Driver[];\n  onAddDriver: (driver: Omit<Driver, \'id\'>) => void;\n  onUpdateDriver: (driver: Driver) => void;\n  onDeleteDriver: (id: string) => void;\n}\n\nexport default function DriverMaster({ drivers, onAddDriver, onUpdateDriver, onDeleteDriver }: DriverMasterProps) {\n  const [isEditing, setIsEditing] = useState<string | null>(null);\n  const [showAddForm, setShowAddForm] = useState(false);\n\n  // Form States\n  const [driverName, setDriverName] = useState(\'\');\n  const [phone, setPhone] = useState(\'\');\n  const [licenseNo, setLicenseNo] = useState(\'\');\n  const [status, setStatus] = useState<\'Active\' | \'Inactive\'>(\'Active\');\n\n  const resetForm = () => {\n    setDriverName(\'\');\n    setPhone(\'\');\n    setLicenseNo(\'\');\n    setStatus(\'Active\');\n    setIsEditing(null);\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!driverName.trim()) return;\n\n    if (isEditing) {\n      onUpdateDriver({\n        id: isEditing,\n        driverName,\n        phone,\n        licenseNo,\n        status\n      });\n    } else {\n      onAddDriver({\n        driverName,\n        phone,\n        licenseNo,\n        status\n      });\n    }\n    resetForm();\n    setShowAddForm(false);\n  };\n\n  const startEdit = (driver: Driver) => {\n    setIsEditing(driver.id);\n    setDriverName(driver.driverName || \'\');\n    setPhone(driver.phone || \'\');\n    setLicenseNo(driver.licenseNo || \'\');\n    setStatus(driver.status);\n    setShowAddForm(true);\n  };\n\n  return (\n    <div id=\"driver-master-panel\" className=\"bg-white border border-slate-200 rounded-xl p-5 md:p-6 shadow-xs animate-fade-in text-slate-850\">\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6\">\n        <div>\n          <h2 className=\"text-lg font-bold text-slate-800 tracking-tight\">Driver Registry</h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">Manage operator drivers database sheets for transport allocations.</p>\n        </div>\n        <button\n          id=\"btn-add-driver\"\n          onClick={() => {\n            resetForm();\n            setShowAddForm(!showAddForm);\n          }}\n          className=\"flex items-center gap-2 bg-blue-600 hover:bg-blue-750 text-white font-semibold px-4 py-2 rounded-lg transition duration-150 shadow-sm text-xs cursor-pointer\"\n        >\n          {showAddForm ? \'Close Form\' : (\n            <>\n              <Plus className=\"w-3.5 h-3.5\" /> Add New Driver\n            </>\n          )}\n        </button>\n      </div>\n\n      {showAddForm && (\n        <form id=\"driver-form\" onSubmit={handleSubmit} className=\"mb-6 p-4 md:p-5 bg-slate-50 rounded-lg border border-slate-255/70 animate-fade-in\">\n          <h3 className=\"text-xs font-bold text-blue-600 uppercase tracking-wider mb-4\">\n            {isEditing ? \'Modify Driver Specifications\' : \'Register New Driver\'}\n          </h3>\n          <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-650 mb-1\">Driver Name <span className=\"text-red-500\">*</span></label>\n              <div className=\"relative\">\n                <span className=\"absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400\">\n                  <User className=\"w-3.5 h-3.5\" />\n                </span>\n                <input\n                  id=\"input-driver-name\"\n                  type=\"text\"\n                  placeholder=\"e.g. Ramesh Pal\"\n                  value={driverName}\n                  onChange={(e) => setDriverName(e.target.value)}\n                  required\n                  className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg pl-9 pr-3 py-1.5 text-xs focus:outline-none focus:border-blue-500 font-semibold\"\n                />\n              </div>\n            </div>\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-650 mb-1\">Contact Phone</label>\n              <div className=\"relative\">\n                <span className=\"absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400\">\n                  <Phone className=\"w-3.5 h-3.5\" />\n                </span>\n                <input\n                  id=\"input-driver-phone\"\n                  type=\"tel\"\n                  placeholder=\"e.g. 9876543210\"\n                  value={phone}\n                  onChange={(e) => setPhone(e.target.value)}\n                  className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg pl-9 pr-3 py-1.5 text-xs focus:outline-none focus:border-blue-500\"\n                />\n              </div>\n            </div>\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-650 mb-1\">Driving License No.</label>\n              <div className=\"relative\">\n                <span className=\"absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400\">\n                  <FileText className=\"w-3.5 h-3.5\" />\n                </span>\n                <input\n                  id=\"input-driver-license\"\n                  type=\"text\"\n                  placeholder=\"e.g. DL-142018009\"\n                  value={licenseNo}\n                  onChange={(e) => setLicenseNo(e.target.value)}\n                  className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg pl-9 pr-3 py-1.5 text-xs focus:outline-none focus:border-blue-500\"\n                />\n              </div>\n            </div>\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-650 mb-1\">Status</label>\n              <select\n                id=\"select-driver-status\"\n                value={status}\n                onChange={(e) => setStatus(e.target.value as \'Active\' | \'Inactive\')}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-blue-500 font-medium\"\n              >\n                <option value=\"Active\">Active</option>\n                <option value=\"Inactive\">Inactive</option>\n              </select>\n            </div>\n          </div>\n\n          <div className=\"flex justify-end gap-2.5 mt-5 border-t border-slate-200/50 pt-4\">\n            <button\n              id=\"btn-driver-cancel\"\n              type=\"button\"\n              onClick={() => {\n                resetForm();\n                setShowAddForm(false);\n              }}\n              className=\"px-4 py-1.5 border border-slate-200 text-slate-600 rounded-lg hover:bg-slate-100 text-xs font-medium cursor-pointer\"\n            >\n              Cancel\n            </button>\n            <button\n              id=\"btn-driver-submit\"\n              type=\"submit\"\n              className=\"px-4 py-1.5 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 text-xs shadow-xs cursor-pointer\"\n            >\n              {isEditing ? \'Save Changes\' : \'Register Operator\'}\n            </button>\n          </div>\n        </form>\n      )}\n\n      {/* Grid listing */}\n      <div className=\"overflow-x-auto rounded-xl border border-slate-200/60\">\n        <table className=\"w-full text-left border-collapse\">\n          <thead>\n            <tr className=\"bg-slate-50 border-b border-slate-200 text-[10px] uppercase font-bold text-slate-400 tracking-wider\">\n              <th className=\"py-3 px-4 font-bold select-none text-slate-520\">Driver Description</th>\n              <th className=\"py-3 px-4 font-bold\">Driver Phone</th>\n              <th className=\"py-3 px-4 font-bold\">Driving License</th>\n              <th className=\"py-3 px-4 font-bold\">Duty Status</th>\n              <th className=\"py-3 px-4 text-right font-bold\">Actions</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100 text-xs\">\n            {drivers.length === 0 ? (\n              <tr>\n                <td colSpan={5} className=\"py-10 text-center text-slate-400\">\n                  <div className=\"text-slate-350\">No operating drivers registered in system databases.</div>\n                </td>\n              </tr>\n            ) : (\n              drivers.map((driver) => (\n                <tr key={driver.id} className=\"hover:bg-slate-50/50 transition\">\n                  <td className=\"py-3.5 px-4 font-bold text-slate-800\">\n                    <div className=\"flex items-center gap-2.5\">\n                      <div className=\"w-8 h-8 rounded-full bg-blue-50 flex items-center justify-center text-blue-600 text-[11px] font-bold\">\n                        {driver.driverName ? driver.driverName.substring(0, 2).toUpperCase() : \'DR\'}\n                      </div>\n                      <div>\n                        <div className=\"font-bold text-slate-800\">{driver.driverName}</div>\n                        <div className=\"text-[10px] text-slate-400 font-mono mt-0.5\">ID: {driver.id}</div>\n                      </div>\n                    </div>\n                  </td>\n                  <td className=\"py-3.5 px-4 font-medium text-slate-600\">{driver.phone || \'\342\200\224\'}</td>\n                  <td className=\"py-3.5 px-4 font-mono text-slate-600\">{driver.licenseNo || \'\342\200\224\'}</td>\n                  <td className=\"py-3.5 px-4 font-medium\">\n                    {driver.status === \'Active\' ? (\n                      <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-green-50 border border-green-200 text-green-700 text-[10px] font-semibold\">\n                        <CheckCircle className=\"w-2.5 h-2.5\" /> Active on Duty\n                      </span>\n                    ) : (\n                      <span className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-slate-50 border border-slate-200 text-slate-500 text-[10px] font-semibold\">\n                        <XCircle className=\"w-2.5 h-2.5\" /> Off Duty\n                      </span>\n                    )}\n                  </td>\n                  <td className=\"py-3.5 px-4 text-right\">\n                    <div className=\"flex items-center justify-end gap-1.5\">\n                      <button\n                        title=\"Edit specifications\"\n                        onClick={() => startEdit(driver)}\n                        className=\"p-1 px-2 hover:bg-slate-100 rounded text-slate-600 hover:text-slate-900 font-semibold cursor-pointer text-xs flex items-center gap-0.5\"\n                      >\n                        <Edit2 className=\"w-3.5 h-3.5\" /> Edit\n                      </button>\n                      <button\n                        title=\"Archive account\"\n                        onClick={() => onDeleteDriver(driver.id)}\n                        className=\"p-1 px-2 hover:bg-red-50 text-red-500 hover:text-red-700 rounded font-semibold cursor-pointer text-xs flex items-center gap-0.5\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" /> Delete\n                      </button>\n                    </div>\n                  </td>\n                </tr>\n              ))\n            )}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  );\n}"
    }
