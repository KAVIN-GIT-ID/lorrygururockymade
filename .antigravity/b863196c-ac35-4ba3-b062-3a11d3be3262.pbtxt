  file_change {
    absolute_path_uri: "file:///src/App.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  // Find all distinct ongoing trip numbers to populate join options\n  const existingTripNosList = Array.from(new Set(trips.map(t => t.tripNo))).sort().reverse() as string[];\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans select-none selection:bg-indigo-600/30\">\n      \n      {/* GLOBAL TOAST BANNER */}\n      {toastMessage && (\n        <div id=\"toast-notify\" className=\"fixed bottom-5 right-5 z-50 bg-indigo-900 border border-indigo-500/50 text-white p-3.5 px-6 rounded-xl shadow-2xl flex items-center gap-2.5 animate-bounce\">\n          <CheckCircle className=\"w-4 h-4 text-indigo-400\" />\n          <span className=\"text-xs font-semibold\">{toastMessage}</span>\n        </div>\n      )}\n\n      {/* TOP DECORATIVE HEADERBAR */}\n      <header className=\"bg-slate-900 border-b border-slate-800 px-6 py-4 sticky top-0 z-40\">\n        <div className=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-4\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"bg-indigo-600/10 border border-indigo-500/30 p-2.5 rounded-2xl text-indigo-400 shadow-inner\">\n              <FileSpreadsheet className=\"w-6 h-6\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"text-xl font-black text-white tracking-tight font-sans\">Truck Trip Tracker</h1>\n                <span className=\"bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[10px] px-2 py-0.5 rounded font-bold uppercase tracking-wider\">SECURE LOCAL</span>\n              </div>\n              <p className=\"text-slate-400 text-xs mt-0.5\">Automate and consolidate multi-item cargo logs, commissions, advances & ledgers.</p>\n            </div>\n          </div>\n\n          {/* UTILITY BAR FOR BACKUPS AND SYSTEM STATE */}\n          <div className=\"flex items-center gap-2.5 self-stretch md:self-auto\">\n            \n            {/* INJECT SEEDS */}\n            <button\n              id=\"btn-reseed\"\n              onClick={triggerInjectFreshSeeds}\n              title=\"Reset Database to Seed Models\"\n              className=\"p-2 bg-slate-800 hover:bg-slate-750 text-slate-400 hover:text-white rounded-xl transition border border-slate-705/80 text-xs flex items-center gap-1.5\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5\" /> Seeding\n            </button>\n\n            {/* DOWNLOAD DATABASE BACKUP */}\n            <button\n              id=\"btn-backup-download\"\n              onClick={handleTriggerDownloadBackup}\n              title=\"Download Snapshot Backup File (.json)\"\n              className=\"p-2 bg-slate-800 hover:bg-slate-755 text-slate-400 hover:text-indigo-300 rounded-xl transition border border-slate-705/80 text-xs flex items-center gap-1.5\"\n            >\n              <Download className=\"w-3.5 h-3.5\" /> Backup\n            </button>\n\n            {/* UPLOAD RESTORE */}\n            <label className=\"p-2 bg-slate-800 hover:bg-slate-755 text-slate-400 hover:text-indigo-300 rounded-xl transition border border-slate-705/80 text-xs flex items-center gap-1.5 cursor-pointer\">\n              <Upload className=\"w-3.5 h-3.5\" /> Restore\n              <input \n                id=\"file-restore-input\"\n                type=\"file\" \n                accept=\".json\" \n                onChange={handleUploadBackupChange} \n                className=\"hidden\" \n              />\n            </label>\n\n            {/* QUICK BOOKING TRIGGER */}\n            <button\n              id=\"btn-quick-post-trip\"\n              onClick={() => {\n                // Safeguard if master records are empty\n                if (trucks.length === 0 || offices.length === 0) {\n                  alert(\"Hold on! Register Trucks and Offices in their master sheets before booking cargo entries.\");\n                  return;\n                }\n                setEditingTrip(null);\n                setBookingModalOpen(true);\n              }}\n              className=\"flex-1 md:flex-none flex items-center justify-center gap-1.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-4 py-2 rounded-xl text-xs transition duration-150 shadow-lg shadow-indigo-600/30\"\n            >\n              <Plus className=\"w-3.5 h-3.5\" /> Post Entry\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* TABS SELECT NAVIGATION UTILITY */}\n      <nav id=\"app-nav-bar\" className=\"bg-slate-905 border-b border-slate-800 px-6\">\n        <div className=\"max-w-7xl mx-auto flex gap-1 h-12\">\n          \n          {/* DASHBOARD TAB */}\n          <button\n            id=\"tab-btn-dashboard\"\n            onClick={() => setActiveTab(\'DASHBOARD\')}\n            className={`px-5 py-2.5 text-xs font-bold transition flex items-center gap-2 border-b-2 ${\n              activeTab === \'DASHBOARD\' \n                ? \'border-indigo-500 text-indigo-400 bg-slate-900/40\' \n                : \'border-transparent text-slate-400 hover:text-white\'\n            }`}\n          >\n            <BarChart3 className=\"w-4 h-4\" /> Operations Dashboard\n          </button>\n\n          {/* TRIPS TAB */}\n          <button\n            id=\"tab-btn-trips\"\n            onClick={() => setActiveTab(\'TRIPS\')}\n            className={`px-5 py-2.5 text-xs font-bold transition flex items-center gap-2 border-b-2 ${\n              activeTab === \'TRIPS\' \n                ? \'border-indigo-500 text-indigo-400 bg-slate-900/40\' \n                : \'border-transparent text-slate-400 hover:text-white\'\n            }`}\n          >\n            <BookOpen className=\"w-4 h-4\" /> Trip Journal Records\n          </button>\n\n          {/* TRUCKS MASTER TAB */}\n          <button\n            id=\"tab-btn-trucks\"\n            onClick={() => setActiveTab(\'TRUCKS\')}\n            className={`px-5 py-2.5 text-xs font-bold transition flex items-center gap-2 border-b-2 ${\n              activeTab === \'TRUCKS\' \n                ? \'border-indigo-500 text-indigo-400 bg-slate-900/40\' \n                : \'border-transparent text-slate-400 hover:text-white\'\n            }`}\n          >\n            <TruckIcon className=\"w-4 h-4\" /> Truck Datasheet\n          </button>\n\n          {/* OFFICES MASTER TAB */}\n          <button\n            id=\"tab-btn-offices\"\n            onClick={() => setActiveTab(\'OFFICES\')}\n            className={`px-5 py-2.5 text-xs font-bold transition flex items-center gap-2 border-b-2 ${\n              activeTab === \'OFFICES\' \n                ? \'border-indigo-500 text-indigo-400 bg-slate-900/40\' \n                : \'border-transparent text-slate-400 hover:text-white\'\n            }`}\n          >\n            <MapPin className=\"w-4 h-4\" /> Office Datasheet\n          </button>\n\n          {/* ACCOUNTS SELECTION TAB */}\n          <button\n            id=\"tab-btn-accounts\"\n            onClick={() => setActiveTab(\'ACCOUNTS\')}\n            className={`px-5 py-2.5 text-xs font-bold transition flex items-center gap-2 border-b-2 ${\n              activeTab === \'ACCOUNTS\' \n                ? \'border-indigo-500 text-indigo-400 bg-slate-900/40\' \n                : \'border-transparent text-slate-400 hover:text-white\'\n            }`}\n          >\n            <Coins className=\"w-4 h-4\" /> Mapped Ledgers\n          </button>\n\n        </div>\n      </nav>\n\n      {/* CORE VIEWPORT CAROUSEL */}\n      <main id=\"app-viewport-container\" className=\"flex-1 max-w-7xl w-full mx-auto p-6 space-y-6\">\n        \n        {/* WARNING BAR IF MASTERS INACTIVE */}\n        {(trucks.length === 0 || offices.length === 0 || accounts.length === 0) && (\n          <div id=\"safety-warning-banner\" className=\"bg-amber-950/20 border border-amber-600/20 p-4 rounded-xl flex items-center gap-3 animate-pulse\">\n            <AlertCircle className=\"w-5 h-5 text-amber-500 flex-shrink-0\" />\n            <div className=\"text-xs\">\n              <p className=\"font-semibold text-amber-400\">Prerequisites Required</p>\n              <p className=\"text-slate-400 mt-1 leading-relaxed\">\n                Before recording any transaction logs, ensure you register at least <strong>1 operational Truck</strong>, <strong>1 active branch Office</strong>, and <strong>1 receiving Account Ledger</strong>. Go to their respective master database tabs above to populate the datasheets first.\n              </p>\n            </div>\n          </div>\n        )}\n\n        {/* TAB RENDERING CONTROLS */}\n        {activeTab === \'DASHBOARD\' && (\n          <Dashboard \n            trips={trips} \n            trucks={trucks} \n            offices={offices} \n            accounts={accounts} \n          />\n        )}\n\n        {activeTab === \'TRIPS\' && (\n          <TripList\n            trips={trips}\n            trucks={trucks}\n            offices={offices}\n            accounts={accounts}\n            onEditEntry={handleEditTripTrigger}\n            onDeleteEntry={handleDeleteTripEntry}\n          />\n        )}\n\n        {activeTab === \'TRUCKS\' && (\n          <TruckMaster\n            trucks={trucks}\n            onAddTruck={handleAddTruck}\n            onUpdateTruck={handleUpdateTruck}\n            onDeleteTruck={handleDeleteTruck}\n          />\n        )}\n\n        {activeTab === \'OFFICES\' && (\n          <OfficeMaster\n            offices={offices}\n            onAddOffice={handleAddOffice}\n            onUpdateOffice={handleUpdateOffice}\n            onDeleteOffice={handleDeleteOffice}\n          />\n        )}\n\n        {activeTab === \'ACCOUNTS\' && (\n          <AccountMaster\n            accounts={accounts}\n            onAddAccount={handleAddAccount}\n            onUpdateAccount={handleUpdateAccount}\n            onDeleteAccount={handleDeleteAccount}\n          />\n        )}\n\n      </main>\n\n      {/* DYNAMIC FORM MODAL BINDERS */}\n      <TripForm\n        isOpen={bookingModalOpen}\n        onClose={() => {\n          setBookingModalOpen(false);\n          setEditingTrip(null);\n        }}\n        trucks={trucks}\n        offices={offices}\n        accounts={accounts}\n        existingTripNos={existingTripNosList}\n        onSubmit={handlePostTripEntry}\n        editingEntry={editingTrip}\n      />\n\n      {/* FOOTER */}\n      <footer className=\"bg-slate-900/60 border-t border-slate-800/80 py-4 px-6 text-center text-[10.5px] text-slate-500 font-sans mt-auto\">\n        <div className=\"max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2\">\n          <span>Truck Trip Tracker Portfolio &bull; Dedicated Client-Side Ledger</span>\n          <span className=\"font-mono text-[9px] text-slate-600\">Local Storage Active \342\200\242 High-Fidelity Logistics UI</span>\n        </div>\n      </footer>\n\n    </div>\n  );\n}"
      replacement_content: "  return (\n    <div className=\"min-h-screen bg-slate-50 text-slate-800 flex flex-col md:flex-row font-sans select-none selection:bg-blue-600/10\">\n      \n      {/* GLOBAL TOAST BANNER */}\n      {toastMessage && (\n        <div id=\"toast-notify\" className=\"fixed bottom-5 right-5 z-50 bg-blue-600 border border-blue-400/30 text-white p-3.5 px-6 rounded-xl shadow-2xl flex items-center gap-2.5 animate-bounce\">\n          <CheckCircle className=\"w-4 h-4 text-white\" />\n          <span className=\"text-xs font-semibold\">{toastMessage}</span>\n        </div>\n      )}\n\n      {/* Sidebar Navigation */}\n      <aside className=\"w-full md:w-64 bg-slate-900 flex flex-col border-b md:border-b-0 md:border-r border-slate-800 shrink-0\">\n        <div className=\"p-6\">\n          <div className=\"flex items-center gap-3 mb-8 text-white font-bold text-xl\">\n            <div className=\"w-8 h-8 bg-blue-600 rounded flex items-center justify-center\">\n              <svg className=\"w-5 h-5 text-white\" fill=\"none\" stroke=\"currentColor\" viewBox=\"0 0 24 24\">\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z\"></path>\n                <path strokeLinecap=\"round\" strokeLinejoin=\"round\" strokeWidth=\"2\" d=\"M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 00-1 1v1h2v-1a1 1 0 00-1-1z\"></path>\n              </svg>\n            </div>\n            <span>FleetTrack Pro</span>\n          </div>\n\n          <nav className=\"space-y-1\">\n            <button\n              id=\"tab-btn-dashboard\"\n              onClick={() => setActiveTab(\'DASHBOARD\')}\n              className={`w-full flex items-center gap-3 px-3 py-2 text-left text-sm transition-all rounded-lg font-medium duration-150 ${\n                activeTab === \'DASHBOARD\' \n                  ? \'bg-blue-600/10 text-blue-400 font-semibold\' \n                  : \'text-slate-400 hover:text-white hover:bg-slate-800/40\'\n              }`}\n            >\n              <BarChart3 className=\"w-4 h-4\" />\n              <span>Dashboard</span>\n            </button>\n            <button\n              id=\"tab-btn-trips\"\n              onClick={() => setActiveTab(\'TRIPS\')}\n              className={`w-full flex items-center gap-3 px-3 py-2 text-left text-sm transition-all rounded-lg font-medium duration-150 ${\n                activeTab === \'TRIPS\' \n                  ? \'bg-blue-600/10 text-blue-400 font-semibold\' \n                  : \'text-slate-400 hover:text-white hover:bg-slate-800/40\'\n              }`}\n            >\n              <BookOpen className=\"w-4 h-4\" />\n              <span>Trip Management</span>\n            </button>\n            <button\n              id=\"tab-btn-trucks\"\n              onClick={() => setActiveTab(\'TRUCKS\')}\n              className={`w-full flex items-center gap-3 px-3 py-2 text-left text-sm transition-all rounded-lg font-medium duration-150 ${\n                activeTab === \'TRUCKS\' \n                  ? \'bg-blue-600/10 text-blue-400 font-semibold\' \n                  : \'text-slate-400 hover:text-white hover:bg-slate-800/40\'\n              }`}\n            >\n              <TruckIcon className=\"w-4 h-4\" />\n              <span>Truck Registry</span>\n            </button>\n            <button\n              id=\"tab-btn-offices\"\n              onClick={() => setActiveTab(\'OFFICES\')}\n              className={`w-full flex items-center gap-3 px-3 py-2 text-left text-sm transition-all rounded-lg font-medium duration-150 ${\n                activeTab === \'OFFICES\' \n                  ? \'bg-blue-600/10 text-blue-400 font-semibold\' \n                  : \'text-slate-400 hover:text-white hover:bg-slate-800/40\'\n              }`}\n            >\n              <MapPin className=\"w-4 h-4\" />\n              <span>Offices</span>\n            </button>\n            <button\n              id=\"tab-btn-accounts\"\n              onClick={() => setActiveTab(\'ACCOUNTS\')}\n              className={`w-full flex items-center gap-3 px-3 py-2 text-left text-sm transition-all rounded-lg font-medium duration-150 ${\n                activeTab === \'ACCOUNTS\' \n                  ? \'bg-blue-600/10 text-blue-400 font-semibold\' \n                  : \'text-slate-400 hover:text-white hover:bg-slate-800/40\'\n              }`}\n            >\n              <Coins className=\"w-4 h-4\" />\n              <span>Account Ledger</span>\n            </button>\n          </nav>\n        </div>\n        <div className=\"mt-auto p-6 bg-slate-950\">\n          <div className=\"text-[10px] text-slate-500 uppercase tracking-wider mb-1 px-1\">Logged in as</div>\n          <div className=\"text-sm text-slate-200 font-semibold flex items-center gap-2 px-1\">\n            <span className=\"w-2 h-2 bg-green-500 rounded-full animate-pulse shrink-0\"></span>\n            <span>Logistics Admin</span>\n          </div>\n        </div>\n      </aside>\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 flex flex-col min-h-0 bg-slate-50 overflow-hidden\">\n        \n        {/* Header */}\n        <header className=\"h-auto md:h-16 bg-white border-b border-slate-200 flex flex-col sm:flex-row items-center justify-between px-6 md:px-8 py-3 md:py-0 gap-3 shrink-0 shadow-xs\">\n          <div className=\"flex items-center gap-4 self-stretch sm:self-auto\">\n            <h1 className=\"text-xl font-bold text-slate-800 tracking-tight\">\n              {activeTab === \'DASHBOARD\' && \'Operations Dashboard\'}\n              {activeTab === \'TRIPS\' && \'Manage Active Trips\'}\n              {activeTab === \'TRUCKS\' && \'Truck Datasheet\'}\n              {activeTab === \'OFFICES\' && \'Office Branch Directory\'}\n              {activeTab === \'ACCOUNTS\' && \'Mapped Account Ledgers\'}\n            </h1>\n            <span className=\"px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600 text-xs font-semibold border border-slate-200 shadow-2xs\">\n              {activeTab === \'TRIPS\' && `${trips.length} Total Trips`}\n              {activeTab === \'TRUCKS\' && `${trucks.length} Trucks`}\n              {activeTab === \'OFFICES\' && `${offices.length} Offices`}\n              {activeTab === \'ACCOUNTS\' && `${accounts.length} Ledgers`}\n              {activeTab === \'DASHBOARD\' && `${trips.length} Load Segments`}\n            </span>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-2 w-full sm:w-auto self-stretch sm:self-auto justify-end\">\n            \n            {/* RESET SEED MODELS */}\n            <button\n              id=\"btn-reseed\"\n              onClick={triggerInjectFreshSeeds}\n              title=\"Reset Database to Seed Models\"\n              className=\"p-1.5 md:p-2 bg-white hover:bg-slate-50 text-slate-700 rounded-lg transition border border-slate-200 text-xs flex items-center gap-1 font-medium shadow-2xs cursor-pointer\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5 text-slate-400\" /> Seeding\n            </button>\n\n            {/* DOWNLOAD DATABASE BACKUP */}\n            <button\n              id=\"btn-backup-download\"\n              onClick={handleTriggerDownloadBackup}\n              title=\"Download Snapshot Backup File (.json)\"\n              className=\"p-1.5 md:p-2 bg-white hover:bg-slate-50 text-slate-705 rounded-lg transition border border-slate-200 text-xs flex items-center gap-1 font-medium shadow-2xs cursor-pointer\"\n            >\n              <Download className=\"w-3.5 h-3.5 text-slate-400\" /> Backup\n            </button>\n\n            {/* UPLOAD RESTORE */}\n            <label className=\"p-1.5 md:p-2 bg-white hover:bg-slate-50 text-slate-705 rounded-lg transition border border-slate-200 text-xs flex items-center gap-1 font-medium shadow-2xs cursor-pointer\">\n              <Upload className=\"w-3.5 h-3.5 text-slate-400\" /> Restore\n              <input \n                id=\"file-restore-input\"\n                type=\"file\" \n                accept=\".json\" \n                onChange={handleUploadBackupChange} \n                className=\"hidden\" \n              />\n            </label>\n\n            <button\n              id=\"btn-quick-post-trip\"\n              onClick={() => {\n                // Safeguard if master records are empty\n                if (trucks.length === 0 || offices.length === 0) {\n                  alert(\"Hold on! Register Trucks and Offices in their master sheets before booking cargo entries.\");\n                  return;\n                }\n                setEditingTrip(null);\n                setBookingModalOpen(true);\n              }}\n              className=\"bg-blue-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-blue-700 shadow-sm flex items-center gap-1.5 transition-colors\"\n            >\n              <Plus className=\"w-4 h-4\" /> New Entry\n            </button>\n          </div>\n        </header>\n\n        {/* Outer content container */}\n        <div id=\"app-viewport-container\" className=\"flex-1 overflow-auto p-6 md:p-8 space-y-6\">\n          \n          {/* WARNING BAR IF MASTERS INACTIVE */}\n          {(trucks.length === 0 || offices.length === 0 || accounts.length === 0) && (\n            <div id=\"safety-warning-banner\" className=\"bg-amber-50 border border-amber-200 p-4 rounded-xl flex items-start gap-3 shadow-xs\">\n              <AlertCircle className=\"w-5 h-5 text-amber-600 flex-shrink-0 mt-0.5\" />\n              <div className=\"text-xs\">\n                <p className=\"font-bold text-amber-800\">Prerequisites Required</p>\n                <p className=\"text-slate-600 mt-1 leading-relaxed\">\n                  Before recording any transaction logs, ensure you register at least <strong>1 operational Truck</strong>, <strong>1 active branch Office</strong>, and <strong>1 receiving Account Ledger</strong>. Go to their respective master database tabs above to populate the datasheets first.\n                </p>\n              </div>\n            </div>\n          )}\n\n          {/* TAB RENDERING CONTROLS */}\n          {activeTab === \'DASHBOARD\' && (\n            <Dashboard \n              trips={trips} \n              trucks={trucks} \n              offices={offices} \n              accounts={accounts} \n            />\n          )}\n\n          {activeTab === \'TRIPS\' && (\n            <TripList\n              trips={trips}\n              trucks={trucks}\n              offices={offices}\n              accounts={accounts}\n              onEditEntry={handleEditTripTrigger}\n              onDeleteEntry={handleDeleteTripEntry}\n            />\n          )}\n\n          {activeTab === \'TRUCKS\' && (\n            <TruckMaster\n              trucks={trucks}\n              onAddTruck={handleAddTruck}\n              onUpdateTruck={handleUpdateTruck}\n              onDeleteTruck={handleDeleteTruck}\n            />\n          )}\n\n          {activeTab === \'OFFICES\' && (\n            <OfficeMaster\n              offices={offices}\n              onAddOffice={handleAddOffice}\n              onUpdateOffice={handleUpdateOffice}\n              onDeleteOffice={handleDeleteOffice}\n            />\n          )}\n\n          {activeTab === \'ACCOUNTS\' && (\n            <AccountMaster\n              accounts={accounts}\n              onAddAccount={handleAddAccount}\n              onUpdateAccount={handleUpdateAccount}\n              onDeleteAccount={handleDeleteAccount}\n            />\n          )}\n\n        </div>\n      </main>\n\n      {/* DYNAMIC FORM MODAL BINDERS */}\n      <TripForm\n        isOpen={bookingModalOpen}\n        onClose={() => {\n          setBookingModalOpen(false);\n          setEditingTrip(null);\n        }}\n        trucks={trucks}\n        offices={offices}\n        accounts={accounts}\n        existingTripNos={existingTripNosList}\n        onSubmit={handlePostTripEntry}\n        editingEntry={editingTrip}\n      />\n\n    </div>\n  );\n}"
    }
