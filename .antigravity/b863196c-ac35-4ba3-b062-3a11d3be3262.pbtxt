      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { Truck, Office, Account, TripEntry, calculateBalance } from \'./types\';\nimport Dashboard from \'./components/Dashboard\';\nimport TripList from \'./components/TripList\';\nimport TripForm from \'./components/TripForm\';\nimport TruckMaster from \'./components/TruckMaster\';\nimport OfficeMaster from \'./components/OfficeMaster\';\nimport AccountMaster from \'./components/AccountMaster\';\nimport { \n  BarChart3, \n  Plus, \n  BookOpen, \n  Truck as TruckIcon, \n  MapPin, \n  Coins, \n  Download, \n  Upload, \n  RefreshCw, \n  CheckCircle,\n  HelpCircle,\n  FileSpreadsheet\n} from \'lucide-react\';\n\n// STABLE INITIAL DATA SEEDING TO DELIVER OUT-OF-THE-BOX POLISHED EXPERIENCE\nconst SEED_TRUCKS: Truck[] = [\n  { id: \'t1\', truckNo: \'MH-12-PQ-4532\', ownerName: \'Sakthi Transport\', driverName: \'Jagdish Singh\', phone: \'9876543210\', status: \'Active\' },\n  { id: \'t2\', truckNo: \'KA-51-AB-9876\', ownerName: \'Aero Freight Ltd\', driverName: \'Mahesh Kumar\', phone: \'8123456789\', status: \'Active\' },\n  { id: \'t3\', truckNo: \'TN-30-XY-5544\', ownerName: \'Meenakshi Cargo\', driverName: \'K. Ranganathan\', phone: \'9443215566\', status: \'Active\' },\n  { id: \'t4\', truckNo: \'HR-55-CK-1122\', ownerName: \'Royal Logistics\', driverName: \'Harpreet Singh\', phone: \'9910293847\', status: \'Active\' }\n];\n\nconst SEED_OFFICES: Office[] = [\n  { id: \'o1\', officeName: \'Mumbai Port Logistics\', city: \'Mumbai\', contactPerson: \'S. K. Sharma\', phone: \'022-2435671\', status: \'Active\' },\n  { id: \'o2\', officeName: \'Bangalore Cargo Corp\', city: \'Bangalore\', contactPerson: \'K. Reddy\', phone: \'080-4927510\', status: \'Active\' },\n  { id: \'o3\', officeName: \'Chennai Roadways Branch\', city: \'Chennai\', contactPerson: \'R. Chidambaram\', phone: \'044-2834012\', status: \'Active\' },\n  { id: \'o4\', officeName: \'Delhi Transporthub\', city: \'Delhi\', contactPerson: \'Amit Gupta\', phone: \'011-4560123\', status: \'Active\' }\n];\n\nconst SEED_ACCOUNTS: Account[] = [\n  { id: \'a1\', accountName: \'Sree Manager GPay\', type: \'Digital Wallets\', holderName: \'Sree Kumar (Ops)\', status: \'Active\' },\n  { id: \'a2\', accountName: \'HDFC Bank Corporate\', type: \'Bank\', holderName: \'PRASATH TRADING CO\', status: \'Active\' },\n  { id: \'a3\', accountName: \'Office Petty Cash Bar\', type: \'Cash\', holderName: \'Cash counter\', status: \'Active\' },\n  { id: \'a4\', accountName: \'SBI Mumbai Current\', type: \'Bank\', holderName: \'Sakthi Shipping\', status: \'Active\' }\n];\n\nconst SEED_TRIPS: TripEntry[] = [\n  {\n    id: \'tr1\',\n    tripNo: \'TRIP-2026-0001\',\n    truckNo: \'MH-12-PQ-4532\',\n    officeName: \'Mumbai Port Logistics\',\n    rental: 45000,\n    loadingDate: \'2026-05-10\',\n    commission: 1500,\n    loadingUnloading: 800,\n    officeMamul: 400,\n    advance1: 15000,\n    advance1Date: \'2026-05-10\',\n    advance1ReceivedBy: \'a1\',\n    advance2: 10000,\n    advance2Date: \'2026-05-12\',\n    advance2ReceivedBy: \'a3\',\n    advance3: 5000,\n    advance3Date: \'2026-05-14\',\n    advance3ReceivedBy: \'a1\',\n    balance: 12300, \n    balance1Date: \'\',\n    balance1ReceivedBy: \'\',\n    status: \'In Progress\',\n    notes: \'Primary steel load. Heavy cargo. Secured via Sree Manager GPay.\'\n  },\n  {\n    id: \'tr2\',\n    tripNo: \'TRIP-2026-0001\', // Notice: shared trip number!\n    truckNo: \'MH-12-PQ-4532\',\n    officeName: \'Delhi Transporthub\',\n    rental: 15000,\n    loadingDate: \'2026-05-11\',\n    commission: 500,\n    loadingUnloading: 300,\n    officeMamul: 100,\n    advance1: 10000,\n    advance1Date: \'2026-05-11\',\n    advance1ReceivedBy: \'a3\',\n    advance2: 4100,\n    advance2Date: \'2026-05-13\',\n    advance2ReceivedBy: \'a2\',\n    advance3: 0,\n    advance3Date: \'\',\n    advance3ReceivedBy: \'\',\n    balance: 0,\n    balance1Date: \'2026-05-15\',\n    balance1ReceivedBy: \'a2\',\n    status: \'Paid\',\n    notes: \'Secondary return load. Associated to TRIP-2026-0001 to balance back.\'\n  },\n  {\n    id: \'tr3\',\n    tripNo: \'TRIP-2026-0002\',\n    truckNo: \'KA-51-AB-9876\',\n    officeName: \'Bangalore Cargo Corp\',\n    rental: 62000,\n    loadingDate: \'2026-05-18\',\n    commission: 2500,\n    loadingUnloading: 1200,\n    officeMamul: 600,\n    advance1: 25000,\n    advance1Date: \'2026-05-18\',\n    advance1ReceivedBy: \'a4\',\n    advance2: 15000,\n    advance2Date: \'2026-05-20\',\n    advance2ReceivedBy: \'a4\',\n    advance3: 10000,\n    advance3Date: \'2026-05-22\',\n    advance3ReceivedBy: \'a1\',\n    balance: 7700,\n    balance1Date: \'\',\n    balance1ReceivedBy: \'\',\n    status: \'In Progress\',\n    notes: \'Electronics consignment from Bangalore warehouse. High value.\'\n  }\n];\n\nexport default function App() {\n  // Navigation / Tabs State\n  const [activeTab, setActiveTab] = useState<\'DASHBOARD\' | \'TRIPS\' | \'TRUCKS\' | \'OFFICES\' | \'ACCOUNTS\'>(\'DASHBOARD\');\n  \n  // Data States\n  const [trucks, setTrucks] = useState<Truck[]>([]);\n  const [offices, setOffices] = useState<Office[]>([]);\n  const [accounts, setAccounts] = useState<Account[]>([]);\n  const [trips, setTrips] = useState<TripEntry[]>([]);\n  \n  // Form modal controller states\n  const [bookingModalOpen, setBookingModalOpen] = useState(false);\n  const [editingTrip, setEditingTrip] = useState<TripEntry | null>(null);\n\n  // Notifications systems\n  const [toastMessage, setToastMessage] = useState<string | null>(null);\n\n  // Fetch from localStorage or inject SEEDS\n  useEffect(() => {\n    try {\n      const storedTrucks = localStorage.getItem(\'ttt_trucks\');\n      const storedOffices = localStorage.getItem(\'ttt_offices\');\n      const storedAccounts = localStorage.getItem(\'ttt_accounts\');\n      const storedTrips = localStorage.getItem(\'ttt_trips\');\n\n      if (storedTrucks) setTrucks(JSON.parse(storedTrucks));\n      else {\n        setTrucks(SEED_TRUCKS);\n        localStorage.setItem(\'ttt_trucks\', JSON.stringify(SEED_TRUCKS));\n      }\n\n      if (storedOffices) setOffices(JSON.parse(storedOffices));\n      else {\n        setOffices(SEED_OFFICES);\n        localStorage.setItem(\'ttt_offices\', JSON.stringify(SEED_OFFICES));\n      }\n\n      if (storedAccounts) setAccounts(JSON.parse(storedAccounts));\n      else {\n        setAccounts(SEED_ACCOUNTS);\n        localStorage.setItem(\'ttt_accounts\', JSON.stringify(SEED_ACCOUNTS));\n      }\n\n      if (storedTrips) setTrips(JSON.parse(storedTrips));\n      else {\n        setTrips(SEED_TRIPS);\n        localStorage.setItem(\'ttt_trips\', JSON.stringify(SEED_TRIPS));\n      }\n    } catch (err) {\n      console.error(\'Failed to load storage values, resetting to seeds.\', err);\n    }\n  }, []);\n\n  // Sync to database triggers\n  const saveTrucks = (newTrucks: Truck[]) => {\n    setTrucks(newTrucks);\n    localStorage.setItem(\'ttt_trucks\', JSON.stringify(newTrucks));\n  };\n\n  const saveOffices = (newOffices: Office[]) => {\n    setOffices(newOffices);\n    localStorage.setItem(\'ttt_offices\', JSON.stringify(newOffices));\n  };\n\n  const saveAccounts = (newAccounts: Account[]) => {\n    setAccounts(newAccounts);\n    localStorage.setItem(\'ttt_accounts\', JSON.stringify(newAccounts));\n  };\n\n  const saveTrips = (newTrips: TripEntry[]) => {\n    setTrips(newTrips);\n    localStorage.setItem(\'ttt_trips\', JSON.stringify(newTrips));\n  };\n\n  const showNotification = (msg: string) => {\n    setToastMessage(msg);\n    setTimeout(() => {\n      setToastMessage(null);\n    }, 4000);\n  };\n\n  // --- TRUCK CRUD HANDLERS ---\n  const handleAddTruck = (truckInput: Omit<Truck, \'id\'>) => {\n    const isDup = trucks.some(t => t.truckNo.toUpperCase().trim() === truckInput.truckNo.toUpperCase().trim());\n    if (isDup) {\n      alert(\"Truck Number already registered in active datasheets.\");\n      return;\n    }\n    const n = { ...truckInput, id: \'t_id_\' + Date.now() };\n    saveTrucks([...trucks, n]);\n    showNotification(`Truck ${n.truckNo} added successfully.`);\n  };\n\n  const handleUpdateTruck = (updated: Truck) => {\n    const next = trucks.map(t => t.id === updated.id ? updated : t);\n    saveTrucks(next);\n    showNotification(`Truck ${updated.truckNo} database specifications updated.`);\n  };\n\n  const handleDeleteTruck = (id: string) => {\n    const truckToDelete = trucks.find(t => t.id === id);\n    const inUse = trips.some(tr => tr.truckNo === truckToDelete?.truckNo);\n    if (inUse) {\n      alert(`Cannot delete Truck ${truckToDelete?.truckNo}. It is associated with active trip registers.`);\n      return;\n    }\n    const next = trucks.filter(t => t.id !== id);\n    saveTrucks(next);\n    showNotification(`Truck archived from list.`);\n  };\n\n  // --- OFFICE CRUD HANDLERS ---\n  const handleAddOffice = (officeInput: Omit<Office, \'id\'>) => {\n    const isDup = offices.some(o => o.officeName.toLowerCase().trim() === officeInput.officeName.toLowerCase().trim());\n    if (isDup) {\n      alert(\"Trading office with historical name already exists.\");\n      return;\n    }\n    const n = { ...officeInput, id: \'o_id_\' + Date.now() };\n    saveOffices([...offices, n]);\n    showNotification(`Office branch ${n.officeName} created.`);\n  };\n\n  const handleUpdateOffice = (updated: Office) => {\n    const next = offices.map(o => o.id === updated.id ? updated : o);\n    saveOffices(next);\n    showNotification(`Office branch record updated.`);\n  };\n\n  const handleDeleteOffice = (id: string) => {\n    const off = offices.find(o => o.id === id);\n    const inUse = trips.some(tr => tr.officeName === off?.officeName);\n    if (inUse) {\n      alert(`Cannot delete Office ${off?.officeName}. This office has historical load consignments associated.`);\n      return;\n    }\n    const next = offices.filter(o => o.id !== id);\n    saveOffices(next);\n    showNotification(`Office location removed.`);\n  };\n\n  // --- ACCOUNT CRUD HANDLERS ---\n  const handleAddAccount = (accountInput: Omit<Account, \'id\'>) => {\n    const isDup = accounts.some(a => a.accountName.toLowerCase().trim() === accountInput.accountName.toLowerCase().trim());\n    if (isDup) {\n      alert(\"Accounting ledger with identical name already exists.\");\n      return;\n    }\n    const n = { ...accountInput, id: \'a_id_\' + Date.now() };\n    saveAccounts([...accounts, n]);\n    showNotification(`Account ledger ${n.accountName} registered.`);\n  };\n\n  const handleUpdateAccount = (updated: Account) => {\n    const next = accounts.map(a => a.id === updated.id ? updated : a);\n    saveAccounts(next);\n    showNotification(`Accounting ledger records adjusted.`);\n  };\n\n  const handleDeleteAccount = (id: string) => {\n    const current = accounts.find(a => a.id === id);\n    // Safe check if any trip advance uses this account\n    const inUse = trips.some(t => \n      t.advance1ReceivedBy === id || \n      t.advance2ReceivedBy === id || \n      t.advance3ReceivedBy === id || \n      t.balance1ReceivedBy === id\n    );\n    if (inUse) {\n      alert(`Cannot delete Account ${current?.accountName}. It represents outstanding or past receipts.`);\n      return;\n    }\n    const next = accounts.filter(a => a.id !== id);\n    saveAccounts(next);\n    showNotification(`Ledger account detached.`);\n  };\n\n  // --- TRIP ENTRIES CRUD SYSTEM ---\n  const handlePostTripEntry = (entryInput: Omit<TripEntry, \'id\' | \'balance\'>) => {\n    if (editingTrip) {\n      // Update logic\n      const balanceVal = calculateBalance(entryInput);\n      const updated: TripEntry = {\n        ...entryInput,\n        id: editingTrip.id,\n        balance: balanceVal\n      };\n      \n      const next = trips.map(t => t.id === editingTrip.id ? updated : t);\n      saveTrips(next);\n      setEditingTrip(null);\n      showNotification(`Trip ledger updated successfully.`);\n    } else {\n      // Add logic\n      const balanceVal = calculateBalance(entryInput);\n      const newEntry: TripEntry = {\n        ...entryInput,\n        id: \'trip_ent_\' + Date.now(),\n        balance: balanceVal\n      };\n      saveTrips([...trips, newEntry]);\n      showNotification(`Saved segment load posted into Trip sequence.`);\n    }\n  };\n\n  const handleDeleteTripEntry = (id: string) => {\n    const next = trips.filter(t => t.id !== id);\n    saveTrips(next);\n    showNotification(`Trip entry permanently voided.`);\n  };\n\n  const handleEditTripTrigger = (entry: TripEntry) => {\n    setEditingTrip(entry);\n    setBookingModalOpen(true);\n  };\n\n  // --- BACKUP RESTORE SYSTEM ---\n  const handleTriggerDownloadBackup = () => {\n    const payload = {\n      trucks,\n      offices,\n      accounts,\n      trips,\n      exportDate: new Date().toISOString(),\n      source: \'Truck Trip Tracker System\'\n    };\n\n    const fileData = JSON.stringify(payload, null, 2);\n    const blob = new Blob([fileData], { type: \'application/json\' });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.setAttribute(\'download\', `TT_Tracker_Backup_${new Date().toISOString().substring(0, 10)}.json`);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n    showNotification(\"Backup snapshot exported to folder successfully.\");\n  };\n\n  const handleUploadBackupChange = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n\n    const reader = new FileReader();\n    reader.onload = (event) => {\n      try {\n        const parsed = JSON.parse(event.target?.result as string);\n        if (parsed.trucks && parsed.offices && parsed.accounts && parsed.trips) {\n          saveTrucks(parsed.trucks);\n          saveOffices(parsed.offices);\n          saveAccounts(parsed.accounts);\n          saveTrips(parsed.trips);\n          showNotification(\"System data recovered successfully! Master list updated.\");\n        } else {\n          alert(\"Corrupted Schema. Uploaded file doesn\'t match Truck Trip Tracker backup signature.\");\n        }\n      } catch (err) {\n        alert(\"Failed to parse JSON file template. Please upload a valid JSON backup.\");\n      }\n    };\n    reader.readAsText(file);\n  };\n\n  const triggerInjectFreshSeeds = () => {\n    if (confirm(\"Reset current journals? This will flush local storage and restore default data models.\")) {\n      saveTrucks(SEED_TRUCKS);\n      saveOffices(SEED_OFFICES);\n      saveAccounts(SEED_ACCOUNTS);\n      saveTrips(SEED_TRIPS);\n      showNotification(\"Succeeded! Database models repopulated.\");\n    }\n  };\n\n  // Find all distinct ongoing trip numbers to populate join options\n  const existingTripNosList = Array.from(new Set(trips.map(t => t.tripNo))).sort().reverse();\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 text-slate-100 flex flex-col font-sans select-none selection:bg-indigo-600/30\">\n      \n      {/* GLOBAL TOAST BANNER */}\n      {toastMessage && (\n        <div id=\"toast-notify\" className=\"fixed bottom-5 right-5 z-50 bg-indigo-900 border border-indigo-500/50 text-white p-3.5 px-6 rounded-xl shadow-2xl flex items-center gap-2.5 animate-bounce\">\n          <CheckCircle className=\"w-4 h-4 text-indigo-400\" />\n          <span className=\"text-xs font-semibold\">{toastMessage}</span>\n        </div>\n      )}\n\n      {/* TOP DECORATIVE HEADERBAR */}\n      <header className=\"bg-slate-900 border-b border-slate-800 px-6 py-4 sticky top-0 z-40\">\n        <div className=\"max-w-7xl mx-auto flex flex-col md:flex-row justify-between items-start md:items-center gap-4\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"bg-indigo-600/10 border border-indigo-500/30 p-2.5 rounded-2xl text-indigo-400 shadow-inner\">\n              <FileSpreadsheet className=\"w-6 h-6\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h1 className=\"text-xl font-black text-white tracking-tight font-sans\">Truck Trip Tracker</h1>\n                <span className=\"bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[10px] px-2 py-0.5 rounded font-bold uppercase tracking-wider\">SECURE LOCAL</span>\n              </div>\n              <p className=\"text-slate-400 text-xs mt-0.5\">Automate and consolidate multi-item cargo logs, commissions, advances & ledgers.</p>\n            </div>\n          </div>\n\n          {/* UTILITY BAR FOR BACKUPS AND SYSTEM STATE */}\n          <div className=\"flex items-center gap-2.5 self-stretch md:self-auto\">\n            \n            {/* INJECT SEEDS */}\n            <button\n              id=\"btn-reseed\"\n              onClick={triggerInjectFreshSeeds}\n              title=\"Reset Database to Seed Models\"\n              className=\"p-2 bg-slate-800 hover:bg-slate-750 text-slate-400 hover:text-white rounded-xl transition border border-slate-705/80 text-xs flex items-center gap-1.5\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5\" /> Seeding\n            </button>\n\n            {/* DOWNLOAD DATABASE BACKUP */}\n            <button\n              id=\"btn-backup-download\"\n              onClick={handleTriggerDownloadBackup}\n              title=\"Download Snapshot Backup File (.json)\"\n              className=\"p-2 bg-slate-800 hover:bg-slate-755 text-slate-400 hover:text-indigo-300 rounded-xl transition border border-slate-705/80 text-xs flex items-center gap-1.5\"\n            >\n              <Download className=\"w-3.5 h-3.5\" /> Backup\n            </button>\n\n            {/* UPLOAD RESTORE */}\n            <label className=\"p-2 bg-slate-800 hover:bg-slate-755 text-slate-400 hover:text-indigo-300 rounded-xl transition border border-slate-705/80 text-xs flex items-center gap-1.5 cursor-pointer\">\n              <Upload className=\"w-3.5 h-3.5\" /> Restore\n              <input \n                id=\"file-restore-input\"\n                type=\"file\" \n                accept=\".json\" \n                onChange={handleUploadBackupChange} \n                className=\"hidden\" \n              />\n            </label>\n\n            {/* QUICK BOOKING TRIGGER */}\n            <button\n              id=\"btn-quick-post-trip\"\n              onClick={() => {\n                // Safeguard if master records are empty\n                if (trucks.length === 0 || offices.length === 0) {\n                  alert(\"Hold on! Register Trucks and Offices in their master sheets before booking cargo entries.\");\n                  return;\n                }\n                setEditingTrip(null);\n                setBookingModalOpen(true);\n              }}\n              className=\"flex-1 md:flex-none flex items-center justify-center gap-1.5 bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-4 py-2 rounded-xl text-xs transition duration-150 shadow-lg shadow-indigo-600/30\"\n            >\n              <Plus className=\"w-3.5 h-3.5\" /> Post Entry\n            </button>\n          </div>\n        </div>\n      </header>\n\n      {/* TABS SELECT NAVIGATION UTILITY */}\n      <nav id=\"app-nav-bar\" className=\"bg-slate-905 border-b border-slate-800 px-6\">\n        <div className=\"max-w-7xl mx-auto flex gap-1 h-12\">\n          \n          {/* DASHBOARD TAB */}\n          <button\n            id=\"tab-btn-dashboard\"\n            onClick={() => setActiveTab(\'DASHBOARD\')}\n            className={`px-5 py-2.5 text-xs font-bold transition flex items-center gap-2 border-b-2 ${\n              activeTab === \'DASHBOARD\' \n                ? \'border-indigo-500 text-indigo-400 bg-slate-900/40\' \n                : \'border-transparent text-slate-400 hover:text-white\'\n            }`}\n          >\n            <BarChart3 className=\"w-4 h-4\" /> Operations Dashboard\n          </button>\n\n          {/* TRIPS TAB */}\n          <button\n            id=\"tab-btn-trips\"\n            onClick={() => setActiveTab(\'TRIPS\')}\n            className={`px-5 py-2.5 text-xs font-bold transition flex items-center gap-2 border-b-2 ${\n              activeTab === \'TRIPS\' \n                ? \'border-indigo-500 text-indigo-400 bg-slate-900/40\' \n                : \'border-transparent text-slate-400 hover:text-white\'\n            }`}\n          >\n            <BookOpen className=\"w-4 h-4\" /> Trip Journal Records\n          </button>\n\n          {/* TRUCKS MASTER TAB */}\n          <button\n            id=\"tab-btn-trucks\"\n            onClick={() => setActiveTab(\'TRUCKS\')}\n            className={`px-5 py-2.5 text-xs font-bold transition flex items-center gap-2 border-b-2 ${\n              activeTab === \'TRUCKS\' \n                ? \'border-indigo-500 text-indigo-400 bg-slate-900/40\' \n                : \'border-transparent text-slate-400 hover:text-white\'\n            }`}\n          >\n            <TruckIcon className=\"w-4 h-4\" /> Truck Datasheet\n          </button>\n\n          {/* OFFICES MASTER TAB */}\n          <button\n            id=\"tab-btn-offices\"\n            onClick={() => setActiveTab(\'OFFICES\')}\n            className={`px-5 py-2.5 text-xs font-bold transition flex items-center gap-2 border-b-2 ${\n              activeTab === \'OFFICES\' \n                ? \'border-indigo-500 text-indigo-400 bg-slate-900/40\' \n                : \'border-transparent text-slate-400 hover:text-white\'\n            }`}\n          >\n            <MapPin className=\"w-4 h-4\" /> Office Datasheet\n          </button>\n\n          {/* ACCOUNTS SELECTION TAB */}\n          <button\n            id=\"tab-btn-accounts\"\n            onClick={() => setActiveTab(\'ACCOUNTS\')}\n            className={`px-5 py-2.5 text-xs font-bold transition flex items-center gap-2 border-b-2 ${\n              activeTab === \'ACCOUNTS\' \n                ? \'border-indigo-500 text-indigo-400 bg-slate-900/40\' \n                : \'border-transparent text-slate-400 hover:text-white\'\n            }`}\n          >\n            <Coins className=\"w-4 h-4\" /> Mapped Ledgers\n          </button>\n\n        </div>\n      </nav>\n\n      {/* CORE VIEWPORT CAROUSEL */}\n      <main id=\"app-viewport-container\" className=\"flex-1 max-w-7xl w-full mx-auto p-6 space-y-6\">\n        \n        {/* WARNING BAR IF MASTERS INACTIVE */}\n        {(trucks.length === 0 || offices.length === 0 || accounts.length === 0) && (\n          <div id=\"safety-warning-banner\" className=\"bg-amber-950/20 border border-amber-600/20 p-4 rounded-xl flex items-center gap-3 animate-pulse\">\n            <AlertCircle className=\"w-5 h-5 text-amber-500 flex-shrink-0\" />\n            <div className=\"text-xs\">\n              <p className=\"font-semibold text-amber-400\">Prerequisites Required</p>\n              <p className=\"text-slate-400 mt-1 leading-relaxed\">\n                Before recording any transaction logs, ensure you register at least <strong>1 operational Truck</strong>, <strong>1 active branch Office</strong>, and <strong>1 receiving Account Ledger</strong>. Go to their respective master database tabs above to populate the datasheets first.\n              </p>\n            </div>\n          </div>\n        )}\n\n        {/* TAB RENDERING CONTROLS */}\n        {activeTab === \'DASHBOARD\' && (\n          <Dashboard \n            trips={trips} \n            trucks={trucks} \n            offices={offices} \n            accounts={accounts} \n          />\n        )}\n\n        {activeTab === \'TRIPS\' && (\n          <TripList\n            trips={trips}\n            trucks={trucks}\n            offices={offices}\n            accounts={accounts}\n            onEditEntry={handleEditTripTrigger}\n            onDeleteEntry={handleDeleteTripEntry}\n          />\n        )}\n\n        {activeTab === \'TRUCKS\' && (\n          <TruckMaster\n            trucks={trucks}\n            onAddTruck={handleAddTruck}\n            onUpdateTruck={handleUpdateTruck}\n            onDeleteTruck={handleDeleteTruck}\n          />\n        )}\n\n        {activeTab === \'OFFICES\' && (\n          <OfficeMaster\n            offices={offices}\n            onAddOffice={handleAddOffice}\n            onUpdateOffice={handleUpdateOffice}\n            onDeleteOffice={handleDeleteOffice}\n          />\n        )}\n\n        {activeTab === \'ACCOUNTS\' && (\n          <AccountMaster\n            accounts={accounts}\n            onAddAccount={handleAddAccount}\n            onUpdateAccount={handleUpdateAccount}\n            onDeleteAccount={handleDeleteAccount}\n          />\n        )}\n\n      </main>\n\n      {/* DYNAMIC FORM MODAL BINDERS */}\n      <TripForm\n        isOpen={bookingModalOpen}\n        onClose={() => {\n          setBookingModalOpen(false);\n          setEditingTrip(null);\n        }}\n        trucks={trucks}\n        offices={offices}\n        accounts={accounts}\n        existingTripNos={existingTripNosList}\n        onSubmit={handlePostTripEntry}\n        editingEntry={editingTrip}\n      />\n\n      {/* FOOTER */}\n      <footer className=\"bg-slate-900/60 border-t border-slate-800/80 py-4 px-6 text-center text-[10.5px] text-slate-500 font-sans mt-auto\">\n        <div className=\"max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center gap-2\">\n          <span>Truck Trip Tracker Portfolio &bull; Dedicated Client-Side Ledger</span>\n          <span className=\"font-mono text-[9px] text-slate-600\">Local Storage Active \342\200\242 High-Fidelity Logistics UI</span>\n        </div>\n      </footer>\n\n    </div>\n  );\n}\n"
    }
