    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <div id=\"office-master-panel\" className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl\">\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white tracking-tight\">Office Datasheet</h2>\n          <p className=\"text-sm text-slate-400 mt-1\">Manage active trading offices and transport hubs details.</p>\n        </div>\n        <button\n          id=\"btn-add-office\"\n          onClick={() => {\n            resetForm();\n            setShowAddForm(!showAddForm);\n          }}\n          className=\"flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-4 py-2.5 rounded-xl transition duration-150 shadow-lg shadow-indigo-600/20 text-sm\"\n        >\n          {showAddForm ? \'Close Form\' : (\n            <>\n              <Plus className=\"w-4 h-4\" /> Add New Office\n            </>\n          )}\n        </button>\n      </div>\n\n      {showAddForm && (\n        <form id=\"office-form\" onSubmit={handleSubmit} className=\"mb-8 p-5 bg-slate-950 rounded-xl border border-slate-800/80 animate-fade-in\">\n          <h3 className=\"text-sm font-semibold text-indigo-400 uppercase tracking-wider mb-4\">\n            {isEditing ? \'Modify Office Details\' : \'Register New Office\'}\n          </h3>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4\">\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Office Name <span className=\"text-red-500\">*</span></label>\n              <input\n                id=\"input-office-name\"\n                type=\"text\"\n                placeholder=\"e.g. Mumbai Logistics Office\"\n                value={officeName}\n                onChange={(e) => setOfficeName(e.target.value)}\n                required\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">City/Branch Location</label>\n              <input\n                id=\"input-office-city\"\n                type=\"text\"\n                placeholder=\"e.g. Mumbai\"\n                value={city}\n                onChange={(e) => setCity(e.target.value)}\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Contact Person</label>\n              <input\n                id=\"input-office-contact\"\n                type=\"text\"\n                placeholder=\"Manager/Agent name\"\n                value={contactPerson}\n                onChange={(e) => setContactPerson(e.target.value)}\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Contact Phone</label>\n              <input\n                id=\"input-office-phone\"\n                type=\"tel\"\n                placeholder=\"Phone number\"\n                value={phone}\n                onChange={(e) => setPhone(e.target.value)}\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Office Status</label>\n              <select\n                id=\"select-office-status\"\n                value={status}\n                onChange={(e) => setStatus(e.target.value as \'Active\' | \'Inactive\')}\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"Active\">Active</option>\n                <option value=\"Inactive\">Inactive/Closed</option>\n              </select>\n            </div>\n          </div>\n          <div className=\"flex justify-end gap-3 mt-4 pt-3 border-t border-slate-800/50\">\n            <button\n              type=\"button\"\n              onClick={resetForm}\n              className=\"px-4 py-2 text-xs font-medium text-slate-400 hover:text-white\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs px-4 py-2 rounded-lg transition\"\n            >\n              {isEditing ? \'Update Office\' : \'Add Office\'}\n            </button>\n          </div>\n        </form>\n      )}\n\n      <div className=\"overflow-x-auto\">\n        <table id=\"offices-table\" className=\"w-full text-left text-sm text-slate-300\">\n          <thead className=\"text-xs text-slate-400 uppercase bg-slate-950/60 border-y border-slate-800\">\n            <tr>\n              <th className=\"px-4 py-3\">Office Name</th>\n              <th className=\"px-4 py-3\">Location/City</th>\n              <th className=\"px-4 py-3\">Contact Person</th>\n              <th className=\"px-4 py-3\">Phone</th>\n              <th className=\"px-4 py-3 text-center\">Status</th>\n              <th className=\"px-4 py-3 text-right\">Actions</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-800\">\n            {offices.length === 0 ? (\n              <tr>\n                <td colSpan={6} className=\"text-center py-8 text-slate-500 font-medium font-sans\">No offices registered. Create a transport branch/broker office.</td>\n              </tr>\n            ) : (\n              offices.map((office) => (\n                <tr key={office.id} id={`row-office-${office.id}`} className=\"hover:bg-slate-800/40 transition\">\n                  <td className=\"px-4 py-3.5 font-semibold text-white\">\n                    {office.officeName}\n                  </td>\n                  <td className=\"px-4 py-3.5 text-slate-300 font-medium\">\n                    {office.city ? (\n                      <span className=\"flex items-center gap-1.5\">\n                        <MapPin className=\"w-3.5 h-3.5 text-indigo-400\" />\n                        {office.city}\n                      </span>\n                    ) : (\n                      <span className=\"text-slate-600 italic text-xs\">&mdash;</span>\n                    )}\n                  </td>\n                  <td className=\"px-4 py-3.5 text-slate-300 font-medium\">\n                    {office.contactPerson ? (\n                      <span className=\"flex items-center gap-1.5\">\n                        <User className=\"w-3.5 h-3.5 text-slate-500\" />\n                        {office.contactPerson}\n                      </span>\n                    ) : (\n                      <span className=\"text-slate-600 italic text-xs\">&mdash;</span>\n                    )}\n                  </td>\n                  <td className=\"px-4 py-3.5 font-mono text-xs text-slate-400\">\n                    {office.phone ? (\n                      <span className=\"flex items-center gap-1.5\">\n                        <Phone className=\"w-3 h-3 text-slate-500\" />\n                        {office.phone}\n                      </span>\n                    ) : (\n                      <span className=\"text-slate-600 italic text-xs\">&mdash;</span>\n                    )}\n                  </td>\n                  <td className=\"px-4 py-3.5 text-center flex-1\">\n                    <span className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold ${\n                      office.status === \'Active\' \n                        ? \'bg-transparent border border-emerald-500/30 text-emerald-400\' \n                        : \'bg-transparent border border-rose-500/30 text-rose-400\'\n                    }`}>\n                      {office.status === \'Active\' ? (\n                        <>\n                          <CheckCircle className=\"w-3 h-3 text-emerald-400\" />\n                          Active\n                        </>\n                      ) : (\n                        <>\n                          <XCircle className=\"w-3 h-3 text-rose-400\" />\n                          Inactive\n                        </>\n                      )}\n                    </span>\n                  </td>\n                  <td className=\"px-4 py-3.5 text-right font-medium\">\n                    <div className=\"flex justify-end gap-2\">\n                      <button\n                        title=\"Edit Office\"\n                        onClick={() => startEdit(office)}\n                        className=\"p-1 px-2.5 bg-slate-800 text-slate-300 hover:text-white rounded-lg hover:bg-slate-750 transition\"\n                      >\n                        <Edit2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                      <button\n                        title=\"Delete Office\"\n                        onClick={() => {\n                          if (confirm(`Are you sure you want to delete Office ${office.officeName}?`)) {\n                            onDeleteOffice(office.id);\n                          }\n                        }}\n                        className=\"p-1 px-2.5 bg-slate-800 text-rose-400 hover:text-rose-300 rounded-lg hover:bg-rose-950/20 transition\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </td>\n                </tr>\n              ))\n            )}\n          </tbody>\n        </table>\n      </div>\n    </div>"
      replacement_content: "  return (\n    <div id=\"office-master-panel\" className=\"bg-white border border-slate-200 rounded-xl p-5 md:p-6 shadow-xs animate-fade-in\">\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6\">\n        <div>\n          <h2 className=\"text-lg font-bold text-slate-800 tracking-tight\">Office Datasheet</h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">Manage active trading offices and transport hubs details.</p>\n        </div>\n        <button\n          id=\"btn-add-office\"\n          onClick={() => {\n            resetForm();\n            setShowAddForm(!showAddForm);\n          }}\n          className=\"flex items-center gap-2 bg-blue-650 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg transition duration-150 shadow-sm text-xs cursor-pointer\"\n        >\n          {showAddForm ? \'Close Form\' : (\n            <>\n              <Plus className=\"w-3.5 h-3.5\" /> Add New Office\n            </>\n          )}\n        </button>\n      </div>\n\n      {showAddForm && (\n        <form id=\"office-form\" onSubmit={handleSubmit} className=\"mb-6 p-4 md:p-5 bg-slate-50 rounded-lg border border-slate-250/70 animate-fade-in\">\n          <h3 className=\"text-xs font-bold text-blue-650 uppercase tracking-wider mb-4\">\n            {isEditing ? \'Modify Office Details\' : \'Register New Office\'}\n          </h3>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4\">\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-650 mb-1\">Office Name <span className=\"text-red-500\">*</span></label>\n              <input\n                id=\"input-office-name\"\n                type=\"text\"\n                placeholder=\"e.g. Mumbai Logistics\"\n                value={officeName}\n                onChange={(e) => setOfficeName(e.target.value)}\n                required\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-blue-500 font-semibold\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-650 mb-1\">City/Branch Location</label>\n              <input\n                id=\"input-office-city\"\n                type=\"text\"\n                placeholder=\"e.g. Mumbai\"\n                value={city}\n                onChange={(e) => setCity(e.target.value)}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-blue-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-650 mb-1\">Contact Person</label>\n              <input\n                id=\"input-office-contact\"\n                type=\"text\"\n                placeholder=\"Manager/Agent name\"\n                value={contactPerson}\n                onChange={(e) => setContactPerson(e.target.value)}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-blue-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-650 mb-1\">Contact Phone</label>\n              <input\n                id=\"input-office-phone\"\n                type=\"tel\"\n                placeholder=\"Phone number\"\n                value={phone}\n                onChange={(e) => setPhone(e.target.value)}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-blue-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-semibold text-slate-650 mb-1\">Office Status</label>\n              <select\n                id=\"select-office-status\"\n                value={status}\n                onChange={(e) => setStatus(e.target.value as \'Active\' | \'Inactive\')}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-1.5 text-xs focus:outline-none focus:border-blue-500 font-medium\"\n              >\n                <option value=\"Active\">Active</option>\n                <option value=\"Inactive\">Inactive/Closed</option>\n              </select>\n            </div>\n          </div>\n          <div className=\"flex justify-end gap-3 mt-4 pt-3 border-t border-slate-200\">\n            <button\n              type=\"button\"\n              onClick={resetForm}\n              className=\"px-4 py-2 text-xs font-bold text-slate-500 hover:text-slate-805 cursor-pointer\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"bg-blue-650 hover:bg-blue-700 text-white font-semibold text-xs px-4 py-2 rounded-lg transition shadow-2xs cursor-pointer\"\n            >\n              {isEditing ? \'Update Office\' : \'Add Office\'}\n            </button>\n          </div>\n        </form>\n      )}\n\n      <div className=\"overflow-x-auto border border-slate-200 rounded-lg\">\n        <table id=\"offices-table\" className=\"w-full text-left text-sm text-slate-700\">\n          <thead className=\"text-xs text-slate-500 uppercase bg-slate-50 border-b border-slate-200 font-bold tracking-wider\">\n            <tr>\n              <th className=\"px-4 py-3.5 pl-6\">Office Name</th>\n              <th className=\"px-4 py-3.5\">Location/City</th>\n              <th className=\"px-4 py-3.5\">Contact Person</th>\n              <th className=\"px-4 py-3.5\">Phone</th>\n              <th className=\"px-4 py-3.5 text-center\">Status</th>\n              <th className=\"px-4 py-3.5 text-right pr-6\">Actions</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100 font-sans\">\n            {offices.length === 0 ? (\n              <tr>\n                <td colSpan={6} className=\"text-center py-12 text-slate-400 font-medium italic\">No offices registered. Create a transport branch/broker office.</td>\n              </tr>\n            ) : (\n              offices.map((office) => (\n                <tr key={office.id} id={`row-office-${office.id}`} className=\"hover:bg-slate-50/75 transition\">\n                  <td className=\"px-4 py-3.5 pl-6 font-bold text-slate-800\">\n                    {office.officeName}\n                  </td>\n                  <td className=\"px-4 py-3.5 text-slate-650 font-medium\">\n                    {office.city ? (\n                      <span className=\"flex items-center gap-1.5 text-xs font-semibold text-slate-700 bg-slate-100 border border-slate-200/60 rounded px-2 py-0.5\">\n                        <MapPin className=\"w-3 h-3 text-blue-600\" />\n                        {office.city}\n                      </span>\n                    ) : (\n                      <span className=\"text-slate-400 italic font-mono\">&mdash;</span>\n                    )}\n                  </td>\n                  <td className=\"px-4 py-3.5 text-slate-600 font-medium\">\n                    {office.contactPerson ? (\n                      <span className=\"flex items-center gap-1.5\">\n                        <User className=\"w-3.5 h-3.5 text-slate-400\" />\n                        {office.contactPerson}\n                      </span>\n                    ) : (\n                      <span className=\"text-slate-400 italic font-mono\">&mdash;</span>\n                    )}\n                  </td>\n                  <td className=\"px-4 py-3.5 font-mono text-xs text-slate-600 font-medium\">\n                    {office.phone ? (\n                      <span className=\"flex items-center gap-1\">\n                        <Phone className=\"w-3 h-3 text-slate-400\" />\n                        {office.phone}\n                      </span>\n                    ) : (\n                      <span className=\"text-slate-400 italic font-mono\">&mdash;</span>\n                    )}\n                  </td>\n                  <td className=\"px-4 py-3.5 text-center\">\n                    <span className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-bold ${\n                      office.status === \'Active\' \n                        ? \'bg-emerald-50 border border-emerald-200 text-emerald-700\' \n                        : \'bg-rose-50 border border-rose-200 text-rose-700\'\n                    }`}>\n                      {office.status === \'Active\' ? (\n                        <>\n                          <CheckCircle className=\"w-3 h-3 text-emerald-600\" />\n                          Active\n                        </>\n                      ) : (\n                        <>\n                          <XCircle className=\"w-3 h-3 text-rose-600\" />\n                          Inactive\n                        </>\n                      )}\n                    </span>\n                  </td>\n                  <td className=\"px-4 py-3.5 text-right font-medium pr-6\">\n                    <div className=\"flex justify-end gap-1 px-1\">\n                      <button\n                        title=\"Edit Office\"\n                        onClick={() => startEdit(office)}\n                        className=\"p-1 px-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 rounded transition cursor-pointer\"\n                      >\n                        <Edit2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                      <button\n                        title=\"Delete Office\"\n                        onClick={() => {\n                          if (confirm(`Are you sure you want to delete Office ${office.officeName}?`)) {\n                            onDeleteOffice(office.id);\n                          }\n                        }}\n                        className=\"p-1 px-2.5 bg-rose-50 hover:bg-rose-100 text-rose-600 hover:text-rose-750 rounded transition cursor-pointer\"\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </td>\n                </tr>\n              ))\n            )}\n          </tbody>\n        </table>\n      </div>\n    </div>"
