    instruction: "Add search filter, totals aggregator, and CSV export utilities to TripList.tsx"
    replacement_infos {
      original_chunk {
        target_content: "  // Master Details modal state for viewing full list of 21 columns cleanly\n  const [viewingEntry, setViewingEntry] = useState<TripEntry | null>(null);"
        replacement_content: "  // Master Details modal state for viewing full list of 21 columns cleanly\n  const [viewingEntry, setViewingEntry] = useState<TripEntry | null>(null);\n\n  // Filter and search logic\n  const filteredTrips = trips.filter(trip => {\n    const matchesSearch = !search ? true : (\n      trip.tripNo.toLowerCase().includes(search.toLowerCase()) ||\n      trip.truckNo.toLowerCase().includes(search.toLowerCase()) ||\n      trip.officeName.toLowerCase().includes(search.toLowerCase()) ||\n      (trip.notes && trip.notes.toLowerCase().includes(search.toLowerCase()))\n    );\n\n    const matchesTruck = !selectedTruck ? true : trip.truckNo === selectedTruck;\n    const matchesOffice = !selectedOffice ? true : trip.officeName === selectedOffice;\n    const matchesStatus = !selectedStatus ? true : trip.status === selectedStatus;\n\n    const matchesStartDate = !startDate ? true : trip.loadingDate >= startDate;\n    const matchesEndDate = !endDate ? true : trip.loadingDate <= endDate;\n\n    return matchesSearch && matchesTruck && matchesOffice && matchesStatus && matchesStartDate && matchesEndDate;\n  });\n\n  // Calculate totals for footer\n  const totals = filteredTrips.reduce((acc, t) => {\n    const rentalVal = Number(t.rental) || 0;\n    const commVal = Number(t.commission) || 0;\n    const loadingUnloadingVal = Number(t.loadingUnloading) || 0;\n    const officeMamulVal = Number(t.officeMamul) || 0;\n    const advs = (Number(t.advance1) || 0) + (Number(t.advance2) || 0) + (Number(t.advance3) || 0);\n    const balanceVal = calculateBalance(t);\n\n    return {\n      rental: acc.rental + rentalVal,\n      commission: acc.commission + commVal,\n      loadingUnloading: acc.loadingUnloading + loadingUnloadingVal,\n      officeMamul: acc.officeMamul + officeMamulVal,\n      advances: acc.advances + advs,\n      balance: acc.balance + balanceVal\n    };\n  }, {\n    rental: 0,\n    commission: 0,\n    loadingUnloading: 0,\n    officeMamul: 0,\n    advances: 0,\n    balance: 0\n  });\n\n  // CSV Exporter\n  const handleExportCSV = () => {\n    if (filteredTrips.length === 0) return;\n    const headers = [\n      \"Trip No\", \"Truck No\", \"Office Name\", \"Rental\", \"Loading Date\", \"Commission\",\n      \"Loading Unloading\", \"Office Mamul\", \"Advance 1\", \"Advance 1 Date\", \"Advance 1 Received By\",\n      \"Advance 2\", \"Advance 2 Date\", \"Advance 2 Received By\", \"Advance 3\", \"Advance 3 Date\",\n      \"Advance 3 Received By\", \"Balance\", \"Balance 1 Date\", \"Balance 1 Received By\", \"Status\"\n    ];\n\n    const rows = filteredTrips.map(t => [\n      t.tripNo,\n      t.truckNo,\n      t.officeName,\n      t.rental,\n      t.loadingDate,\n      t.commission,\n      t.loadingUnloading,\n      t.officeMamul,\n      t.advance1,\n      t.advance1Date,\n      t.advance1ReceivedBy ? accounts.find(a => a.id === t.advance1ReceivedBy)?.accountName || t.advance1ReceivedBy : \"\",\n      t.advance2,\n      t.advance2Date,\n      t.advance2ReceivedBy ? accounts.find(a => a.id === t.advance2ReceivedBy)?.accountName || t.advance2ReceivedBy : \"\",\n      t.advance3,\n      t.advance3Date,\n      t.advance3ReceivedBy ? accounts.find(a => a.id === t.advance3ReceivedBy)?.accountName || t.advance3ReceivedBy : \"\",\n      calculateBalance(t),\n      t.balance1Date,\n      t.balance1ReceivedBy ? accounts.find(a => a.id === t.balance1ReceivedBy)?.accountName || t.balance1ReceivedBy : \"\",\n      t.status\n    ]);\n\n    const csvContent = [\n      headers.join(\",\"),\n      ...rows.map(r => r.map(val => {\n        const escaped = (\'\' + val).replace(/\"/g, \'\"\"\');\n        return escaped.includes(\',\') || escaped.includes(\'\\n\') || escaped.includes(\'\"\') ? `\"${escaped}\"` : escaped;\n      }).join(\",\"))\n    ].join(\"\\n\");\n\n    const blob = new Blob([csvContent], { type: \'text/csv;charset=utf-8;\' });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\"a\");\n    link.href = url;\n    link.setAttribute(\"download\", `journal_report_${new Date().toISOString().slice(0, 10)}.csv`);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n  };"
      }
      num_matches: 1
    }
  }
}
