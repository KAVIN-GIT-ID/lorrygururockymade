  file_change {
    absolute_path_uri: "file:///src/components/TruckMaster.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Truck } from \'../types\';\nimport { Plus, Edit2, Trash2, Shield, CheckCircle, XCircle, Settings, ClipboardList } from \'lucide-react\';\n\ninterface TruckMasterProps {\n  trucks: Truck[];\n  onAddTruck: (truck: Omit<Truck, \'id\'>) => void;\n  onUpdateTruck: (truck: Truck) => void;\n  onDeleteTruck: (id: string) => void;\n}\n\n// Helper to compute and style days left\nconst getDaysLeftBadge = (dateStr?: string) => {\n  if (!dateStr) return <span className=\"text-slate-400 font-mono italic text-[11px]\">&mdash;</span>;\n  const expiry = new Date(dateStr);\n  if (isNaN(expiry.getTime())) return <span className=\"text-slate-400 font-mono italic text-[11px]\">&mdash;</span>;\n  \n  // Platform reference time: 2026-05-23\n  const today = new Date(\'2026-05-23\');\n  const diffTime = expiry.getTime() - today.getTime();\n  const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));\n  \n  if (diffDays < 0) {\n    return (\n      <div className=\"flex flex-col text-left font-sans\">\n        <span className=\"font-mono text-slate-800 font-bold\">{dateStr}</span>\n        <span className=\"text-[10px] text-red-600 font-bold bg-red-50 border border-red-100 px-1 py-0.5 rounded w-max mt-0.5\">Exp Overdue ({Math.abs(diffDays)}d)</span>\n      </div>\n    );\n  }\n  if (diffDays <= 30) {\n    return (\n      <div className=\"flex flex-col text-left font-sans\">\n        <span className=\"font-mono text-slate-800 font-bold\">{dateStr}</span>\n        <span className=\"text-[10px] text-amber-700 font-bold bg-amber-50 border border-amber-200 px-1 py-0.5 rounded w-max mt-0.5\">{diffDays}d left</span>\n      </div>\n    );\n  }\n  return (\n    <div className=\"flex flex-col text-left font-sans\">\n      <span className=\"font-mono text-slate-800 font-medium\">{dateStr}</span>\n      <span className=\"text-[10px] text-emerald-700 font-bold bg-emerald-50 border border-emerald-200 px-1 py-0.5 rounded w-max mt-0.5\">{diffDays}d left</span>\n    </div>\n  );\n};\n\n// Helper to compute and style KM left\nconst getKMLeftBadge = (targetKM?: number, currentKM?: number) => {\n  if (!targetKM || !currentKM) {\n    return (\n      <div className=\"flex flex-col text-left font-sans\">\n        <span className=\"font-mono text-slate-800\">{targetKM || 0}</span>\n        <span className=\"text-slate-400 font-mono italic text-[10px]\">&mdash;</span>\n      </div>\n    );\n  }\n  const diff = targetKM - currentKM;\n  if (diff < 0) {\n    return (\n      <div className=\"flex flex-col text-left font-sans\">\n        <span className=\"font-mono text-slate-800 font-semibold\">{targetKM.toLocaleString()}</span>\n        <span className=\"text-[10px] text-red-650 font-bold bg-red-55/10 border border-red-100 px-1 py-0.5 rounded w-max mt-0.5 text-red-600\">Overdue ({Math.abs(diff).toLocaleString()} KM)</span>\n      </div>\n    );\n  }\n  if (diff <= 2000) {\n    return (\n      <div className=\"flex flex-col text-left font-sans\">\n        <span className=\"font-mono text-slate-800 font-semibold\">{targetKM.toLocaleString()}</span>\n        <span className=\"text-[10px] text-amber-700 font-bold bg-amber-50 border border-amber-200 px-1 py-0.5 rounded w-max mt-0.5\">{diff.toLocaleString()} KM left</span>\n      </div>\n    );\n  }\n  return (\n    <div className=\"flex flex-col text-left font-sans\">\n      <span className=\"font-mono text-slate-800 font-semibold\">{targetKM.toLocaleString()}</span>\n      <span className=\"text-[10px] text-emerald-700 font-bold bg-emerald-50 border border-emerald-200 px-1 py-0.5 rounded w-max mt-0.5\">{diff.toLocaleString()} KM left</span>\n    </div>\n  );\n};\n\nexport default function TruckMaster({ trucks, onAddTruck, onUpdateTruck, onDeleteTruck }: TruckMasterProps) {\n  const [isEditing, setIsEditing] = useState<string | null>(null);\n  const [showAddForm, setShowAddForm] = useState(false);\n  \n  // Advanced Vehicle form states\n  const [truckNo, setTruckNo] = useState(\'\');\n  const [ownerName, setOwnerName] = useState(\'\');\n  const [make, setMake] = useState(\'\');\n  const [model, setModel] = useState(\'\');\n  const [type, setType] = useState(\'\');\n  const [insuranceExpiryDate, setInsuranceExpiryDate] = useState(\'\');\n  const [fcExpiryDate, setFcExpiryDate] = useState(\'\');\n  const [pinpushKM, setPinpushKM] = useState<number | \'\'>(\'\');\n  const [wheelGreaseKM, setWheelGreaseKM] = useState<number | \'\'>(\'\');\n  const [alignmentNextDate, setAlignmentNextDate] = useState(\'\');\n  const [qTaxExpiryDate, setQTaxExpiryDate] = useState(\'\');\n  const [greenTaxExpiryDate, setGreenTaxExpiryDate] = useState(\'\');\n  const [npTaxExpiryDate, setNpTaxExpiryDate] = useState(\'\');\n  const [fiveYPermitExpiryDate, setFiveYPermitExpiryDate] = useState(\'\');\n  const [currentKM, setCurrentKM] = useState<number | \'\'>(\'\');\n  const [engineOilKM, setEngineOilKM] = useState<number | \'\'>(\'\');\n  const [crownOilKM, setCrownOilKM] = useState<number | \'\'>(\'\');\n  const [gearBoxOilKM, setGearBoxOilKM] = useState<number | \'\'>(\'\');\n  const [radiatorKM, setRadiatorKM] = useState<number | \'\'>(\'\');\n  const [status, setStatus] = useState<\'Active\' | \'Inactive\'>(\'Active\');\n\n  const resetForm = () => {\n    setTruckNo(\'\');\n    setOwnerName(\'\');\n    setMake(\'\');\n    setModel(\'\');\n    setType(\'\');\n    setInsuranceExpiryDate(\'\');\n    setFcExpiryDate(\'\');\n    setPinpushKM(\'\');\n    setWheelGreaseKM(\'\');\n    setAlignmentNextDate(\'\');\n    setQTaxExpiryDate(\'\');\n    setGreenTaxExpiryDate(\'\');\n    setNpTaxExpiryDate(\'\');\n    setFiveYPermitExpiryDate(\'\');\n    setCurrentKM(\'\');\n    setEngineOilKM(\'\');\n    setCrownOilKM(\'\');\n    setGearBoxOilKM(\'\');\n    setRadiatorKM(\'\');\n    setStatus(\'Active\');\n    setIsEditing(null);\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!truckNo.trim()) return;\n\n    const payload = {\n      truckNo: truckNo.toUpperCase().trim(),\n      ownerName: ownerName.trim() || undefined,\n      make: make.trim() || undefined,\n      model: model.trim() || undefined,\n      type: type.trim() || undefined,\n      insuranceExpiryDate: insuranceExpiryDate || undefined,\n      fcExpiryDate: fcExpiryDate || undefined,\n      pinpushKM: pinpushKM !== \'\' ? Number(pinpushKM) : undefined,\n      wheelGreaseKM: wheelGreaseKM !== \'\' ? Number(wheelGreaseKM) : undefined,\n      alignmentNextDate: alignmentNextDate || undefined,\n      qTaxExpiryDate: qTaxExpiryDate || undefined,\n      greenTaxExpiryDate: greenTaxExpiryDate || undefined,\n      npTaxExpiryDate: npTaxExpiryDate || undefined,\n      fiveYPermitExpiryDate: fiveYPermitExpiryDate || undefined,\n      currentKM: currentKM !== \'\' ? Number(currentKM) : undefined,\n      engineOilKM: engineOilKM !== \'\' ? Number(engineOilKM) : undefined,\n      crownOilKM: crownOilKM !== \'\' ? Number(crownOilKM) : undefined,\n      gearBoxOilKM: gearBoxOilKM !== \'\' ? Number(gearBoxOilKM) : undefined,\n      radiatorKM: radiatorKM !== \'\' ? Number(radiatorKM) : undefined,\n      status\n    };\n\n    if (isEditing) {\n      onUpdateTruck({\n        id: isEditing,\n        ...payload\n      });\n    } else {\n      onAddTruck(payload);\n    }\n    resetForm();\n    setShowAddForm(false);\n  };\n\n  const startEdit = (truck: Truck) => {\n    setIsEditing(truck.id);\n    setTruckNo(truck.truckNo);\n    setOwnerName(truck.ownerName || \'\');\n    setMake(truck.make || \'\');\n    setModel(truck.model || \'\');\n    setType(truck.type || \'\');\n    setInsuranceExpiryDate(truck.insuranceExpiryDate || \'\');\n    setFcExpiryDate(truck.fcExpiryDate || \'\');\n    setPinpushKM(truck.pinpushKM !== undefined ? truck.pinpushKM : \'\');\n    setWheelGreaseKM(truck.wheelGreaseKM !== undefined ? truck.wheelGreaseKM : \'\');\n    setAlignmentNextDate(truck.alignmentNextDate || \'\');\n    setQTaxExpiryDate(truck.qTaxExpiryDate || \'\');\n    setGreenTaxExpiryDate(truck.greenTaxExpiryDate || \'\');\n    setNpTaxExpiryDate(truck.npTaxExpiryDate || \'\');\n    setFiveYPermitExpiryDate(truck.fiveYPermitExpiryDate || \'\');\n    setCurrentKM(truck.currentKM !== undefined ? truck.currentKM : \'\');\n    setEngineOilKM(truck.engineOilKM !== undefined ? truck.engineOilKM : \'\');\n    setCrownOilKM(truck.crownOilKM !== undefined ? truck.crownOilKM : \'\');\n    setGearBoxOilKM(truck.gearBoxOilKM !== undefined ? truck.gearBoxOilKM : \'\');\n    setRadiatorKM(truck.radiatorKM !== undefined ? truck.radiatorKM : \'\');\n    setStatus(truck.status);\n    setShowAddForm(true);\n  };\n\n  return (\n    <div id=\"truck-master-panel\" className=\"bg-white border border-slate-200 rounded-xl p-5 md:p-6 shadow-xs animate-fade-in space-y-6\">\n      \n      {/* HEADER SECTION */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 border-b border-slate-100 pb-4\">\n        <div>\n          <h2 className=\"text-lg font-bold text-slate-800 tracking-tight flex items-center gap-2\">\n            <ClipboardList className=\"w-5 h-5 text-blue-650\" />\n            Fleet & Compliance Datasheet\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">Manage real-time compliance tracking, tax renewal intervals, and physical odometer maintenance thresholds.</p>\n        </div>\n        <button\n          id=\"btn-add-truck\"\n          onClick={() => {\n            resetForm();\n            setShowAddForm(!showAddForm);\n          }}\n          className=\"flex items-center gap-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg transition duration-150 shadow-sm text-xs cursor-pointer\"\n        >\n          {showAddForm ? \'Close Form\' : (\n            <>\n              <Plus className=\"w-3.5 h-3.5\" /> Add New Truck\n            </>\n          )}\n        </button>\n      </div>\n\n      {/* DETAILED FORM INPUT */}\n      {showAddForm && (\n        <form id=\"truck-form\" onSubmit={handleSubmit} className=\"p-4 md:p-6 bg-slate-50 rounded-xl border border-slate-250/70 animate-fade-in space-y-5\">\n          <h3 className=\"text-xs font-bold text-blue-650 uppercase tracking-wider block border-b border-slate-200 pb-2 flex items-center gap-1.5\">\n            <Settings className=\"w-4 h-4 text-slate-400\" />\n            {isEditing ? \'Modify Fleet Item Specifications\' : \'Register New Fleet Asset\'}\n          </h3>\n          \n          <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n            \n            {/* GENERAL CAR SPEC */}\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-650 uppercase mb-1\">Truck / Vehicle No <span className=\"text-red-500\">*</span></label>\n              <input\n                id=\"input-truck-no\"\n                type=\"text\"\n                placeholder=\"e.g. TN-52-AF-8095\"\n                value={truckNo}\n                onChange={(e) => setTruckNo(e.target.value)}\n                required\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500 uppercase font-mono font-bold\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-650 uppercase mb-1\">Make</label>\n              <input\n                type=\"text\"\n                placeholder=\"e.g. Ashok Leyland / TATA\"\n                value={make}\n                onChange={(e) => setMake(e.target.value)}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-650 uppercase mb-1\">Model</label>\n              <input\n                type=\"text\"\n                placeholder=\"e.g. 3518 / 2820\"\n                value={model}\n                onChange={(e) => setModel(e.target.value)}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-650 uppercase mb-1\">Type</label>\n              <input\n                type=\"text\"\n                placeholder=\"e.g. Multi-Axle Open Car\"\n                value={type}\n                onChange={(e) => setType(e.target.value)}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-650 uppercase mb-1\">Owner Name</label>\n              <input\n                type=\"text\"\n                placeholder=\"e.g. Royal Transports\"\n                value={ownerName}\n                onChange={(e) => setOwnerName(e.target.value)}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-655 uppercase mb-1\">Fleet Operational Status</label>\n              <select\n                value={status}\n                onChange={(e) => setStatus(e.target.value as \'Active\' | \'Inactive\')}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500 font-semibold\"\n              >\n                <option value=\"Active\">Active / Dispatch Ready</option>\n                <option value=\"Inactive\">Inactive / Maintenance Yard</option>\n              </select>\n            </div>\n          </div>\n\n          {/* COMPLIANCE LIMITS EXPIRATIONS */}\n          <div className=\"bg-white p-4 rounded-lg border border-slate-200/80 space-y-4\">\n            <span className=\"text-[10px] font-extrabold text-blue-700 uppercase tracking-widest block\">Compliance Certificates & TAX Renewal Schedules</span>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-4 gap-4\">\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-500 mb-1\">Insurance Expiry Date</label>\n                <input\n                  type=\"date\"\n                  value={insuranceExpiryDate}\n                  onChange={(e) => setInsuranceExpiryDate(e.target.value)}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-mono\"\n                />\n              </div>\n              \n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-500 mb-1\">FC (Fitness Cert) Expiry</label>\n                <input\n                  type=\"date\"\n                  value={fcExpiryDate}\n                  onChange={(e) => setFcExpiryDate(e.target.value)}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-mono\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-500 mb-1\">Alignment Due Date</label>\n                <input\n                  type=\"date\"\n                  value={alignmentNextDate}\n                  onChange={(e) => setAlignmentNextDate(e.target.value)}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-mono\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-500 mb-1\">Quarterly Tax Expiry (Q Tax)</label>\n                <input\n                  type=\"date\"\n                  value={qTaxExpiryDate}\n                  onChange={(e) => setQTaxExpiryDate(e.target.value)}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-mono\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-500 mb-1\">Green Tax Expiry</label>\n                <input\n                  type=\"date\"\n                  value={greenTaxExpiryDate}\n                  onChange={(e) => setGreenTaxExpiryDate(e.target.value)}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-mono\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-500 mb-1\">National Tax (NP Tax) Expiry</label>\n                <input\n                  type=\"date\"\n                  value={npTaxExpiryDate}\n                  onChange={(e) => setNpTaxExpiryDate(e.target.value)}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-mono\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-500 mb-1\">5Y National Permit Expiry</label>\n                <input\n                  type=\"date\"\n                  value={fiveYPermitExpiryDate}\n                  onChange={(e) => setFiveYPermitExpiryDate(e.target.value)}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-mono\"\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* ODOMETER MAINTENANCE THRESHOLDS */}\n          <div className=\"bg-white p-4 rounded-lg border border-slate-200/80 space-y-4\">\n            <span className=\"text-[10px] font-extrabold text-blue-700 uppercase tracking-widest block\">Operational Odometer Milestones (KM Tracks)</span>\n            <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4\">\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-500 mb-1\">Current Odo (KM) <span className=\"text-red-500\">*</span></label>\n                <input\n                  type=\"number\"\n                  min=\"0\"\n                  value={currentKM}\n                  onChange={(e) => setCurrentKM(e.target.value === \'\' ? \'\' : Number(e.target.value))}\n                  placeholder=\"Master Odo meter\"\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-mono text-right font-bold text-slate-800\"\n                />\n              </div>\n              \n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-500 mb-1\">Pin Push Odo (KM)</label>\n                <input\n                  type=\"number\"\n                  min=\"0\"\n                  value={pinpushKM}\n                  onChange={(e) => setPinpushKM(e.target.value === \'\' ? \'\' : Number(e.target.value))}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-mono text-right\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-500 mb-1\">Wheel Grease Odo (KM)</label>\n                <input\n                  type=\"number\"\n                  min=\"0\"\n                  value={wheelGreaseKM}\n                  onChange={(e) => setWheelGreaseKM(e.target.value === \'\' ? \'\' : Number(e.target.value))}\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-mono text-right\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-500 mb-1\">Engine Oil Change Due</label>\n                <input\n                  type=\"number\"\n                  min=\"0\"\n                  value={engineOilKM}\n                  onChange={(e) => setEngineOilKM(e.target.value === \'\' ? \'\' : Number(e.target.value))}\n                  placeholder=\"Target KM limit\"\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-mono text-right\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-500 mb-1\">Crown Oil Change Due</label>\n                <input\n                  type=\"number\"\n                  min=\"0\"\n                  value={crownOilKM}\n                  onChange={(e) => setCrownOilKM(e.target.value === \'\' ? \'\' : Number(e.target.value))}\n                  placeholder=\"Target KM limit\"\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-mono text-right\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-500 mb-1\">Gearbox Oil Change Due</label>\n                <input\n                  type=\"number\"\n                  min=\"0\"\n                  value={gearBoxOilKM}\n                  onChange={(e) => setGearBoxOilKM(e.target.value === \'\' ? \'\' : Number(e.target.value))}\n                  placeholder=\"Target KM limit\"\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-mono text-right\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block text-[10px] font-bold text-slate-500 mb-1\">Radiator Servicing Due</label>\n                <input\n                  type=\"number\"\n                  min=\"0\"\n                  value={radiatorKM}\n                  onChange={(e) => setRadiatorKM(e.target.value === \'\' ? \'\' : Number(e.target.value))}\n                  placeholder=\"Target KM limit\"\n                  className=\"w-full bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-mono text-right\"\n                />\n              </div>\n            </div>\n          </div>\n\n          <div className=\"flex justify-end gap-3 pt-3 border-t border-slate-200\">\n            <button\n              type=\"button\"\n              onClick={resetForm}\n              className=\"px-4 py-2 text-xs font-bold text-slate-500 hover:text-slate-800 cursor-pointer\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs px-5 py-2 rounded-lg transition shadow-2xs cursor-pointer text-white\"\n            >\n              {isEditing ? \'Save Asset Modifications\' : \'Register Asset\'}\n            </button>\n          </div>\n        </form>\n      )}\n\n      {/* HORIZONTAL EXPANSIVE COMPLIANCE MATRIX TABLE */}\n      <div className=\"overflow-x-auto border border-slate-200 rounded-xl shadow-3xs\">\n        <table id=\"trucks-table\" className=\"w-full text-left text-xs text-slate-705 divide-y divide-slate-200\">\n          <thead className=\"text-[10px] text-slate-505 uppercase bg-slate-50 font-extrabold tracking-wider border-b border-slate-200\">\n            <tr className=\"divide-x divide-slate-150\">\n              <th className=\"px-3.5 py-3 pl-4 whitespace-nowrap bg-slate-100 font-black\">Vehicle No</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">Make / Model</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">Type</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">Insurance</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">FC Status</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">Pinpush KM</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">Wheel Greese KM</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">Alignment Due</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">Q Tax</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">Green Tax</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">NP Tax</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">5Y Permit</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap font-bold bg-slate-50\">Current KM</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">Engine Oil</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">Crown Oil</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">Gear Box Oil</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap\">Radiator KM</th>\n              <th className=\"px-3.5 py-3 whitespace-nowrap text-center\">Status</th>\n              <th className=\"px-3.5 py-3 text-right pr-4 shrink-0 whitespace-nowrap\">Actions</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100 font-medium\">\n            {trucks.length === 0 ? (\n              <tr>\n                <td colSpan={19} className=\"text-center py-12 text-slate-400 font-medium italic\">\n                  No operational trucks currently registered in database. Register fleet cargo containers above.\n                </td>\n              </tr>\n            ) : (\n              trucks.map((truck) => (\n                <tr key={truck.id} id={`row-truck-${truck.id}`} className=\"hover:bg-slate-50/75 transition divide-x divide-slate-100 text-xs text-slate-700\">\n                  \n                  {/* Truck No */}\n                  <td className=\"px-3.5 py-3.5 pl-4 font-mono font-bold text-slate-900 bg-slate-50/30 whitespace-nowrap\">\n                    <span className=\"flex items-center gap-1.5\">\n                      <Shield className=\"w-3.5 h-3.5 text-blue-600 shrink-0\" />\n                      {truck.truckNo}\n                    </span>\n                  </td>\n\n                  {/* Make Model */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap\">\n                    <div className=\"flex flex-col\">\n                      <span className=\"font-semibold text-slate-800\">{truck.make || <span className=\"text-slate-350 italic\">&mdash;</span>}</span>\n                      <span className=\"text-[10px] text-slate-400 font-medium mt-0.5\">{truck.model || <span className=\"text-slate-300 italic\">&mdash;</span>}</span>\n                    </div>\n                  </td>\n\n                  {/* Type */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap text-slate-500 font-medium\">\n                    {truck.type || <span className=\"text-slate-400 font-mono italic\">&mdash;</span>}\n                  </td>\n\n                  {/* Insurance Expiry */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap\">\n                    {getDaysLeftBadge(truck.insuranceExpiryDate)}\n                  </td>\n\n                  {/* FC Expiry */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap\">\n                    {getDaysLeftBadge(truck.fcExpiryDate)}\n                  </td>\n\n                  {/* Pinpush KM */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap font-mono\">\n                    {truck.pinpushKM !== undefined ? truck.pinpushKM.toLocaleString() : <span className=\"text-slate-400 italic\">&mdash;</span>}\n                  </td>\n\n                  {/* Wheel Grease KM */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap font-mono\">\n                    {truck.wheelGreaseKM !== undefined ? truck.wheelGreaseKM.toLocaleString() : <span className=\"text-slate-400 italic\">&mdash;</span>}\n                  </td>\n\n                  {/* Alignment NEXT DATE */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap\">\n                    {getDaysLeftBadge(truck.alignmentNextDate)}\n                  </td>\n\n                  {/* Q tax */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap\">\n                    {getDaysLeftBadge(truck.qTaxExpiryDate)}\n                  </td>\n\n                  {/* Green Tax */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap\">\n                    {getDaysLeftBadge(truck.greenTaxExpiryDate)}\n                  </td>\n\n                  {/* NP Tax */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap\">\n                    {getDaysLeftBadge(truck.npTaxExpiryDate)}\n                  </td>\n\n                  {/* 5Y Permit */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap\">\n                    {getDaysLeftBadge(truck.fiveYPermitExpiryDate)}\n                  </td>\n\n                  {/* Current KM */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap font-mono font-bold bg-slate-50/20 text-slate-900 border-l border-r border-slate-200\">\n                    {truck.currentKM !== undefined ? truck.currentKM.toLocaleString() + \' KM\' : <span className=\"text-slate-400 italic\">&mdash;</span>}\n                  </td>\n\n                  {/* Engine Oil */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap\">\n                    {getKMLeftBadge(truck.engineOilKM, truck.currentKM)}\n                  </td>\n\n                  {/* Crown Oil */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap\">\n                    {getKMLeftBadge(truck.crownOilKM, truck.currentKM)}\n                  </td>\n\n                  {/* Gearbox Oil */}\n                  <td className=\"px-3.5 py-3.5 whitespace-nowrap\">\n       