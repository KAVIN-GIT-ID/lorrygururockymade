        }
        lines {
          text: "  dieselExpense: number;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  addBlueExpense: number;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  fastagExpense: number;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  driverWages: number;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  otherExpense: number;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
