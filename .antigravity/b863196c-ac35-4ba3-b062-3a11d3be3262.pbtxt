tUnloadingExpense(parseFloat(e.target.value) || 0)}\n                      placeholder=\"0\"\n                      className=\"w-full bg-white border border-slate-250 text-slate-80 rounded-lg px-2.5 py-1.5 text-xs text-right font-mono text-slate-705\"\n                    />\n                  </div>\n\n                  {/* RTO EXPENSE FOR INTERSTATE */}\n                  <div>\n                    <label className=\"block text-[10px] text-slate-405 font-bold uppercase mb-1\">\342\202\271 RTO Permits Expense</label>\n                    <input\n                      type=\"number\"\n                      min=\"0\"\n                      value={stRtoExpense || \'\'}\n                      onChange={(e) => setStRtoExpense(parseFloat(e.target.value) || 0)}\n                      placeholder=\"0\"\n                      className=\"w-full bg-white border border-slate-250 text-slate-80 rounded-lg px-2.5 py-1.5 text-xs text-right font-mono text-slate-705\"\n                    />\n                  </div>\n                </div>\n\n                {/* THE DIESEL SECTION WITH LITERS, RATE, AND AUTO CALCULATED COST */}\n                <div className=\"bg-amber-100/35 border border-amber-200/50 rounded-xl p-3.5 space-y-3 font-sans\">\n                  <div className=\"flex justify-between items-center text-[10px] font-bold text-amber-800 uppercase tracking-widest leading-none\">\n                    <span className=\"flex items-center gap-1\">\n                      <Fuel className=\"w-3.5 h-3.5\" />\n                      Diesel Fuel Calculation Block\n                    </span>\n                    <span className=\"font-mono text-slate-400\">st.dieselAmount = liters * rate</span>\n                  </div>\n\n                  <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                    <div>\n                      <label className=\"block text-[9px] text-amber-800 font-extrabold uppercase mb-1\">Fuel Liters</label>\n                      <input\n  