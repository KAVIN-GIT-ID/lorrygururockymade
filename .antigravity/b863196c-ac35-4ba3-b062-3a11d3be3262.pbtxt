  file_change {
    absolute_path_uri: "file:///src/components/TripList.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { TripEntry, Truck, Office, Account, TripStatus, calculateBalance } from \'../types\';\nimport { Search, Edit2, Trash2, Calendar, Filter, FileSpreadsheet, Eye, ChevronRight, X, AlertCircle } from \'lucide-react\';\n\ninterface TripListProps {\n  trips: TripEntry[];\n  trucks: Truck[];\n  offices: Office[];\n  accounts: Account[];\n  onEditEntry: (entry: TripEntry) => void;\n  onDeleteEntry: (id: string) => void;\n}\n\nexport default function TripList({\n  trips,\n  trucks,\n  offices,\n  accounts,\n  onEditEntry,\n  onDeleteEntry\n}: TripListProps) {\n  // Filters state\n  const [search, setSearch] = useState(\'\');\n  const [selectedTruck, setSelectedTruck] = useState(\'\');\n  const [selectedOffice, setSelectedOffice] = useState(\'\');\n  const [selectedStatus, setSelectedStatus] = useState<string>(\'\');\n  const [startDate, setStartDate] = useState(\'\');\n  const [endDate, setEndDate] = useState(\'\');\n  \n  // Master Details modal state for viewing full list of 21 columns cleanly\n  const [viewingEntry, setViewingEntry] = useState<TripEntry | null>(null);\n\n  const getAccountName = (id: string) => {\n    return accounts.find(a => a.id === id)?.accountName || id || <span className=\"text-slate-600 font-sans\">&mdash;</span>;\n  };\n\n  // Helper formatting values\n  const dateFormatted = (dateStr: string) => {\n    if (!dateStr) return <span className=\"text-slate-600 font-mono\">&mdash;</span>;\n    try {\n      const d = new Date(dateStr);\n      if (isNaN(d.getTime())) return <span className=\"text-slate-600 font-mono\">&mdash;</span>;\n      return <span className=\"font-mono text-xs\">{d.toLocaleDateString(\'en-IN\', { day: \'2-digit\', month: \'short\', year: \'numeric\' })}</span>;\n    } catch {\n      return <span className=\"text-slate-600 font-mono\">&mdash;</span>;\n    }\n  };\n\n  const currencyFormatted = (num: number) => {\n    const val = Number(num) || 0;\n    if (val === 0) return <span className=\"text-slate-700 font-mono\">\342\202\2710</span>;\n    return <span className=\"font-mono text-slate-100\">\342\202\271{val.toLocaleString(\'en-IN\')}</span>;\n  };\n\n  // Filtering Logic\n  const filteredTrips = trips.filter(trip => {\n    const searchLower = search.toLowerCase();\n    \n    // Custom broad search in TripNo, Trucks, Offices or Notes\n    const matchesSearch = !search ? true : (\n      trip.tripNo.toLowerCase().includes(searchLower) ||\n      trip.truckNo.toLowerCase().includes(searchLower) ||\n      trip.officeName.toLowerCase().includes(searchLower) ||\n      (trip.notes && trip.notes.toLowerCase().includes(searchLower))\n    );\n\n    const matchesTruck = !selectedTruck ? true : trip.truckNo === selectedTruck;\n    const matchesOffice = !selectedOffice ? true : trip.officeName === selectedOffice;\n    const matchesStatus = !selectedStatus ? true : trip.status === selectedStatus;\n    \n    const tripDateVal = trip.loadingDate ? new Date(trip.loadingDate).getTime() : 0;\n    const matchesStartDate = !startDate ? true : tripDateVal >= new Date(startDate).getTime();\n    const matchesEndDate = !endDate ? true : tripDateVal <= new Date(endDate).getTime();\n\n    return matchesSearch && matchesTruck && matchesOffice && matchesStatus && matchesStartDate && matchesEndDate;\n  });\n\n  // Calculate Cumulative total summaries for current filtered set\n  const totals = filteredTrips.reduce((acc, curr) => {\n    const balAmt = calculateBalance(curr);\n    return {\n      rental: acc.rental + Number(curr.rental),\n      commission: acc.commission + Number(curr.commission),\n      loadingUnloading: acc.loadingUnloading + Number(curr.loadingUnloading),\n      officeMamul: acc.officeMamul + Number(curr.officeMamul),\n      advances: acc.advances + Number(curr.advance1) + Number(curr.advance2) + Number(curr.advance3),\n      balance: acc.balance + balAmt\n    };\n  }, { rental: 0, commission: 0, loadingUnloading: 0, officeMamul: 0, advances: 0, balance: 0 });\n\n  // CSV Export utility\n  const handleExportCSV = () => {\n    if (filteredTrips.length === 0) return;\n    \n    const headers = [\n      \'Truck No\', \'Trip No\', \'Office Name\', \'Rental\', \'Loading Date\', \'Commission\', \n      \'Loading Unloading\', \'Office Mamul\', \'Advance 1\', \'Advance 1 Date\', \'Advance 1 Received By\', \n      \'Advance 2\', \'Advance 2 Date\', \'Advance 2 Received By\', \'Advance 3\', \'Advance 3 Date\', \n      \'Advance 3 Received By\', \'Balance\', \'Balance 1 Date\', \'Balance 1 Received By\', \'Status\', \'Notes\'\n    ];\n\n    const rows = filteredTrips.map(t => [\n      t.truckNo,\n      t.tripNo,\n      t.officeName,\n      t.rental,\n      t.loadingDate,\n      t.commission,\n      t.loadingUnloading,\n      t.officeMamul,\n      t.advance1,\n      t.advance1Date,\n      getAccountName(t.advance1ReceivedBy),\n      t.advance2,\n      t.advance2Date,\n      getAccountName(t.advance2ReceivedBy),\n      t.advance3,\n      t.advance3Date,\n      getAccountName(t.advance3ReceivedBy),\n      calculateBalance(t),\n      t.balance1Date,\n      getAccountName(t.balance1ReceivedBy),\n      t.status,\n      t.notes || \'\'\n    ]);\n\n    const csvContent = [\n      headers.join(\',\'),\n      ...rows.map(r => r.map(val => {\n        const textVal = String(val).replace(/\"/g, \'\"\"\');\n        return textVal.includes(\',\') ? `\"${textVal}\"` : textVal;\n      }).join(\',\'))\n    ].join(\'\\n\');\n\n    const blob = new Blob([csvContent], { type: \'text/csv;charset=utf-8;\' });\n    const url = URL.createObjectURL(blob);\n    const link = document.createElement(\'a\');\n    link.href = url;\n    link.setAttribute(\'download\', `Trip_Ledger_Report_${new Date().toISOString().substring(0, 10)}.csv`);\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n  };\n\n  const getStatusBadge = (status: TripStatus) => {\n    switch (status) {\n      case \'Pending\':\n        return <span className=\"px-2.5 py-1 text-xs font-semibold rounded-full border border-slate-700 text-slate-300\">Pending</span>;\n      case \'In Progress\':\n        return <span className=\"px-2.5 py-1 text-xs font-semibold rounded-full border border-amber-600/30 text-amber-400\">In Progress</span>;\n      case \'Completed\':\n        return <span className=\"px-2.5 py-1 text-xs font-semibold rounded-full border border-blue-600/30 text-blue-400\">Completed</span>;\n      case \'Paid\':\n        return <span className=\"px-2.5 py-1 text-xs font-semibold rounded-full border border-emerald-600/30 text-emerald-400\">Paid/Settled</span>;\n      default:\n        return null;\n    }\n  };\n\n  const handleResetFilters = () => {\n    setSearch(\'\');\n    setSelectedTruck(\'\');\n    setSelectedOffice(\'\');\n    setSelectedStatus(\'\');\n    setStartDate(\'\');\n    setEndDate(\'\');\n  };\n\n  return (\n    <div className=\"space-y-4\">\n      {/* FILTER CONTROL HUB */}\n      <div id=\"filter-controls-card\" className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl space-y-4\">\n        <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4\">\n          <div>\n            <h2 className=\"text-lg font-bold text-white leading-tight\">Interactive Trip Journal</h2>\n            <p className=\"text-xs text-slate-400 mt-0.5\">Real-time ledger matching. Click individual ledger items to inspect full data values.</p>\n          </div>\n          \n          <button\n            id=\"btn-export-reports\"\n            disabled={filteredTrips.length === 0}\n            onClick={handleExportCSV}\n            className=\"flex items-center gap-1.5 bg-slate-800 hover:bg-slate-750 text-indigo-400 disabled:opacity-40 disabled:hover:bg-slate-800 font-semibold px-4 py-2 rounded-xl border border-slate-700 transition text-xs\"\n          >\n            <FileSpreadsheet className=\"w-3.5 h-3.5\" /> Export to CSV Report\n          </button>\n        </div>\n\n        {/* INPUT FILTERS ROW */}\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4 pt-3 border-t border-slate-800/80\">\n          {/* SEARCH FIELD */}\n          <div className=\"relative\">\n            <Search className=\"absolute left-2.5 top-3.5 w-3.5 h-3.5 text-slate-500\" />\n            <input\n              id=\"search-input\"\n              type=\"text\"\n              placeholder=\"Search Trips / Trucks...\"\n              value={search}\n              onChange={(e) => setSearch(e.target.value)}\n              className=\"w-full bg-slate-950 border border-slate-800 text-white rounded-lg pl-8 pr-2 py-2.5 text-xs focus:outline-none focus:border-indigo-500 placeholder:text-slate-600\"\n            />\n          </div>\n\n          {/* TRUCK MASTER FILTER */}\n          <div>\n            <select\n              id=\"filter-truck-select\"\n              value={selectedTruck}\n              onChange={(e) => setSelectedTruck(e.target.value)}\n              className=\"w-full bg-slate-950 border border-slate-800 text-slate-300 rounded-lg px-2.5 py-2.5 text-xs font-mono focus:outline-none\"\n            >\n              <option value=\"\">Choose Truck Master</option>\n              {trucks.map(t => (\n                <option key={t.id} value={t.truckNo}>{t.truckNo}</option>\n              ))}\n            </select>\n          </div>\n\n          {/* OFFICE MASTER FILTER */}\n          <div>\n            <select\n              id=\"filter-office-select\"\n              value={selectedOffice}\n              onChange={(e) => setSelectedOffice(e.target.value)}\n              className=\"w-full bg-slate-950 border border-slate-800 text-slate-300 rounded-lg px-2.5 py-2.5 text-xs focus:outline-none\"\n            >\n              <option value=\"\">Choose Loading Office</option>\n              {offices.map(o => (\n                <option key={o.id} value={o.officeName}>{o.officeName}</option>\n              ))}\n            </select>\n          </div>\n\n          {/* STATUS FILTER */}\n          <div>\n            <select\n              id=\"filter-status-select\"\n              value={selectedStatus}\n              onChange={(e) => setSelectedStatus(e.target.value)}\n              className=\"w-full bg-slate-950 border border-slate-800 text-slate-300 rounded-lg px-2.5 py-2.5 text-xs focus:outline-none\"\n            >\n              <option value=\"\">Choose Settlement Status</option>\n              <option value=\"Pending\">Pending</option>\n              <option value=\"In Progress\">In Progress</option>\n              <option value=\"Completed\">Completed</option>\n              <option value=\"Paid\">Paid (Settled)</option>\n            </select>\n          </div>\n\n          {/* DATES */}\n          <div>\n            <input\n              id=\"filter-start-date\"\n              type=\"date\"\n              title=\"Loading date after\"\n              value={startDate}\n              onChange={(e) => setStartDate(e.target.value)}\n              className=\"w-full bg-slate-950 border border-slate-800 text-slate-400 rounded-lg px-2.5 py-2.5 text-xs focus:outline-none\"\n            />\n          </div>\n\n          <div>\n            <input\n              id=\"filter-end-date\"\n              type=\"date\"\n              title=\"Loading date before\"\n              value={endDate}\n              onChange={(e) => setEndDate(e.target.value)}\n              className=\"w-full bg-slate-950 border border-slate-800 text-slate-400 rounded-lg px-2.5 py-2.5 text-xs\"\n            />\n          </div>\n        </div>\n\n        {/* ACTIVE FILTER SUMS */}\n        {(selectedTruck || selectedOffice || selectedStatus || startDate || endDate || search) && (\n          <div className=\"flex justify-between items-center bg-slate-950/60 rounded-xl p-3 px-5 border border-slate-850\">\n            <span className=\"text-xs text-slate-400 flex items-center gap-1\">\n              <Filter className=\"w-3 h-3 text-indigo-400\" />\n              Showing <strong>{filteredTrips.length}</strong> of <strong>{trips.length}</strong> trip ledger references matched.\n            </span>\n            <button\n              id=\"btn-reset-filters\"\n              onClick={handleResetFilters}\n              className=\"text-[11px] font-bold text-rose-400 hover:text-rose-300\"\n            >\n              Clear All Filters\n            </button>\n          </div>\n        )}\n      </div>\n\n      {/* CORE LOGS TABLE VIEWPORT */}\n      <div id=\"journal-listings-card\" className=\"bg-slate-900 border border-slate-800 rounded-2xl shadow-xl overflow-hidden\">\n        <div className=\"overflow-x-auto\">\n          <table id=\"journal-core-table\" className=\"w-full text-left text-sm text-slate-300 whitespace-nowrap min-w-[1200px]\">\n            <thead className=\"text-[11px] text-slate-400 uppercase bg-slate-950/80 border-b border-slate-800 font-semibold\">\n              <tr>\n                <th className=\"px-4 py-3.5\">Truck No</th>\n                <th className=\"px-4 py-3.5\">Trip No</th>\n                <th className=\"px-4 py-3.5\">Office Name</th>\n                <th className=\"px-4 py-3.5 text-right bg-slate-950/40\">Gross Contract</th>\n                <th className=\"px-4 py-3.5 text-center\">Loading Date</th>\n                <th className=\"px-4 py-3.5 text-right\">Commission</th>\n                <th className=\"px-4 py-3.5 text-right\">Loading/Unloading</th>\n                <th className=\"px-4 py-3.5 text-right\">Mamul</th>\n                <th className=\"px-4 py-3.5 text-right bg-slate-950/40\">Advances Recd</th>\n                <th className=\"px-4 py-3.5 text-right bg-indigo-950/20 text-indigo-300 font-bold\">Outstanding</th>\n                <th className=\"px-4 py-3.5 text-center\">Status</th>\n                <th className=\"px-4 py-3.5 text-right pr-6\">Quick Tools</th>\n              </tr>\n            </thead>\n            <tbody className=\"divide-y divide-slate-800/60 font-sans\">\n              {filteredTrips.length === 0 ? (\n                <tr>\n                  <td colSpan={12} className=\"text-center py-16 text-slate-500 font-medium\">\n                    No active trips matching the chosen filter values.\n                  </td>\n                </tr>\n              ) : (\n                filteredTrips.map((trip) => {\n                  const outAmt = calculateBalance(trip);\n                  const totalAdvs = (Number(trip.advance1) || 0) + (Number(trip.advance2) || 0) + (Number(trip.advance3) || 0);\n\n                  return (\n                    <tr key={trip.id} id={`row-trip-entry-${trip.id}`} className=\"hover:bg-slate-800/40 transition group\">\n                      {/* TRUCK NO */}\n                      <td className=\"px-4 py-3.5 font-mono font-semibold text-white tracking-widest text-[13px]\">\n                        {trip.truckNo}\n                      </td>\n                      {/* TRIP NO */}\n                      <td className=\"px-4 py-3.5 font-mono text-xs text-indigo-400 font-bold tracking-wide\">\n                        {trip.tripNo}\n                      </td>\n                      {/* OFFICE NAME */}\n                      <td className=\"px-4 py-3.5 text-slate-200 font-medium max-w-[160px] truncate\">\n                        {trip.officeName}\n                      </td>\n                      {/* RENTAL */}\n                      <td className=\"px-4 py-3.5 text-right font-mono font-bold bg-slate-950/20\">\n                        {currencyFormatted(trip.rental)}\n                      </td>\n                      {/* LOADING DATE */}\n                      <td className=\"px-4 py-3.5 text-center\">\n                        {dateFormatted(trip.loadingDate)}\n                      </td>\n                      {/* DEDUCTIONS */}\n                      <td className=\"px-4 py-3.5 text-right font-mono text-xs text-slate-400\">\n                        {currencyFormatted(trip.commission)}\n                      </td>\n                      <td className=\"px-4 py-3.5 text-right font-mono text-xs text-slate-400\">\n                        {currencyFormatted(trip.loadingUnloading)}\n                      </td>\n                      <td className=\"px-4 py-3.5 text-right font-mono text-xs text-slate-400 font-medium\">\n                        {currencyFormatted(trip.officeMamul)}\n                      </td>\n                      {/* ADVANCES */}\n                      <td className=\"px-4 py-3.5 text-right font-mono text-xs text-cyan-400 bg-slate-950/20\">\n                        {currencyFormatted(totalAdvs)}\n                      </td>\n                      {/* OUTSTANDING */}\n                      <td className={`px-4 py-3.5 text-right font-mono font-bold text-xs bg-indigo-950/10 ${outAmt > 0 ? \'text-amber-400\' : \'text-emerald-400\'}`}>\n                        {currencyFormatted(outAmt)}\n                      </td>\n                      {/* STATUS */}\n                      <td className=\"px-4 py-3.5 text-center\">\n                        {getStatusBadge(trip.status)}\n                      </td>\n                      {/* TOOLS */}\n                      <td className=\"px-4 py-3.5 text-right pr-6 font-medium\">\n                        <div className=\"flex justify-end gap-1.5 opacity-90 sm:opacity-0 group-hover:opacity-100 transition duration-150\">\n                          <button\n                            title=\"Inspect complete ledger values (21 columns)\"\n                            onClick={() => setViewingEntry(trip)}\n                            className=\"p-1 px-2.5 bg-slate-800 text-slate-300 hover:text-indigo-400 rounded-lg hover:bg-slate-750 transition\"\n                          >\n                            <Eye className=\"w-3.5 h-3.5\" />\n                          </button>\n                          <button\n                            title=\"Edit Trip segment\"\n                            onClick={() => onEditEntry(trip)}\n                            className=\"p-1 px-2.5 bg-slate-800 text-slate-300 hover:text-white rounded-lg hover:bg-slate-755 transition\"\n                          >\n                            <Edit2 className=\"w-3.5 h-3.5\" />\n                          </button>\n                          <button\n                            title=\"Delete Trip entry\"\n                            onClick={() => {\n                              if (confirm(`Confirm permanent deletion of Trip segment under Entry ID: ${trip.tripNo}?`)) {\n                                onDeleteEntry(trip.id);\n                              }\n                            }}\n                            className=\"p-1 px-2.5 bg-slate-800 text-rose-400 hover:text-rose-300 rounded-lg hover:bg-rose-950/20 transition\"\n                          >\n                            <Trash2 className=\"w-3.5 h-3.5\" />\n                          </button>\n                        </div>\n                      </td>\n                    </tr>\n                  );\n                })\n              )}\n            </tbody>\n\n            {/* TAB TOTAL SUMMARY FOOTER */}\n            {filteredTrips.length > 0 && (\n              <tfoot className=\"bg-slate-950 text-slate-300 font-bold text-[12px] border-t border-slate-800 uppercase tracking-wide font-mono\">\n                <tr>\n                  <td colSpan={3} className=\"px-4 py-4 text-left font-sans text-xs text-indigo-400 font-bold\">\n                    Filtered Cumulative Totals ({filteredTrips.length} Entries)\n                  </td>\n                  <td className=\"px-4 py-4 text-right text-indigo-300 font-extrabold text-[13px] bg-slate-950\">\n                    \342\202\271{totals.rental.toLocaleString(\'en-IN\')}\n                  </td>\n                  <td></td>\n                  <td className=\"px-4 py-4 text-right text-slate-400 font-medium\">\n                    \342\202\271{totals.commission.toLocaleString(\'en-IN\')}\n                  </td>\n                  <td className=\"px-4 py-4 text-right text-slate-400 font-medium\">\n                    \342\202\271{totals.loadingUnloading.toLocaleString(\'en-IN\')}\n                  </td>\n                  <td className=\"px-4 py-4 text-right text-slate-400 font-medium\">\n                    \342\202\271{totals.officeMamul.toLocaleString(\'en-IN\')}\n                  </td>\n                  <td className=\"px-4 py-4 text-right text-cyan-400\">\n                    \342\202\271{totals.advances.toLocaleString(\'en-IN\')}\n                  </td>\n                  <td className={`px-4 py-4 text-right font-black text-xs ${totals.balance > 0 ? \'text-amber-500\' : \'text-emerald-500\'} bg-slate-950/80`}>\n                    \342\202\271{totals.balance.toLocaleString(\'en-IN\')}\n                  </td>\n                  <td></td>\n                  <td></td>\n                </tr>\n              </tfoot>\n            )}\n          </table>\n        </div>\n      </div>\n\n      {/* SINGLE ENTRY FULL INSPECTION PANEL (All 21 columns details) */}\n      {viewingEntry && (\n        <div id=\"inspector-overlay\" className=\"fixed inset-0 bg-slate-950/90 backdrop-blur-xs z-50 flex items-center justify-center p-4\">\n          <div id=\"inspector-card\" className=\"bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-2xl shadow-2xl overflow-hidden scale-up\">\n            \n            <div className=\"px-6 py-4 bg-slate-950/80 border-b border-slate-800 flex justify-between items-center\">\n              <div>\n                <span className=\"text-[10px] text-indigo-400 uppercase tracking-wider font-bold\">Full Document Log Auditor</span>\n                <h3 className=\"text-lg font-bold text-white font-mono tracking-widest\">{viewingEntry.tripNo} &bull; {viewingEntry.truckNo}</h3>\n              </div>\n              <button\n                id=\"btn-close-inspector\"\n                onClick={() => setViewingEntry(null)}\n                className=\"p-1 px-2 text-slate-400 hover:text-white bg-slate-800 rounded-lg transition\"\n              >\n                <X className=\"w-4 h-4\" />\n              </button>\n            </div>\n\n            <div className=\"p-6 space-y-6 max-h-[80vh] overflow-y-auto\">\n              {/* PRIMARY SPEC SHEETS */}\n              <div className=\"grid grid-cols-2 gap-4\">\n                <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-850\">\n                  <span className=\"text-[10px] text-slate-500 uppercase block mb-1\">Office Name</span>\n                  <span className=\"text-sm font-semibold text-white\">{viewingEntry.officeName}</span>\n                </div>\n                <div className=\"bg-slate-950 p-3.5 rounded-xl border border-slate-850\">\n                  <span className=\"text-[10px] text-slate-500 uppercase block mb-1\">Loading Date</span>\n                  <span className=\"text-sm font-semibold text-white font-mono\">{viewingEntry.loadingDate}</span>\n                </div>\n              </div>\n\n              {/* REVENUE BREAKDOWNS */}\n              <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-850 space-y-2\">\n                <span className=\"text-[10px] text-indigo-400 font-bold uppercase tracking-wider block border-b border-slate-850 pb-1.5 mb-2\">Freight Volume Costs</span>\n                <div className=\"grid grid-cols-4 gap-3 text-center\">\n                  <div>\n                    <span className=\"text-[10px] text-slate-500 uppercase block\">Contract Rental</span>\n                    <span className=\"text-xs font-bold text-white font-mono block mt-1\">\342\202\271{Number(viewingEntry.rental).toLocaleString()}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-[10px] text-slate-500 uppercase block\">Commission</span>\n                    <span className=\"text-xs font-bold text-slate-300 font-mono block mt-1\">\342\202\271{Number(viewingEntry.commission).toLocaleString()}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-[10px] text-slate-500 uppercase block\">Load/Unload</span>\n                    <span className=\"text-xs font-bold text-slate-300 font-mono block mt-1\">\342\202\271{Number(viewingEntry.loadingUnloading).toLocaleString()}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-[10px] text-slate-500 uppercase block\">Office Mamul</span>\n                    <span className=\"text-xs font-bold text-slate-300 font-mono block mt-1\">\342\202\271{Number(viewingEntry.officeMamul).toLocaleString()}</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* ADVANCES LEDGER DETAILS */}\n              <div className=\"border border-slate-850 rounded-xl overflow-hidden\">\n                <div className=\"bg-slate-950/60 px-4 py-2 border-b border-slate-850\">\n                  <span className=\"text-[10px] text-indigo-400 uppercase tracking-widest font-bold\">Interim Advances</span>\n                </div>\n                <div className=\"divide-y divide-slate-850 bg-slate-950/20 text-xs\">\n                  \n                  {/* ADVANCE 1 */}\n                  <div className=\"p-3 grid grid-cols-3 items-center\">\n                    <span className=\"font-semibold text-slate-400\">Advance 1</span>\n                    <span className=\"font-mono font-bold text-white\">\342\202\271{Number(viewingEntry.advance1).toLocaleString()}</span>\n                    <div className=\"text-right\">\n                      <p className=\"font-mono text-[10px] text-slate-400\">{viewingEntry.advance1Date || \'--\'}</p>\n                      <p className=\"text-[10px] text-indigo-400 font-semibold\">{getAccountName(viewingEntry.advance1ReceivedBy)}</p>\n                    </div>\n                  </div>\n\n                  {/* ADVANCE 2 */}\n                  <div className=\"p-3 grid grid-cols-3 items-center\">\n                    <span className=\"font-semibold text-slate-400\">Advance 2</span>\n                    <span className=\"font-mono font-bold text-white\">\342\202\271{Number(viewingEntry.advance2).toLocaleString()}</span>\n                    <div className=\"text-right\">\n                      <p className=\"font-mono text-[10px] text-slate-400\">{viewingEntry.advance2Date || \'--\'}</p>\n                      <p className=\"text-[10px] text-indigo-400 font-semibold\">{getAccountName(viewingEntry.advance2ReceivedBy)}</p>\n                    </div>\n                  </div>\n\n                  {/* ADVANCE 3 */}\n                  <div className=\"p-3 grid grid-cols-3 items-center\">\n                    <span className=\"font-semibold text-slate-400\">Advance 3</span>\n                    <span className=\"font-mono font-bold text-white\">\342\202\271{Number(viewingEntry.advance3).toLocaleString()}</span>\n                    <div className=\"text-right\">\n                      <p className=\"font-mono text-[10px] text-slate-400\">{viewingEntry.advance3Date || \'--\'}</p>\n                      <p className=\"text-[10px] text-indigo-400 font-semibold\">{getAccountName(viewingEntry.advance3ReceivedBy)}</p>\n                    </div>\n                  </div>\n\n                </div>\n              </div>\n\n              {/* SETTLEMENT DETAILS */}\n              <div className=\"bg-slate-950 p-4 rounded-xl border border-slate-850 flex justify-between items-center\">\n                <div>\n                  <span className=\"text-[10px] text-slate-500 uppercase block\">Outstandings Status</span>\n                  <div className=\"flex items-center gap-1.5 mt-1\">\n                    {getStatusBadge(viewingEntry.status)}\n                    {viewingEntry.balance1Date && (\n                      <span className=\"text-[11px] text-slate-400 font-mono\">on {viewingEntry.balance1Date}</span>\n                    )}\n                  </div>\n                </div>\n                <div className=\"text-right\">\n                  <span className=\"text-[10px] text-slate-500 uppercase block\">Outstanding Balance</span>\n                  <span className={`text-lg font-mono font-bold block mt-1 ${calculateBalance(viewingEntry) > 0 ? \'text-amber-400\' : \'text-emerald-400\'}`}>\n                    \342\202\271{calculateBalance(viewingEntry).toLocaleString()}\n                  </span>\n                  {viewingEntry.balance1ReceivedBy && (\n                    <span className=\"text-[10.5px] text-slate-400 font-semibold uppercase block mt-1\">\n                      via {getAccountName(viewingEntry.balance1ReceivedBy)}\n                    </span>\n                  )}\n                </div>\n              </div>\n\n              {/* COMMENTS AND METADATA */}\n              {viewingEntry.notes && (\n                <div className=\"bg-amber-950/10 border border-amber-500/10 rounded-xl p-3 text-xs text-slate-300\">\n                  <span className=\"text-[10px] font-bold text-amber-400 uppercase tracking-widest block mb-1\">Route & Settlement Remarks</span>\n                  <p className=\"leading-relaxed leading-sans\">{viewingEntry.notes}</p>\n                </div>\n              )}\n            </div>\n\n            <div className=\"px-6 py-4 bg-slate-950/80 border-t border-slate-800 text-right\">\n              <button\n                id=\"inspector-close-bottom\"\n                onClick={() => setViewingEntry(null)}\n                className=\"bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs px-5 py-2.5 rounded-lg transition\"\n              >\n                Finished Auditing\n              </button>\n            </div>\n\n          </div>\n        </div>\n      )}\n    </div>\n  );\n}\n"
