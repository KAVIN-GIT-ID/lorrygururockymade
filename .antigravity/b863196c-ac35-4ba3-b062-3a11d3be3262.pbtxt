          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            onClick={() => onEditEntry(trip)}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            className=\"p-1 px-2.5 bg-slate-100 text-slate-600 hover:text-slate-900 rounded hover:bg-slate-200 transition cursor-pointer\""
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          >"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
