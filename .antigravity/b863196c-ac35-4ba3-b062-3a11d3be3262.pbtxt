          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"p-2.5 text-blue-650 font-extrabold\">{acc?.accountName || p.receivedBy}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"p-2.5 text-right font-mono font-bold\">\342\202\271{p.amount.toLocaleString()}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"p-2.5 pl-6 text-slate-400 font-mono text-[10px] uppercase font-bold\">{segmentLabel}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"p-2.5 pl-6 font-semibold\" title={p.notes}>{p.notes || <span className=\"text-slate-300\">&mdash;</span>}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"p-2.5 text-right pr-4\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            <button"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
