      original_chunk {
        target_content: "      </div>\n\n      {/* PIE CHART STATS */}\n      <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6\">\n        <div className=\"bg-white border border-slate-200 p-4 rounded-xl text-center shadow-2xs font-sans\">\n          <span className=\"text-[10px] text-slate-400 uppercase font-bold\">Pending Advances</span>\n          <p className=\"text-lg font-bold text-slate-800 mt-1 font-mono\">{pendingCount}</p>\n        </div>\n        <div className=\"bg-white border border-slate-200 p-4 rounded-xl text-center shadow-2xs font-sans\">\n          <span className=\"text-[10px] text-slate-400 uppercase font-bold\">Active Transitions</span>\n          <p className=\"text-lg font-bold text-amber-600 mt-1 font-mono\">{inProgressCount}</p>\n        </div>\n        <div className=\"bg-white border border-slate-200 p-4 rounded-xl text-center shadow-2xs font-sans\">\n          <span className=\"text-[10px] text-slate-400 uppercase font-bold\">Delivered Goods</span>\n          <p className=\"text-lg font-bold text-blue-600 mt-1 font-mono\">{completedCount}</p>\n        </div>\n        <div className=\"bg-white border border-slate-200 p-4 rounded-xl text-center shadow-2xs font-sans\">\n          <span className=\"text-[10px] text-slate-400 uppercase font-bold\">Settled Trips</span>\n          <p className=\"text-lg font-bold text-emerald-600 mt-1 font-mono\">{paidCount}</p>\n        </div>\n      </div>\n\n    </div>\n  );\n}\n\n  return (\n    <div id=\"dashboard-tab\" className=\"space-y-6 animate-fade-in\">\n      \n      {/* STATS OVERVIEW CARDS */}\n      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6\">\n        {/* CONTRACT RENTAL */}\n        <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-xs flex items-center justify-between transition-all hover:shadow-xs duration-200\">\n          <div className=\"space-y-1\">\n            <span className=\"text-xs text-slate-500 font-bold block uppercase tracking-wider\">Gross Rental Volume</span>\n            <span className=\"text-2xl font-extrabold text-slate-900 font-sans tracking-tight leading-none\">\342\202\271{totalRental.toLocaleString()}</span>\n            <p className=\"text-[10px] text-slate-400 mt-1\">From {trips.length} registered trips</p>\n          </div>\n          <div className=\"p-3 bg-blue-50 rounded-lg border border-blue-100 text-blue-600 shadow-3xs\">\n            <TrendingUp className=\"w-5 h-5\" />\n          </div>\n        </div>\n\n        {/* OUTSTANDING BALANCES */}\n        <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-xs flex items-center justify-between transition-all hover:shadow-xs duration-200\">\n          <div className=\"space-y-1\">\n            <span className=\"text-xs text-slate-500 font-bold block uppercase tracking-wider\">Total Outstanding</span>\n            <span className={`text-2xl font-extrabold font-sans tracking-tight leading-none ${totalOutstanding > 0 ? \'text-red-650 font-bold\' : \'text-emerald-600\'}`}>\n              \342\202\271{totalOutstanding.toLocaleString()}\n            </span>\n            <p className=\"text-[10px] text-slate-400 mt-1\">Collectable from broker sheets</p>\n          </div>\n          <div className={`p-3 rounded-lg border shadow-3xs ${totalOutstanding > 0 ? \'bg-red-50 border-red-100 text-red-600\' : \'bg-emerald-50 border-emerald-100 text-emerald-600\'}`}>\n            <AlertCircle className=\"w-5 h-5\" />\n          </div>\n        </div>\n\n        {/* BRK COMMISSION */}\n        <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-xs flex items-center justify-between transition-all hover:shadow-xs duration-200\">\n          <div className=\"space-y-1\">\n            <span className=\"text-xs text-slate-500 font-bold block uppercase tracking-wider\">Brokerage Commission</span>\n            <span className=\"text-2xl font-extrabold text-slate-900 font-sans tracking-tight leading-none\">\342\202\271{totalCommission.toLocaleString()}</span>\n            <p className=\"text-[10px] text-slate-400 mt-1\">{(totalRental > 0 ? ((totalCommission / totalRental) * 100).toFixed(1) : 0)}% of Gross Rental</p>\n          </div>\n          <div className=\"p-3 bg-indigo-50 rounded-lg border border-indigo-100 text-indigo-600 shadow-3xs\">\n            <BadgeCent className=\"w-5 h-5\" />\n          </div>\n        </div>\n\n        {/* OPERATIONAL RECOVERY RATE */}\n        <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-xs flex items-center justify-between transition-all hover:shadow-xs duration-200\">\n          <div className=\"space-y-1\">\n            <span className=\"text-xs text-slate-500 font-bold block uppercase tracking-wider\">Collection Rate</span>\n            <span className=\"text-2xl font-extrabold text-emerald-600 font-sans tracking-tight leading-none\">{validRecoveryRate}%</span>\n            <p className=\"text-[10px] text-slate-400 mt-1\">Net collected vs net billed</p>\n          </div>\n          <div className=\"p-3 bg-emerald-50 rounded-lg border border-emerald-100 text-emerald-600 shadow-3xs\">\n            <CheckCircle2 className=\"w-5 h-5\" />\n          </div>\n        </div>\n      </div>\n\n      {/* MID SECTION CHARTS AND MASTER INSIGHTS */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        \n        {/* COLLECTION RATIO PIE GRAPH */}\n        <div className=\"bg-white border border-slate-200 rounded-xl p-6 shadow-xs flex flex-col justify-between\">\n          <div>\n            <h3 className=\"text-sm font-bold text-slate-800 uppercase tracking-wider mb-1\">Receipts & Expenses Pipeline</h3>\n            <p className=\"text-xs text-slate-500\">Visual mapping of overall contract capital conversion.</p>\n          </div>\n\n          <div className=\"my-6 flex items-center justify-center relative\">\n            <svg viewBox=\"0 0 100 100\" className=\"w-36 h-36 transform -rotate-90\">\n              <circle cx=\"50\" cy=\"50\" r=\"40\" fill=\"transparent\" stroke=\"#f1f5f9\" strokeWidth=\"10\" />\n              <circle \n                cx=\"50\" \n                cy=\"50\" \n                r=\"40\" \n                fill=\"transparent\" \n                stroke=\"#10b981\" \n                strokeWidth=\"10\" \n                strokeDasharray={`${2 * Math.PI * 40}`}\n                strokeDashoffset={`${2 * Math.PI * 40 * (1 - validRecoveryRate / 100)}`}\n                className=\"transition-all duration-1000 ease-out\"\n              />\n            </svg>\n            <div className=\"absolute inset-0 flex flex-col items-center justify-center\">\n              <span className=\"text-2xl font-extrabold text-slate-900 font-sans tracking-tight\">{validRecoveryRate}%</span>\n              <span className=\"text-[9px] text-slate-400 uppercase font-bold\">Cleared</span>\n            </div>\n          </div>\n\n          <div className=\"space-y-2 text-xs border-t border-slate-100 pt-4\">\n            <div className=\"flex justify-between text-slate-600 font-medium\">\n              <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded-full bg-emerald-500 shrink-0\"></span>Net Capital Collected</span>\n              <span className=\"font-mono text-slate-900 font-bold\">\342\202\271{(totalAdvances + (totalRental - totalExpenses - totalAdvances - totalOutstanding)).toLocaleString()}</span>\n            </div>\n            <div className=\"flex justify-between text-slate-600 font-medium\">\n              <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded-full bg-red-400 shrink-0\"></span>Pending Outstandings</span>\n              <span className=\"font-mono text-slate-900 font-bold\">\342\202\271{totalOutstanding.toLocaleString()}</span>\n            </div>\n            <div className=\"flex justify-between text-slate-600 font-medium\">\n              <span className=\"flex items-center gap-1.5\"><span className=\"w-2.5 h-2.5 rounded-full bg-indigo-400 shrink-0\"></span>Operating Expenses</span>\n              <span className=\"font-mono text-slate-900 font-bold\">\342\202\271{totalExpenses.toLocaleString()}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* LEDGER ACCOUNTS COLLECTION SPLIT */}\n        <div className=\"bg-white border border-slate-200 rounded-xl p-6 shadow-xs flex flex-col justify-between\">\n          <div>\n            <h3 className=\"text-sm font-bold text-slate-800 uppercase tracking-wider mb-1\">Receipts by Accounts</h3>\n            <p className=\"text-xs text-slate-500\">Total advances & settlements received into operational accounts.</p>\n          </div>\n\n          <div className=\"my-4 divide-y divide-slate-100 overflow-y-auto max-h-[180px] pr-1 flex-1\">\n            {fundsByAccount.length === 0 ? (\n              <p className=\"text-center py-12 text-xs text-slate-400 italic\">No account transitions logged yet.</p>\n            ) : (\n              fundsByAccount.map(({ accountName, amount }) => {\n                const pct = totalRental > 0 ? Math.round((amount / (totalRental - totalExpenses)) * 100) : 0;\n                return (\n                  <div key={accountName} className=\"py-2.5 flex items-center justify-between gap-4\">\n                    <span className=\"text-xs font-semibold text-slate-700 truncate max-w-[150px]\">{accountName}</span>\n                    <div className=\"flex-1 max-w-[80px]\">\n                      <div className=\"w-full bg-slate-100 h-1.5 rounded-full overflow-hidden\">\n                        <div className=\"bg-blue-600 h-full rounded-full\" style={{ width: `${Math.min(100, pct)}%` }}></div>\n                      </div>\n                    </div>\n                    <span className=\"text-xs font-mono font-bold text-slate-900 text-right\">\342\202\271{amount.toLocaleString()}</span>\n                  </div>\n                );\n              })\n            )}\n          </div>\n\n          <div className=\"text-[10px] text-slate-500 bg-slate-50 p-2.5 rounded-lg border border-slate-100 flex items-center gap-2 mt-4 shadow-3xs\">\n            <Landmark className=\"w-3.5 h-3.5 text-blue-500 flex-shrink-0\" />\n            <span>Map accounts to Advance 1, Advance 2, Advance 3 or Balance Received By parameters.</span>\n          </div>\n        </div>\n\n        {/* TOP OUTSTANDING LIABILITIES BY TRUCK */}\n        <div className=\"bg-white border border-slate-200 rounded-xl p-6 shadow-xs flex flex-col justify-between\">\n          <div>\n            <h3 className=\"text-sm font-bold text-slate-800 uppercase tracking-wider mb-1\">Balance Risk by Truck</h3>\n            <p className=\"text-xs text-slate-500 font-sans\">Active pending outstandings grouped per truck datasheet reference.</p>\n          </div>\n\n          <div className=\"my-4 divide-y divide-slate-100 overflow-y-auto max-h-[180px] pr-1 flex-1\">\n            {topOutstandingTrucks.length === 0 ? (\n              <p className=\"text-center py-12 text-xs text-emerald-600 italic font-medium\">Excellent! All truck balances are fully settled.</p>\n            ) : (\n              topOutstandingTrucks.map(({ truckNo, amount }) => (\n                <div key={truckNo} className=\"py-2.5 flex items-center justify-between gap-4\">\n                  <span className=\"text-xs font-bold text-slate-705 uppercase font-mono tracking-wider flex items-center gap-1.5\">\n                    <Navigation className=\"w-3 h-3 text-slate-400 rotate-45\" />\n                    {truckNo}\n                  </span>\n                  <span className=\"text-xs font-mono font-bold text-red-600 bg-red-50 border border-red-100 px-2 py-0.5 rounded shadow-3xs\">\n                    \342\202\271{amount.toLocaleString()}\n                  </span>\n                </div>\n              ))\n            )}\n          </div>\n\n          <div className=\"text-[10px] text-slate-500 bg-slate-50 p-2.5 rounded-lg border border-slate-100 flex items-center gap-2 mt-4 shadow-3xs\">\n            <ShieldAlert className=\"w-3.5 h-3.5 text-amber-500 flex-shrink-0\" />\n            <span>Alert drivers or billing office if a single truck exceeds safety credit limit threshold.</span>\n          </div>\n        </div>\n\n      </div>\n\n      {/* PIE CHART STATS */}\n      <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6\">\n        <div className=\"bg-white border border-slate-200 p-4 rounded-xl text-center shadow-2xs\">\n          <span className=\"text-[10px] text-slate-405 uppercase font-bold\">Pending Advances</span>\n          <p className=\"text-lg font-bold text-slate-800 mt-1 font-mono\">{pendingCount}</p>\n        </div>\n        <div className=\"bg-white border border-slate-200 p-4 rounded-xl text-center shadow-2xs\">\n          <span className=\"text-[10px] text-slate-405 uppercase font-bold\">Active Transitions</span>\n          <p className=\"text-lg font-bold text-amber-600 mt-1 font-mono\">{inProgressCount}</p>\n        </div>\n        <div className=\"bg-white border border-slate-200 p-4 rounded-xl text-center shadow-2xs\">\n          <span className=\"text-[10px] text-slate-405 uppercase font-bold\">Delivered Goods</span>\n          <p className=\"text-lg font-bold text-blue-600 mt-1 font-mono\">{completedCount}</p>\n        </div>\n        <div className=\"bg-white border border-slate-200 p-4 rounded-xl text-center shadow-2xs\">\n          <span className=\"text-[10px] text-slate-405 uppercase font-bold\">Settled Trips</span>\n          <p className=\"text-lg font-bold text-emerald-600 mt-1 font-mono\">{paidCount}</p>\n        </div>\n      </div>\n\n    </div>\n  );\n}"
