          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                            className=\"p-1 px-2.5 bg-slate-100 text-slate-600 hover:text-blue-600 rounded hover:bg-slate-200 transition cursor-pointer\""
