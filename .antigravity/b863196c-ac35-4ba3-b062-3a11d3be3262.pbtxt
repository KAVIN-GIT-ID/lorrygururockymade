  file_change {
    absolute_path_uri: "file:///src/components/AccountMaster.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  return (\n    <div id=\"account-master-panel\" className=\"bg-slate-900 border border-slate-800 rounded-2xl p-6 shadow-xl\">\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 mb-6\">\n        <div>\n          <h2 className=\"text-xl font-bold text-white tracking-tight\">Available Accounts</h2>\n          <p className=\"text-sm text-slate-400 mt-1 font-sans\">Register and manage banks, cash vaults, and digital wallets where advances are received.</p>\n        </div>\n        <button\n          id=\"btn-add-account\"\n          onClick={() => {\n            resetForm();\n            setShowAddForm(!showAddForm);\n          }}\n          className=\"flex items-center gap-2 bg-indigo-600 hover:bg-indigo-500 text-white font-medium px-4 py-2.5 rounded-xl transition duration-150 shadow-lg shadow-indigo-600/20 text-sm\"\n        >\n          {showAddForm ? \'Close Form\' : (\n            <>\n              <Plus className=\"w-4 h-4\" /> Add New Account\n            </>\n          )}\n        </button>\n      </div>\n\n      {showAddForm && (\n        <form id=\"account-form\" onSubmit={handleSubmit} className=\"mb-8 p-5 bg-slate-950 rounded-xl border border-slate-800/80 animate-fade-in\">\n          <h3 className=\"text-sm font-semibold text-indigo-400 uppercase tracking-wider mb-4\">\n            {isEditing ? \'Modify Account Details\' : \'Open New Account / Ledger\'}\n          </h3>\n          <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Account Display Name <span className=\"text-red-500\">*</span></label>\n              <input\n                id=\"input-account-name\"\n                type=\"text\"\n                placeholder=\"e.g. HDFC Bank Main\"\n                value={accountName}\n                onChange={(e) => setAccountName(e.target.value)}\n                required\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Asset Class / Type</label>\n              <select\n                id=\"select-account-type\"\n                value={type}\n                onChange={(e) => setType(e.target.value as \'Cash\' | \'Bank\' | \'Digital Wallets\' | \'Other\')}\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"Bank\">Bank Deposit</option>\n                <option value=\"Cash\">Cash Account / Drawer</option>\n                <option value=\"Digital Wallets\">UPI / Digital Wallets</option>\n                <option value=\"Other\">Other Ledger</option>\n              </select>\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Holder/Authorized Person</label>\n              <input\n                id=\"input-holder-name\"\n                type=\"text\"\n                placeholder=\"Manager Name\"\n                value={holderName}\n                onChange={(e) => setHolderName(e.target.value)}\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-xs font-medium text-slate-400 mb-1\">Collection Status</label>\n              <select\n                id=\"select-account-status\"\n                value={status}\n                onChange={(e) => setStatus(e.target.value as \'Active\' | \'Inactive\')}\n                className=\"w-full bg-slate-900 border border-slate-800 text-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-indigo-500\"\n              >\n                <option value=\"Active\">Active (Accepts Payments)</option>\n                <option value=\"Inactive\">Closed / Archived (Inactive)</option>\n              </select>\n            </div>\n          </div>\n          <div className=\"flex justify-end gap-3 mt-4 pt-3 border-t border-slate-800/50\">\n            <button\n              type=\"button\"\n              onClick={resetForm}\n              className=\"px-4 py-2 text-xs font-medium text-slate-400 hover:text-white\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"bg-indigo-600 hover:bg-indigo-500 text-white font-medium text-xs px-4 py-2 rounded-lg transition\"\n            >\n              {isEditing ? \'Update Account\' : \'Register Account\'}\n            </button>\n          </div>\n        </form>\n      )}\n\n      <div className=\"overflow-x-auto\">\n        <table id=\"accounts-table\" className=\"w-full text-left text-sm text-slate-300\">\n          <thead className=\"text-xs text-slate-400 uppercase bg-slate-950/60 border-y border-slate-800\">\n            <tr>\n              <th className=\"px-4 py-3\">Account Name</th>\n              <th className=\"px-4 py-3\">Financial Type</th>\n              <th className=\"px-4 py-3\">Custodian Name</th>\n              <th className=\"px-4 py-3 text-center\">Status</th>\n              <th className=\"px-4 py-3 text-right\">Actions</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-800\">\n            {accounts.length === 0 ? (\n              <tr>\n                <td colSpan={5} className=\"text-center py-8 text-slate-500 font-medium font-sans\">No accounting ledgers mapped. Please create one to process transactions.</td>\n              </tr>\n            ) : (\n              accounts.map((account) => (\n