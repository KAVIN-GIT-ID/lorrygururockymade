  file_change {
    absolute_path_uri: "file:///src/components/ExpenseMaster.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Truck, Account, ExpenseEntry } from \'../types\';\nimport { Plus, Edit2, Trash2, Calendar, ShoppingBag, ShieldAlert, CheckCircle, Clock, Search, Filter, Sparkles, DollarSign } from \'lucide-react\';\n\ninterface ExpenseMasterProps {\n  expenses: ExpenseEntry[];\n  trucks: Truck[];\n  accounts: Account[];\n  onAddExpense: (expense: Omit<ExpenseEntry, \'id\'>) => void;\n  onUpdateExpense: (expense: ExpenseEntry) => void;\n  onDeleteExpense: (id: string) => void;\n}\n\nconst EXPENSE_TYPES = [\n  \'Temporary\',\n  \'Diesel\',\n  \'FASTag\',\n  \'RTO Permit\',\n  \'AdBlue\',\n  \'Drivers Wage\',\n  \'Drivers Allowance\',\n  \'Engine Oil\',\n  \'Alignment Servicing\',\n  \'Wheel Grease\',\n  \'Tires / Spares\',\n  \'Repair / Shop Bills\',\n  \'Other Miscellaneous\'\n];\n\nexport default function ExpenseMaster({ expenses = [], trucks = [], accounts = [], onAddExpense, onUpdateExpense, onDeleteExpense }: ExpenseMasterProps) {\n  const [showAddForm, setShowAddForm] = useState(false);\n  const [isEditing, setIsEditing] = useState<string | null>(null);\n\n  // Form State\n  const [truckNo, setTruckNo] = useState(\'\');\n  const [expenseType, setExpenseType] = useState(\'Temporary\');\n  const [shopName, setShopName] = useState(\'\');\n  const [amount, setAmount] = useState<number | \'\'>(\'\');\n  const [paymentMode, setPaymentMode] = useState(\'Cash\');\n  const [date, setDate] = useState(() => new Date().toISOString().split(\'T\')[0]);\n  const [status, setStatus] = useState<\'Paid\' | \'Pending\'>(\'Paid\');\n  const [notes, setNotes] = useState(\'\');\n\n  // Filtering State\n  const [searchTruck, setSearchTruck] = useState(\'\');\n  const [filterType, setFilterType] = useState(\'All\');\n  const [filterStatus, setFilterStatus] = useState(\'All\');\n\n  const resetForm = () => {\n    setTruckNo(\'\');\n    setExpenseType(\'Temporary\');\n    setShopName(\'\');\n    setAmount(\'\');\n    setPaymentMode(\'Cash\');\n    setDate(new Date().toISOString().split(\'T\')[0]);\n    setStatus(\'Paid\');\n    setNotes(\'\');\n    setIsEditing(null);\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!truckNo || !amount) return;\n\n    const payload = {\n      truckNo,\n      expenseType,\n      shopName: shopName.trim() || \'N/A\',\n      amount: Number(amount) || 0,\n      paymentMode,\n      date,\n      status,\n      notes: notes.trim() || undefined\n    };\n\n    if (isEditing) {\n      onUpdateExpense({\n        id: isEditing,\n        ...payload\n      });\n    } else {\n      onAddExpense(payload);\n    }\n\n    resetForm();\n    setShowAddForm(false);\n  };\n\n  const startEdit = (exp: ExpenseEntry) => {\n    setIsEditing(exp.id);\n    setTruckNo(exp.truckNo);\n    setExpenseType(exp.expenseType);\n    setShopName(exp.shopName);\n    setAmount(exp.amount);\n    setPaymentMode(exp.paymentMode);\n    setDate(exp.date);\n    setStatus(exp.status);\n    setNotes(exp.notes || \'\');\n    setShowAddForm(true);\n  };\n\n  // Filter computation\n  const filteredExpenses = expenses.filter(exp => {\n    const matchTruck = exp.truckNo.toLowerCase().includes(searchTruck.toLowerCase());\n    const matchType = filterType === \'All\' || exp.expenseType === filterType;\n    const matchStatus = filterStatus === \'All\' || exp.status === filterStatus;\n    return matchTruck && matchType && matchStatus;\n  });\n\n  // Calculate stats\n  const totalAmount = filteredExpenses.reduce((sum, e) => sum + e.amount, 0);\n  const paidAmount = filteredExpenses.filter(e => e.status === \'Paid\').reduce((sum, e) => sum + e.amount, 0);\n  const pendingAmount = filteredExpenses.filter(e => e.status === \'Pending\').reduce((sum, e) => sum + e.amount, 0);\n\n  return (\n    <div id=\"expenses-master-panel\" className=\"space-y-6 animate-fade-in\">\n      \n      {/* STATS TILESROW */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-5\">\n        <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-3xs flex items-center justify-between\">\n          <div>\n            <span className=\"text-[10px] font-extrabold text-slate-500 uppercase tracking-widest block font-sans\">Total Tracked Expenses</span>\n            <span className=\"text-xl font-bold font-mono text-slate-800 antialiased block mt-1\">\342\202\271{totalAmount.toLocaleString(\'en-IN\')}</span>\n          </div>\n          <div className=\"bg-blue-50 text-blue-650 p-2.5 rounded-lg border border-blue-100\">\n            <DollarSign className=\"w-5 h-5 text-blue-600\" />\n          </div>\n        </div>\n\n        <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-3xs flex items-center justify-between\">\n          <div>\n            <span className=\"text-[10px] font-extrabold text-slate-500 uppercase tracking-widest block font-sans\">Settle Paid Expenses</span>\n            <span className=\"text-xl font-bold font-mono text-emerald-600 antialiased block mt-1\">\342\202\271{paidAmount.toLocaleString(\'en-IN\')}</span>\n          </div>\n          <div className=\"bg-emerald-50 text-emerald-650 p-2.5 rounded-lg border border-emerald-100\">\n            <CheckCircle className=\"w-5 h-5 text-emerald-600\" />\n          </div>\n        </div>\n\n        <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-3xs flex items-center justify-between\">\n          <div>\n            <span className=\"text-[10px] font-extrabold text-slate-500 uppercase tracking-widest block font-sans\">Outstanding Unpaid Claims</span>\n            <span className=\"text-xl font-bold font-mono text-red-600 antialiased block mt-1\">\342\202\271{pendingAmount.toLocaleString(\'en-IN\')}</span>\n          </div>\n          <div className=\"bg-rose-50 text-rose-650 p-2.5 rounded-lg border border-rose-100\">\n            <Clock className=\"w-5 h-5 text-rose-600\" />\n          </div>\n        </div>\n      </div>\n\n      {/* ACTION HEADER */}\n      <div className=\"flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 bg-white border border-slate-200 p-5 rounded-xl shadow-3xs\">\n        <div>\n          <h2 className=\"text-base font-bold text-slate-800 tracking-tight\">Voucher & Expenses Ledger</h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">Record generic operating overheads, driver provisions, terminal maintenance, workshop invoices.</p>\n        </div>\n        <button\n          onClick={() => {\n            resetForm();\n            setShowAddForm(!showAddForm);\n          }}\n          className=\"flex items-center gap-2 bg-blue-650 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg transition text-xs shadow-3xs cursor-pointer bg-blue-600\"\n        >\n          {showAddForm ? \'Close Entry Form\' : (\n            <>\n              <Plus className=\"w-4 h-4\" /> Log Expense Voucher\n            </>\n          )}\n        </button>\n      </div>\n\n      {/* NEW EXPENSE FORM */}\n      {showAddForm && (\n        <form onSubmit={handleSubmit} className=\"p-5 md:p-6 bg-slate-50 rounded-xl border border-slate-200 shadow-sm animate-fade-in space-y-4\">\n          <h3 className=\"text-xs font-bold text-blue-650 uppercase tracking-wider block border-b border-slate-200 pb-2\">\n            {isEditing ? \'Modify Expense Voucher Entry\' : \'Log New Expense Voucher\'}\n          </h3>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 pb-2\">\n            {/* Truck Selector */}\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-500 uppercase mb-1\">Truck Selection <span className=\"text-red-500\">*</span></label>\n              <select\n                required\n                value={truckNo}\n                onChange={(e) => setTruckNo(e.target.value)}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500 font-mono font-bold\"\n              >\n                <option value=\"\">-- Choose Truck --</option>\n                {trucks.map(t => (\n                  <option key={t.id} value={t.truckNo}>{t.truckNo} ({t.status})</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Expense Type */}\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-500 uppercase mb-1\">Expense Type</label>\n              <select\n                value={expenseType}\n                onChange={(e) => setExpenseType(e.target.value)}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500 font-medium\"\n              >\n                {EXPENSE_TYPES.map(type => (\n                  <option key={type} value={type}>{type}</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Shop Vendor */}\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-500 uppercase mb-1\">Shop / Vendor / Account Name</label>\n              <input\n                type=\"text\"\n                value={shopName}\n                onChange={(e) => setShopName(e.target.value)}\n                placeholder=\"e.g. SLV Fuels, Sri Ram Workshop\"\n                className=\"w-full bg-white border border-slate-200 text-slate-850 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500\"\n              />\n            </div>\n\n            {/* Expense Amount */}\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-500 uppercase mb-1\">Expense Amount (\342\202\271) <span className=\"text-red-500\">*</span></label>\n              <input\n                type=\"number\"\n                min=\"0\"\n                required\n                value={amount}\n                onChange={(e) => setAmount(e.target.value === \'\' ? \'\' : Number(e.target.value))}\n                placeholder=\"e.g. 15000\"\n                className=\"w-full bg-white border border-slate-200 text-slate-850 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500 font-mono font-bold text-slate-800\"\n              />\n            </div>\n\n            {/* Payment Mode */}\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-500 uppercase mb-1\">Payment Mode / Source Account</label>\n              <select\n                value={paymentMode}\n                onChange={(e) => setPaymentMode(e.target.value)}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500 font-semibold\"\n              >\n                <option value=\"Cash\">Hand Cash (Primary)</option>\n                <option value=\"Digital Wallets\">Digital Wallets (GPay/PhonePe)</option>\n                {accounts.map(acc => (\n                  <option key={acc.id} value={acc.accountName}>{acc.accountName} ({acc.type})</option>\n                ))}\n              </select>\n            </div>\n\n            {/* Date */}\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-500 uppercase mb-1\">Voucher Date</label>\n              <input\n                type=\"date\"\n                required\n                value={date}\n                onChange={(e) => setDate(e.target.value)}\n                className=\"w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-xs font-mono\"\n              />\n            </div>\n\n            {/* Claims status */}\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-500 uppercase mb-1\">Payment Status</label>\n              <select\n                value={status}\n                onChange={(e) => setStatus(e.target.value as \'Paid\' | \'Pending\')}\n                className=\"w-full bg-white border border-slate-200 text-slate-800 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500 font-bold\"\n              >\n                <option value=\"Paid\">Cleared (Paid)</option>\n                <option value=\"Pending\">Pending (Unpaid Dues)</option>\n              </select>\n            </div>\n\n            {/* Notes */}\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-500 uppercase mb-1\">Voucher Notes / Explanation</label>\n              <input\n                type=\"text\"\n                value={notes}\n                onChange={(e) => setNotes(e.target.value)}\n                placeholder=\"Remarks e.g. tyre placement bill\"\n                className=\"w-full bg-white border border-slate-200 text-slate-850 rounded-lg px-3 py-2 text-xs focus:outline-none focus:border-blue-500\"\n              />\n            </div>\n          </div>\n\n          <div className=\"flex justify-end gap-3 pt-3 border-t border-slate-200\">\n            <button\n              type=\"button\"\n              onClick={resetForm}\n              className=\"px-4 py-1.5 text-xs font-bold text-slate-500 hover:text-slate-850 cursor-pointer\"\n            >\n              Reset Form\n            </button>\n            <button\n              type=\"submit\"\n              className=\"bg-blue-600 hover:bg-blue-700 text-white font-semibold text-xs px-5 py-2 rounded-lg transition shadow-2xs cursor-pointer text-white\"\n            >\n              {isEditing ? \'Commit Changes\' : \'Register Voucher\'}\n            </button>\n          </div>\n        </form>\n      )}\n\n      {/* FILTER SEARCH CRITERIAS */}\n      <div className=\"bg-white border border-slate-200 p-4 rounded-xl shadow-3xs flex flex-col md:flex-row items-center gap-4 justify-between\">\n        <div className=\"flex items-center gap-2 text-xs font-bold text-slate-800 uppercase tracking-wide\">\n          <Filter className=\"w-4 h-4 text-slate-400\" />\n          Quick Filters Engine\n        </div>\n\n        <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 w-full md:w-3/4\">\n          <div className=\"relative\">\n            <Search className=\"absolute left-3 top-2.5 w-3.5 h-3.5 text-slate-400\" />\n            <input\n              type=\"text\"\n              placeholder=\"Search truck no...\"\n              value={searchTruck}\n              onChange={(e) => setSearchTruck(e.target.value)}\n              className=\"w-full bg-slate-50 border border-slate-200 text-slate-800 rounded-lg pl-9 pr-3 py-1.5 text-xs font-mono focus:outline-none\"\n            />\n          </div>\n\n          <select\n            value={filterType}\n            onChange={(e) => setFilterType(e.target.value)}\n            className=\"bg-slate-50 border border-slate-200 text-slate-700 rounded-lg px-3 py-1.5 text-xs focus:outline-none font-medium\"\n          >\n            <option value=\"All\">All Expense Types</option>\n            {EXPENSE_TYPES.map(t => (\n              <option key={t} value={t}>{t}</option>\n            ))}\n          </select>\n\n          <select\n            value={filterStatus}\n            onChange={(e) => setFilterStatus(e.target.value)}\n            className=\"bg-slate-50 border border-slate-200 text-slate-700 rounded-lg px-3 py-1.5 text-xs focus:outline-none font-bold\"\n          >\n            <option value=\"All\">All Statuses</option>\n            <option value=\"Paid\">Cleared (Paid)</option>\n            <option value=\"Pending\">Pending (Unpaid)</option>\n          </select>\n        </div>\n      </div>\n\n      {/* EXPENSES LISTING GRID */}\n      <div className=\"overflow-x-auto border border-slate-200 rounded-xl shadow-3xs bg-white\">\n        <table className=\"w-full text-left text-xs divide-y divide-slate-200\">\n          <thead className=\"bg-slate-50 uppercase text-[10px] text-slate-500 font-extrabold tracking-wider border-b border-slate-200\">\n            <tr>\n              <th className=\"px-4 py-3 pl-6\">Truck Number</th>\n              <th className=\"px-4 py-3\">Expense Type</th>\n              <th className=\"px-4 py-3\">Vendor / Shop</th>\n              <th className=\"px-4 py-3\">Voucher Date</th>\n              <th className=\"px-4 py-3\">Source Account</th>\n              <th className=\"px-4 py-3 font-semibold text-right\">Amount</th>\n              <th className=\"px-4 py-3 text-center\">Status</th>\n              <th className=\"px-4 py-3 text-right pr-6\">Action</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100 font-medium\">\n            {filteredExpenses.length === 0 ? (\n              <tr>\n                <td colSpan={8} className=\"text-center py-16 text-slate-400 italic\">No expense vouchers matching current search criterias.</td>\n              </tr>\n            ) : (\n              filteredExpenses.map((exp) => (\n                <tr key={exp.id} className=\"hover:bg-slate-50/75 transition text-xs text-slate-705\">\n                  \n                  {/* Truck No */}\n                  <td className=\"px-4 py-3.5 pl-6 font-mono font-bold text-slate-900 tracking-wider\">\n                    {exp.truckNo}\n                  </td>\n\n                  {/* Expense Type */}\n                  <td className=\"px-4 py-3.5\">\n                    <span className=\"bg-slate-100 border border-slate-200 text-slate-700 px-2 py-0.5 rounded font-semibold text-[10.5px]\">\n                      {exp.expenseType}\n                    </span>\n                  </td>\n\n                  {/* Shop Vendor */}\n                  <td className=\"px-4 py-3.5 text-slate-800 font-semibold flex items-center gap-1.5\">\n                    <ShoppingBag className=\"w-3.5 h-3.5 text-slate-400\" />\n                    <span>{exp.shopName || \'N/A\'}</span>\n                  </td>\n\n                  {/* Date */}\n                  <td className=\"px-4 py-3.5 font-mono text-slate-500 font-semibold\">\n                    <div className=\"flex items-center gap-1\">\n                      <Calendar className=\"w-3 h-3 text-slate-400\" />\n                      {exp.date}\n                    </div>\n                  </td>\n\n                  {/* Payment Mode */}\n                  <td className=\"px-4 py-3.5 text-slate-400 font-bold\">\n                    {exp.paymentMode || \'Cash\'}\n                  </td>\n\n                  {/* Amount */}\n                  <td className=\"px-4 py-3.5 font-mono text-right font-bold text-slate-900 text-sm\">\n                    \342\202\271{exp.amount.toLocaleString(\'en-IN\')}\n                  </td>\n\n                  {/* Status */}\n                  <td className=\"px-4 py-3.5 text-center\">\n                    <span className={`inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10.5px] font-bold ${\n                      exp.status === \'Paid\'\n                        ? \'bg-emerald-50 border border-emerald-250 text-emerald-700\'\n                        : \'bg-rose-50 border border-rose-250 text-rose-700\'\n                    }`}>\n                      {exp.status === \'Paid\' ? (\n                        <>\n                          <CheckCircle className=\"w-3 h-3 text-emerald-600\" />\n                          Cleared\n                        </>\n                      ) : (\n                        <>\n                          <Clock className=\"w-3 h-3 text-rose-600 animate-pulse\" />\n                          Unpaid\n                        </>\n                      )}\n                    </span>\n                  </td>\n\n                  {/* Edit delete */}\n                  <td className=\"px-4 py-3.5 text-right pr-6 font-medium\">\n                    <div className=\"flex justify-end gap-1.5\">\n                      <button\n                        title=\"Edit voucher\"\n                        onClick={() => startEdit(exp)}\n                        className=\"p-1 text-slate-550 hover:text-slate-900 bg-slate-100 hover:bg-slate-200 rounded transition cursor-pointer\"\n                      >\n                        <Edit2 className=\"w-3 h-3\" />\n                      </button>\n                      <button\n                        title=\"Delete voucher\"\n                        onClick={() => {\n                          if (confirm(`Are you sure you want to delete this expense of \342\202\271${exp.amount}?`)) {\n                            onDeleteExpense(exp.id);\n                          }\n                        }}\n                        className=\"p-1 text-rose-600 hover:text-rose-800 bg-rose-50 hover:bg-rose-100 rounded transition cursor-pointer\"\n                      >\n                        <Trash2 className=\"w-3 h-3\" />\n                      </button>\n                    </div>\n                  </td>\n\n                </tr>\n              ))\n            )}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  );\n}\n"
    }
