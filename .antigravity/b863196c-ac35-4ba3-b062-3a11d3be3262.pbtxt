        lines {
          text: "                  <tbody className=\"divide-y divide-slate-100 font-medium\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                    {subTrips.map((st, sidx) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const fuelExp = st.dieselAmount || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      // Sum other sub-trip specific costs"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      const otherCol = (st.loadingExpense + st.unloadingExpense + st.rtoExpense + st.addBlueExpense + st.fastagExpense + st.driverWages + st.otherExpense);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                      return ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                        <tr key={st.id} className=\"hover:bg-slate-50/70 transition\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"p-3 pl-4 font-bold text-slate-400\">#{sidx + 1}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"p-3 font-mono text-slate-650\">{st.loadingDate}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"p-3 text-blue-650 font-bold\">{st.officeName}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"p-3 text-slate-800 font-semibold\">{st.routeFrom} &rarr; {st.routeTo}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"p-3 text-right font-bold text-emerald-850 font-mono\">\342\202\271{st.income.toLocaleString()}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"p-3 text-right font-medium text-amber-700 font-mono\">\342\202\271{fuelExp.toLocaleString()}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "                          <td className=\"p-3 text-right font-medium text-red-600 font-mono\">\342\202\271{otherCol.toLocaleString()}</td>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
