t pr-6\">Actions</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-slate-100 font-sans\">\n            {trucks.length === 0 ? (\n              <tr>\n                <td colSpan={6} className=\"text-center py-12 text-slate-400 font-medium italic\">No trucks found. Add your first truck using the button above.</td>\n              </tr>\n            ) : (\n              trucks.map((truck) => (\n                <tr key={truck.id} id={`row-truck-${truck.id}`} className=\"hover:bg-slate-50/75 transition\">\n                  <td className=\"px-4 py-3.5 pl-6 font-mono font-bold text-slate-800 tracking-wider\">\n                    <span className=\"flex items-center gap-2 text-xs\">\n                      <Shield className=\"w-3.5 h-3.5 text-blue-600\" />\n                      {truck.truckNo}\n                    </span>\n                  </td>\n                  <td className=\"px-4 py-3.5 font-semibold text-slate-700\">\n                    {truck.ownerName || <span className=\"text-slate-400 italic font-mono\">&mdash;</span>}\n                  </td>\n                  <td className=\"px-4 py-3.5 text-slate-650 font-medium\">\n                    {truck.driverName ? (\n                      <span className=\"flex items-center gap-1.5\">\n                        <User className=\"w-3.5 h-3.5 text-slate-400\" />\n                        {truck.driverName}\n                      </span>\n                    ) : (\n                      <span className=\"text-slate-400 italic font-mono\">&mdash;</span>\n                    )}\n                  </td>\n                  <td className=\"px-4 py-3.5 font-mono text-xs text-slate-600 font-semibold\">\n                    {truck.phone ? (\n                      <span className=\"flex items-center gap-1.5\">\n                        <Phone className=\"w-3 h-3 text-slate-400\" />\n                        {truck.phone}\n                      </span>\n                    ) : (\n               