{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fleetpro",
  "compatibility_date": "2026-06-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "VISITOR_KV",
      "id": "visitor_kv_namespace_id"
    }
  ]
}
