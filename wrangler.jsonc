{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "truck-trip-tracker",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "truck_trip_tracker_db",
      "database_id": "e9a015ff-46ea-4ff7-8304-1fc5f8652049",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
